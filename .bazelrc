build --jobs=200
build --disk_cache=~/.cache/bazelcache
# Off-CI GC limits (coordinator laptop, cube worker workspaces). CI overrides
# this to 3T/60d via .ci.bazelrc and keeps its cache on a dedicated
# multi-TiB volume. 250G must match flunge exactly: both repos share
# ~/.cache/bazelcache, and bazel GC applies the invoking build's own
# max-size to that shared directory, so a smaller value here would evict
# flunge's entries (and vice versa).
build --experimental_disk_cache_gc_max_size=250G
build --experimental_disk_cache_gc_max_age=7d

# Always stamp builds with the git-derived version so that dev builds show a
# meaningful version string (e.g. "1.0.9-dev-a58a932") in the About panel
# instead of the unstamped placeholder "0.0.0".  Only the version plist and
# build_info_rs actions use ctx.info_file, so the cache impact is minimal —
# Swift/Rust compilation targets are unaffected.
build --workspace_status_command=tools/boss/installer/workspace-status.sh
build --stamp

# Release config: identical stamp flags; kept as a named config so release.sh
# and CI can use --config=release to opt into additional release-only settings.
build:release --workspace_status_command=tools/boss/installer/workspace-status.sh
build:release --stamp

# boss shake credentials: propagate the three env vars that embed the
# GitHub App into the binary at compile time. Values must be set in your
# shell (or via direnv) before running bazel build //tools/boss/cli:boss.
# See tools/boss/cli/README.md for the one-time developer setup instructions.
#
# --action_env is kept for belt-and-suspenders (non-rust actions, tooling).
# --define supplies the values to the rustc_env Make-variable expansion on
# the rust_binary target; rules_rust does not forward --action_env into the
# rustc compile action's env or cache key, but --define IS part of the key.
# Empty defaults here mean dev builds compile cleanly; the release pipeline
# overrides via --define=BOSS_SHAKE_APP_ID="$BOSS_SHAKE_APP_ID" etc.
build --action_env=BOSS_SHAKE_APP_ID
build --action_env=BOSS_SHAKE_INSTALLATION_ID
build --action_env=BOSS_SHAKE_PRIVATE_KEY_PEM
build --define=BOSS_SHAKE_APP_ID=
build --define=BOSS_SHAKE_INSTALLATION_ID=
build --define=BOSS_SHAKE_PRIVATE_KEY_PEM=

# Apply `test:macos`, `test:linux`, and the corresponding build sections below
# automatically from the host platform.
common --enable_platform_specific_config

# Test actions start with network access denied. Bazel's darwin-sandbox permits
# network access by default; Rust tests that truly need it must use
# `network_enabled_rust_test`, which applies both the Linux execution
# requirement and the macOS wrapper marker.
test --sandbox_default_allow_network=false

# Bazel's macOS sandbox profile always permits writes to shared host temp and
# cache directories. Run repository-owned test code under the stricter profile
# in hermetic_test_wrapper instead.
test:macos --strategy=TestRunner=local

# Linux test actions must use the namespace-capable sandbox. Naming the
# strategy explicitly prevents Bazel from silently falling back to
# processwrapper-sandbox, which provides neither a mount boundary nor a network
# namespace. /tmp is a per-action tmpfs so the wrapper can give Unix sockets a
# short path without exposing the host's shared temporary directory. If the
# agent cannot provide linux-sandbox, test execution fails closed.
test:linux --strategy=TestRunner=linux-sandbox
test:linux --sandbox_tmpfs_path=/tmp

# Bazel's own test/XML wrappers need the static host PATH before the test
# binary starts. This run-under wrapper removes that PATH at the user-code
# boundary, so test code cannot discover undeclared host tools such as gh, bk,
# codex, claude, or cube.
test --run_under=//tools/test-sandbox:hermetic_test_wrapper

# Align analysis configuration across build / cquery / test.
#
# On Bazel 9.x, `cquery` inherits options from `test` (CqueryCommand
# inheritsOptionsFrom=TestCommand), so `test --run_under=...` above is also
# applied to every cquery. `--run_under` is analysis-affecting: a cquery that
# carries it runs under a different configuration than a plain `bazel build`
# (which does not set it), and each flip discards the analysis cache. repobin
# (and other tools) interleave build + cquery constantly, so this thrash is
# continuous. Empty `cquery --run_under=` is not valid on this Bazel version
# ("Empty command"), so instead give `build` the same non-empty value. The
# flag only affects test/run execution prefixes, not compile actions; setting
# it on build is an analysis-config alignment so build and cquery share a
# cache. Do not remove or weaken the `test --run_under` line — that wrapper
# is what enforces test hermeticity.
build --run_under=//tools/test-sandbox:hermetic_test_wrapper

# `bazel run` inherits build options. The hermetic test wrapper requires
# TEST_SRCDIR and the audited test runtime, so it is not suitable for
# interactive runs. Override with an argv-passthrough prefix so `bazel run`
# keeps working. This reintroduces a build↔run analysis-cache flip; that
# path is far rarer than build↔cquery (repobin).
run --run_under=/usr/bin/env

# Bazel already constructs a test environment rather than inheriting the
# caller's environment. Keep the credential boundary explicit as defense in
# depth and as documentation for direct attempts to inject these common keys.
test --test_env=ANTHROPIC_API_KEY=
test --test_env=OPENAI_API_KEY=
test --test_env=GITHUB_TOKEN=
test --test_env=GH_TOKEN=
test --test_env=BOSS_SHAKE_APP_ID=
test --test_env=BOSS_SHAKE_INSTALLATION_ID=
test --test_env=BOSS_SHAKE_PRIVATE_KEY_PEM=


# Import ci-specific configuration.
import %workspace%/.ci.bazelrc
