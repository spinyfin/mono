# The step libraries are exported only to their own tests; the step scripts
# themselves are run by Buildkite straight from the checkout, not by bazel.
# Named files keep existing tests working; the globbed filegroup lets
# execlog_config_test see every script that might source ci-env.sh.
exports_files(
    [
        "bazel-build-test.sh",
        "bazel-server-lock.sh",
        "bazel-step-flags.sh",
        "boss-head-release-tag.sh",
        "boss-release.sh",
        "changelog-release.sh",
        "checkleft-release.sh",
        "checks.sh",
        "ci-env.sh",
        "ci-execlog.sh",
        "disk-cache-gc-cap.sh",
        "fetch-boss-tags.sh",
        "integrity-bazel.sh",
        "integrity-checkleft.sh",
        "mac-app-build.sh",
        "release-release.sh",
        "remote-execution.sh",
        "repobin-release.sh",
        "report-flaky-tests.py",
        "spoke-release.sh",
        "verify-boss-tag-cache.sh",
    ],
    visibility = ["//.buildkite/steps/tests:__pkg__"],
)

filegroup(
    name = "step_scripts",
    srcs = glob(["*.sh"]),
    visibility = ["//.buildkite/steps/tests:__pkg__"],
)
