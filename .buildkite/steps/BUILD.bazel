# The step libraries are exported only to their own tests; the step scripts
# themselves are run by Buildkite straight from the checkout, not by bazel.
exports_files(
    [
        "bazel-build-test.sh",
        "bazel-server-lock.sh",
        "boss-head-release-tag.sh",
        "boss-release.sh",
        "ci-env.sh",
        "disk-cache-gc-cap.sh",
        "fetch-boss-tags.sh",
        "remote-execution.sh",
        "report-flaky-tests.py",
    ],
    visibility = ["//.buildkite/steps/tests:__pkg__"],
)
