load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "flaky_report_test",
    size = "small",
    srcs = ["flaky_report_test.sh"],
    data = [
        "flaky_report_test.py",
        "//:.ci.bazelrc",
        "//.buildkite/steps:bazel-build-test.sh",
        "//.buildkite/steps:report-flaky-tests.py",
    ],
)

# Script-level test for the per-host Bazel disk-cache GC cap that ci-env.sh
# computes: known filesystem sizes map to the expected cap, and an
# unresolvable cache directory, unusable df output or missing rc line fails
# loudly instead of falling back to .ci.bazelrc's fleet-wide value.
sh_test(
    name = "disk_cache_gc_cap_test",
    size = "small",
    srcs = ["disk_cache_gc_cap_test.sh"],
    data = [
        "//:.ci.bazelrc",
        "//.buildkite/steps:disk-cache-gc-cap.sh",
    ],
)

# Script-level test for the decision ci-env.sh makes about where a step's
# bazel actions execute: a step that has not opted in, a platform with no
# workers, an agent without an endpoint and an endpoint that does not answer
# all build on the agent; a malformed endpoint fails loudly; and the flags for
# the macOS and Linux remote cases select configs that .ci.bazelrc really
# defines, neither with a test strategy of its own.
sh_test(
    name = "remote_execution_test",
    size = "small",
    srcs = ["remote_execution_test.sh"],
    data = [
        "//:.ci.bazelrc",
        "//.buildkite/steps:remote-execution.sh",
        "//tools/remote-execution:remote-status.sh",
    ],
)

# Script-level test that ci-env.sh's bazel_verify_only selects the `ci-strip`
# config .ci.bazelrc defines, and that no release path does.
sh_test(
    name = "ci_strip_config_test",
    size = "small",
    srcs = ["ci_strip_config_test.sh"],
    data = [
        "//:.ci.bazelrc",
        "//.buildkite/steps:bazel-step-flags.sh",
        "//.buildkite/steps:ci-env.sh",
    ],
)

# Script-level test for the per-step analysis flags ci-env.sh appends to
# CI_BAZEL_FLAGS / REPOBIN_BAZEL_FLAGS so tool-install keeps the analysis
# cache. Also greps each CI step that sources ci-env.sh for the matching
# CI_BAZEL_VERIFY_ONLY / CI_BAZEL_STEP_FLAGS opt-in.
sh_test(
    name = "bazel_step_flags_test",
    size = "small",
    srcs = ["bazel_step_flags_test.sh"],
    data = [
        "//.buildkite/steps:bazel-build-test.sh",
        "//.buildkite/steps:bazel-step-flags.sh",
        "//.buildkite/steps:boss-release.sh",
        "//.buildkite/steps:changelog-release.sh",
        "//.buildkite/steps:checkleft-release.sh",
        "//.buildkite/steps:checks.sh",
        "//.buildkite/steps:ci-env.sh",
        "//.buildkite/steps:integrity-bazel.sh",
        "//.buildkite/steps:integrity-checkleft.sh",
        "//.buildkite/steps:mac-app-build.sh",
        "//.buildkite/steps:release-release.sh",
        "//.buildkite/steps:repobin-release.sh",
        "//.buildkite/steps:spoke-release.sh",
        "//.buildkite/steps:verify-boss-tag-cache.sh",
    ],
)

# Script-level test for the recovery ci-env.sh runs before its first bazel
# call: a bazel server still held by an earlier job's command is located from
# the output base's own records and stopped (SIGTERM, then SIGKILL), a free
# server is left alone, and an unlocatable, unrelated or unkillable holder
# fails the step instead of being waited on or signalled.
sh_test(
    name = "bazel_server_lock_test",
    size = "small",
    srcs = ["bazel_server_lock_test.sh"],
    data = ["//.buildkite/steps:bazel-server-lock.sh"],
)

# Script-level test for the cheap already-tagged skip boss-release.sh runs
# before ci-env.sh builds //tools/release: a fixture whose HEAD is the latest
# published boss-v1.0.N family release exits without bazel; an older published
# HEAD, a draft, or an untagged HEAD reaches prepare.
# Tag matching is the same version-family rule as bin/release prepare.
sh_test(
    name = "boss_head_release_tag_test",
    size = "small",
    srcs = ["boss_head_release_tag_test.sh"],
    data = [
        "//.buildkite/steps:boss-head-release-tag.sh",
        "//.buildkite/steps:boss-release.sh",
        "//.buildkite/steps:fetch-boss-tags.sh",
        "//tools:boss/release.toml",
        "//tools/release:src/testdata/boss-version-family-cases.txt",
    ],
)

# Script-level test for the boss-v* tag sync ci-env.sh runs before its first
# bazel call: missing boss-v* tags are fetched, deleted boss-v* tags are
# pruned, moved boss-v* tags are updated, unrelated tags are untouched, and
# unreachable remotes fail non-zero.
sh_test(
    name = "fetch_boss_tags_test",
    size = "small",
    srcs = ["fetch_boss_tags_test.sh"],
    data = [
        "//.buildkite/steps:ci-env.sh",
        "//.buildkite/steps:fetch-boss-tags.sh",
    ],
)

