load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Script-level test for the per-host Bazel disk-cache GC cap that ci-env.sh
# computes: known filesystem sizes map to the expected cap, and an
# unresolvable cache directory, unusable df output or missing rc line fails
# loudly instead of falling back to .ci.bazelrc's fleet-wide value.
sh_test(
    name = "disk_cache_gc_cap_test",
    size = "small",
    srcs = ["disk_cache_gc_cap_test.sh"],
    data = [
        "//:.ci.bazelrc",
        "//.buildkite/steps:disk-cache-gc-cap.sh",
    ],
)

# Script-level test for the decision ci-env.sh makes about where a step's
# bazel actions execute: a step that has not opted in, a platform with no
# workers, an agent without an endpoint and an endpoint that does not answer
# all build on the agent; a malformed endpoint fails loudly; and the flags for
# the macOS and Linux remote cases select configs that .ci.bazelrc really
# defines, neither with a test strategy of its own.
sh_test(
    name = "remote_execution_test",
    size = "small",
    srcs = ["remote_execution_test.sh"],
    data = [
        "//:.ci.bazelrc",
        "//.buildkite/steps:remote-execution.sh",
        "//tools/remote-execution:remote-status.sh",
    ],
)
