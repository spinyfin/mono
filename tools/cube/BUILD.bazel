load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "cube_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "cube",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//lib/rust/bazel_support",
        "//lib/rust/git_utils",
        "//lib/rust/process_runner",
        "//lib/rust/workspace_procs",
    ] + all_crate_deps(normal = True),
)

rust_binary(
    name = "cube",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/app-macos:__pkg__",
        "//tools/boss/engine/app:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/installer:__pkg__",
    ],
    deps = [
        ":cube_lib",
    ] + all_crate_deps(normal = True),
)

sh_test(
    name = "gc_store_archive_test",
    size = "small",
    srcs = ["testdata/gc_store_archive_test.py"],
    args = [
        "$(rootpath testdata/gc_store.json)",
        "$(rootpath testdata/gc_store.sh)",
        "$(rootpath //tools/boss/engine/recovery:jj_repository.bzl)",
        "$(rootpath testdata/gc_store_archive.py)",
    ],
    data = [
        "testdata/gc_store.json",
        "testdata/gc_store.sh",
        "testdata/gc_store_archive.py",
        "//tools/boss/engine/recovery:jj_repository.bzl",
    ],
)

# @host_lsof//:lsof must stay a symlink to the host's lsof: a remote macOS
# worker cannot launch a copy of it. Off macOS the label is a stub script.
sh_test(
    name = "host_lsof_symlink_guard_test",
    size = "small",
    srcs = ["//tools/test-sandbox:host_tool_symlink_guard_test.sh"],
    args = [
        "$(rootpath @host_lsof//:lsof)",
        "/usr/sbin/lsof",
    ],
    data = ["@host_lsof//:lsof"],
    target_compatible_with = ["@platforms//os:macos"],
)

# The same suite against the oldest and the newest jj cube supports (see
# docs/jj-compatibility.md). `BOSS_JJ_BIN` is the jj under test.
[
    rust_test(
        name = name,
        # Includes real GC rewrites and concurrent leases; only jj 0.26 uses
        # the 16,800-operation scale fixture (newer jj fsyncs each rewrite).
        size = "large",
        crate = ":cube_lib",
        # Real-jj fixtures (a throwaway colocated repo) for the `pr/<n>` bookmark
        # lifecycle tests; the binary is declared, never taken from PATH.
        data = [
            ":cube",
            "@cube_jj_newer//:jj",
            "@host_lsof//:lsof",
            "@jj_test_tools//:jj",
        ] + extra_data,
        env = {
            "BOSS_JJ_BIN": "$(rootpath {})".format(jj),
            # The mixed-version GC tests use this as the oldest client,
            # whichever jj is under test.
            "CUBE_OLDEST_JJ_BIN": "$(rootpath @jj_test_tools//:jj)",
            # An empty cut selects a small real history built by the test.
            "CUBE_GC_STORE_CUT": gc_cut,
            "CUBE_NEWER_JJ_BIN": "$(rootpath @cube_jj_newer//:jj)",
            "CUBE_TEST_BIN": "$(rootpath :cube)",
            "CUBE_TEST_LSOF": "$(rootpath @host_lsof//:lsof)",
        },
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
            proc_macro_dev = True,
        ),
        deps = [
            "//lib/rust/workspace_procs",
            "//tools/boss/engine/test-git",
        ] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for name, jj, gc_cut, extra_data in [
        (
            "cube_lib_test",
            "@jj_test_tools//:jj",
            "$(rootpath @cube_gc_store_tree//:cut)",
            [
                "@cube_gc_store_tree//:cut",
                "@cube_gc_store_tree//:store",
            ],
        ),
        (
            "cube_lib_jj_046_test",
            "@jj_upgrade_test_tools//:jj",
            "",
            ["@jj_upgrade_test_tools//:jj"],
        ),
    ]
]

rust_test(
    name = "cube_bin_test",
    size = "small",
    crate = ":cube",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
