load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "cube_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "cube",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//lib/rust/git_utils",
        "//lib/rust/process_runner",
    ] + all_crate_deps(normal = True),
)

rust_binary(
    name = "cube",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/app-macos:__pkg__",
        "//tools/boss/installer:__pkg__",
    ],
    deps = [
        ":cube_lib",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "cube_lib_test",
    # Includes a real 16,800-operation GC rewrite and concurrent leases.
    size = "large",
    crate = ":cube_lib",
    # Real-jj fixtures (a throwaway colocated repo) for the `pr/<n>` bookmark
    # lifecycle tests; the binary is declared, never taken from PATH.
    data = [
        ":cube",
        "@jj_test_tools//:jj",
    ],
    env = {
        "BOSS_JJ_BIN": "$(rootpath @jj_test_tools//:jj)",
        "CUBE_TEST_BIN": "$(rootpath :cube)",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/engine/test-git",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "cube_bin_test",
    size = "small",
    crate = ":cube",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
