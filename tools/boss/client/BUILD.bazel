load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load(
    "//tools/boss/engine/core:engine_binary.bzl",
    "ENGINE_BINARY_BAZEL_RELPATH",
    "ENGINE_BINARY_NAME",
    "ENGINE_BINARY_TARGET",
)
load("//tools/boss/test-isolation:boss_rust_test.bzl", "boss_rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "client",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_client",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {
        "BOSS_ENGINE_BINARY_BAZEL_RELPATH": ENGINE_BINARY_BAZEL_RELPATH,
        "BOSS_ENGINE_BINARY_NAME": ENGINE_BINARY_NAME,
        "BOSS_ENGINE_BINARY_TARGET": ENGINE_BINARY_TARGET,
    },
    visibility = [
        "//tools/boss:__subpackages__",
    ],
    deps = [
        "//tools/boss/log-files",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

boss_rust_test(
    name = "client_test",
    size = "small",
    crate = ":client",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/log-files",
        "//tools/boss/protocol",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
