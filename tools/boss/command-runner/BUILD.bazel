load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/boss/test-isolation:boss_rust_test.bzl", "boss_rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "command-runner",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_command_runner",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/bossctl:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/deterministic-resolvers:__pkg__",
        "//tools/boss/tmux:__pkg__",
    ],
    deps = all_crate_deps(normal = True),
)

boss_rust_test(
    name = "command-runner_test",
    size = "small",
    crate = ":command-runner",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
