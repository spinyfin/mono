load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "build-provenance",
    srcs = glob(
        ["src/**/*.rs"],
        # Cargo-only fallback: build.rs points BOSS_BUILD_PROVENANCE_RS at
        # this file so `include!(env!(...))` compiles without Bazel. The
        # Bazel build instead stamps it via compile_data + rustc_env below.
        exclude = ["src/provenance_default.rs"],
    ),
    compile_data = [
        # Stamped provenance constants (VERSION, GIT_SHA, GIT_DIRTY, BUILD_TIME).
        # Referenced via include!(env!("BOSS_BUILD_PROVENANCE_RS")) in lib.rs.
        "//tools/boss/installer:build_provenance_rs",
    ],
    crate_name = "boss_build_provenance",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = {
        # Absolute path to the generated provenance-constants file.
        "BOSS_BUILD_PROVENANCE_RS": "$(execpath //tools/boss/installer:build_provenance_rs)",
    },
    # Only the `engine` rust_binary targets may link this crate — never
    # `engine_lib`. Its source embeds the commit sha, so every dependent
    # recompiles on every commit; the binaries hand the values to engine_lib
    # at runtime instead (build_info::install_provenance). Package-level
    # visibility cannot express "binaries only", so
    # //tools/boss/engine/core:stamped_provenance_isolation_test enforces it.
    visibility = [
        "//tools/boss/engine/core:__pkg__",
    ],
)

# Genuinely depends on the stamp, so this is the one test target a
# docs-only commit still executes (it takes well under a second).
rust_test(
    name = "build-provenance_test",
    size = "small",
    crate = ":build-provenance",
    edition = "2024",
)
