load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro", "rust_test")

exports_files(["Cargo.toml"])

rust_proc_macro(
    name = "protocol_macros",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_protocol_macros",
    edition = "2024",
    visibility = ["//tools/boss/protocol:__pkg__"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "protocol_macros_test",
    size = "small",
    crate = ":protocol_macros",
    edition = "2024",
)

# The compiler and its sysroot are declared runfiles; the test inherits the
# hermetic wrapper's private temporary directory and never invokes Cargo.
rust_test(
    name = "invalid_annotations_test",
    size = "small",
    srcs = ["tests/invalid_annotations.rs"],
    data = [
        ":protocol_macros",
        "@rules_rust//rust/toolchain:current_rust_toolchain",
        "@rules_rust//rust/toolchain:current_rustc_files",
    ],
    edition = "2024",
    env = {
        "EVENT_MACRO": "$(rootpath :protocol_macros)",
        "EVENT_RUSTC": "$(rootpath @rules_rust//rust/toolchain:current_rustc_files)",
    },
    proc_macro_deps = [":protocol_macros"],
)
