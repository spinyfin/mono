load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml"])

# The wire schema. Package boss.spoke.v1 lives at proto/boss/spoke/v1/ so the
# import path (boss/spoke/v1/spoke.proto) matches the package directory.
proto_library(
    name = "spoke_v1_proto",
    srcs = ["proto/boss/spoke/v1/spoke.proto"],
    strip_import_prefix = "proto",
)

# prost messages and tonic services generated by the toolchain in
# //third_party/prost.
rust_prost_library(
    name = "spoke_v1_rust_proto",
    proto = ":spoke_v1_proto",
)

# Visible only to its consumers. The rest of the design-named ones
# (engine/core, engine/spoke, engine/spoke-journal, engine/spoke-stream) are
# added in the PR that makes each depend on this crate.
rust_library(
    name = "protocol-spoke",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_protocol_spoke",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/host-enrollment:__pkg__"],
    deps = [
        ":spoke_v1_rust_proto",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "protocol-spoke_test",
    size = "small",
    crate = ":protocol-spoke",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = ["//tools/boss/protocol"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Old/new peer semantics: unknown fields, enum numbers and oneof variants,
# defaults for absent optional fields, and negotiation across builds.
rust_test(
    name = "compat_test",
    size = "small",
    srcs = ["tests/compat.rs"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [":protocol-spoke"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# tonic hub and spoke over real mutual TLS on loopback (certificates minted
# per run). Loopback is allowed by the hermetic test sandbox, so this is an
# ordinary rust_test, not a network_enabled_rust_test.
rust_test(
    name = "mtls_duplex_test",
    size = "small",
    srcs = ["tests/mtls_duplex.rs"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [":protocol-spoke"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Rules every version of the schema must satisfy, checked on the descriptor set
# Bazel gives the code generator (proto_library's default output).
rust_test(
    name = "schema_rules_test",
    size = "small",
    srcs = ["tests/schema_rules.rs"],
    data = [":spoke_v1_proto"],
    edition = "2024",
    env = {"SPOKE_V1_DESCRIPTOR": "$(rootpath :spoke_v1_proto)"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The protoc plugins and the prost/tonic runtime come from one Cargo.lock; this
# fails if a bump splits them (see tests/toolchain_coherence.rs).
rust_test(
    name = "toolchain_coherence_test",
    size = "small",
    srcs = ["tests/toolchain_coherence.rs"],
    data = ["//:Cargo.lock"],
    edition = "2024",
    env = {"CARGO_LOCK": "$(rootpath //:Cargo.lock)"},
)

# ---------------------------------------------------------------------------
# Breaking-change gate (see README.md, "Evolution rules and the compatibility
# gate"). buf is pinned per platform in MODULE.bazel.
# ---------------------------------------------------------------------------

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

_BUF_COMPATIBLE = select({
    ":linux_arm64": [],
    ":linux_x86_64": [],
    ":macos_arm64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# A filegroup rather than an alias so it can carry target_compatible_with:
# on a platform without a pinned buf, `//...` skips it (and its dependents)
# as incompatible instead of failing analysis.
filegroup(
    name = "buf",
    srcs = select({
        ":linux_arm64": ["@buf_aarch64_linux//:buf"],
        ":linux_x86_64": ["@buf_x86_64_linux//:buf"],
        ":macos_arm64": ["@buf_aarch64_macos//:buf"],
        "//conditions:default": [],
    }),
    target_compatible_with = _BUF_COMPATIBLE,
)

_PROTO_ROOT = "tools/boss/protocol-spoke/proto"

_BASELINE_ROOT = "tools/boss/protocol-spoke/compat/baseline"

_MERGE_BASE_ROOT = "tools/boss/protocol-spoke/compat/merge_base"

_COMPAT_DATA = [
    ":buf",
    "compat/baseline/boss/spoke/v1/spoke.proto",
    "proto/boss/spoke/v1/spoke.proto",
]

# Fails when the schema drifted from the checked-in baseline, and, when CI has
# staged the merge-base baseline under compat/merge_base/, when the schema is
# not backward compatible with it.
sh_test(
    name = "proto_breaking_test",
    size = "small",
    srcs = ["compat/proto_compat.sh"],
    args = [
        "check",
        "$(rootpath :buf)",
        _PROTO_ROOT,
        _BASELINE_ROOT,
        _MERGE_BASE_ROOT,
    ],
    data = _COMPAT_DATA + glob(
        ["compat/merge_base/**/*.proto"],
        allow_empty = True,
    ),
    target_compatible_with = _BUF_COMPATIBLE,
)

# `bazel run //tools/boss/protocol-spoke:update_baseline` records a backward
# compatible schema change; it refuses to cross a breaking one.
sh_binary(
    name = "update_baseline",
    srcs = ["compat/proto_compat.sh"],
    args = [
        "update",
        "$(rootpath :buf)",
        _PROTO_ROOT,
        _BASELINE_ROOT,
    ],
    data = _COMPAT_DATA,
    target_compatible_with = _BUF_COMPATIBLE,
)
