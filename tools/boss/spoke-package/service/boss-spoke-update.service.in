[Unit]
Description=Boss spoke update helper
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=8

[Service]
Type=oneshot
TimeoutStartSec=2700
TimeoutStopSec=120
Restart=on-failure
RestartSec=2
ExecStart={{installer}} apply-update --config {{config}}

[Install]
WantedBy=multi-user.target
