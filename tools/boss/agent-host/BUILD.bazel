load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# The relay behind `boss-agent-host`. It knows nothing about what the lines
# mean, so it carries no protocol dependency. Nothing links it yet except its
# own binary and tests; widen the visibility when a consumer needs the
# journal record type.
rust_library(
    name = "agent_host",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "boss_agent_host",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:private"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "agent_host_test",
    size = "small",
    crate = ":agent_host",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The binary the coordinator's tmux pane runs. Bundled in Boss.app and the
# installer payload; the engine finds it through //tools/boss/engine/worker-bin.
# stamp = 0 so --config=release does not feed stable-status.txt into this
# rustc action on every release tag.
rust_binary(
    name = "boss-agent-host",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    stamp = 0,
    visibility = [
        "//tools/boss/app-macos:__pkg__",
        "//tools/boss/installer:__pkg__",
    ],
    deps = [":agent_host"] + all_crate_deps(normal = True),
)

# Test helper: a child that replays a recorded journal over stdio. Later
# entries that need a scripted agent depend on it; widen the visibility then.
rust_binary(
    name = "boss-agent-host-scripted-child",
    testonly = True,
    srcs = ["tests/support/scripted_child.rs"],
    crate_root = "tests/support/scripted_child.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:private"],
    deps = all_crate_deps(normal = True),
)

# The relay end to end: the real host library and binary against the scripted
# child, with clients that die and reconnect.
rust_test(
    name = "relay_test",
    size = "small",
    srcs = ["tests/relay.rs"],
    crate_root = "tests/relay.rs",
    data = [
        ":boss-agent-host",
        ":boss-agent-host-scripted-child",
    ],
    edition = "2024",
    env = {
        "BOSS_AGENT_HOST_TEST_BIN": "$(rootpath :boss-agent-host)",
        "BOSS_AGENT_HOST_TEST_CHILD": "$(rootpath :boss-agent-host-scripted-child)",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [":agent_host"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
