load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "review-guide",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "boss_review_guide",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/app:__pkg__",
        "//tools/boss/engine/completion:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/execution-runner:__pkg__",
        "//tools/boss/engine/work-db:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/pr-review-sources",
        "//tools/boss/engine/pr-template",
    ] + all_crate_deps(normal = True),
)

# Standalone CLI for the six-PR validation recipe (see
# tools/boss/docs/evaluations/automatic-pr-review-guides/README.md). Not a
# dependency of production targets; only the offline recipe test consumes it.
rust_binary(
    name = "corpus-tool",
    srcs = ["src/bin/corpus_tool.rs"],
    crate_name = "review_guide_corpus_tool",
    crate_root = "src/bin/corpus_tool.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/docs/evaluations/automatic-pr-review-guides:__pkg__"],
    deps = [
        ":review-guide",
        "//tools/boss/engine/pr-review-sources",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "review-guide_test",
    size = "small",
    crate = ":review-guide",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/engine/pr-review-sources",
        "//tools/boss/engine/pr-template",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
