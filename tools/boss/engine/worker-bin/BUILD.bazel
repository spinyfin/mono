load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "worker-bin",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_worker_bin",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/completion:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/driver:__pkg__",
        "//tools/boss/engine/execution-runner:__pkg__",
        "//tools/boss/engine/observation-contracts:__pkg__",
    ],
    deps = ["//tools/boss/worker-processes"] + all_crate_deps(normal = True),
)

rust_test(
    name = "worker-bin_test",
    size = "small",
    crate = ":worker-bin",
    data = select({
        "@platforms//os:macos": ["@worker_zsh//:zsh"],
        "//conditions:default": [],
    }),
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = ["//tools/boss/worker-processes"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# @worker_zsh//:zsh must stay a symlink to /bin/zsh: the tests above run the
# shell by that path, and on a remote worker only a symlink leaving the
# runfiles tree makes the test wrapper grant it.
sh_test(
    name = "worker_zsh_symlink_guard_test",
    size = "small",
    srcs = ["//tools/test-sandbox:host_tool_symlink_guard_test.sh"],
    args = [
        "$(rootpath @worker_zsh//:zsh)",
        "/bin/zsh",
    ],
    data = ["@worker_zsh//:zsh"],
    target_compatible_with = ["@platforms//os:macos"],
)
