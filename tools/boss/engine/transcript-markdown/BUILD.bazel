load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/boss/test-isolation:boss_rust_test.bzl", "boss_rust_test")

rust_library(
    name = "transcript_markdown",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/testdata/**"]),
    crate_name = "boss_transcript_markdown",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/codex-rollout",
        "//tools/boss/engine/utils",
    ] + all_crate_deps(normal = True),
)

boss_rust_test(
    name = "transcript_markdown_test",
    size = "small",
    compile_data = glob(["src/testdata/**"]),
    crate = ":transcript_markdown",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/engine/codex-rollout",
        "//tools/boss/engine/utils",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
