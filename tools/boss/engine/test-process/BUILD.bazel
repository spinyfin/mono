load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Owning guards and sleeper fixtures for tests that exercise a real process
# kill. It sits below both `host-execution` and `completion` (which depends on
# `host-execution`), so each can share one copy instead of carrying its own.
rust_library(
    name = "test-process",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_test_process",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/completion:__pkg__",
        "//tools/boss/engine/host-execution:__pkg__",
    ],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "test-process_test",
    size = "small",
    crate = ":test-process",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
