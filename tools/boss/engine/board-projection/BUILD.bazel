load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "board-projection",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_board_projection",
    edition = "2024",
    visibility = [
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/work-db:__pkg__",
    ],
    deps = ["//tools/boss/protocol"],
)

rust_test(
    name = "board-projection_test",
    size = "small",
    crate = ":board-projection",
    edition = "2024",
    deps = ["//tools/boss/protocol"] + all_crate_deps(normal_dev = True),
)
