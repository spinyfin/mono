load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/boss/engine/core:engine_binary.bzl", "ENGINE_BINARY_BAZEL_RUN_COMMAND")
load("//tools/boss/engine/core:runtime.bzl", "TEST_ALIASES", "TEST_DEPS")

exports_files(["Cargo.toml"])

filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//tools/boss/engine/core:__pkg__"],
)

APP_DEPS = [
    "//tools/boss/engine/host-enrollment",
    "//tools/boss/engine/spoke-adapter",
    "//tools/boss/command-runner",
    "//tools/boss/engine/execution-runner",
    "//tools/boss/engine/execution-contracts",
    "//tools/boss/comment_anchor",
    "//tools/boss/engine/attachments",
    "//tools/boss/engine/board-gesture",
    "//tools/boss/engine/comment-classifier",
    "//tools/boss/engine/completion",
    "//tools/boss/engine/design-docs",
    "//tools/boss/engine/dispatch",
    "//tools/boss/engine/dispatch-events",
    "//tools/boss/engine/dispatch-reader",
    "//tools/boss/engine/driver",
    "//tools/boss/engine/driver-quota",
    "//tools/boss/engine/editorial",
    "//tools/boss/engine/effort",
    "//tools/boss/engine/event-bus",
    "//tools/boss/engine/feature-flags",
    "//tools/boss/engine/gh-invocation",
    "//tools/boss/engine/live-worker-state",
    "//tools/boss/engine/merge-poller",
    "//tools/boss/engine/metrics",
    "//tools/boss/engine/offsite-backup",
    "//tools/boss/engine/proposal-validation",
    "//tools/boss/engine/recovery",
    "//tools/boss/engine/review-guide",
    "//tools/boss/engine/single-flight",
    "//tools/boss/engine/ssh-transport",
    "//tools/boss/engine/storage-values",
    "//tools/boss/engine/task-scope",
    "//tools/boss/engine/timer-wheel",
    "//tools/boss/engine/transcript-markdown:transcript_markdown",
    "//tools/boss/engine/transient-error",
    "//tools/boss/engine/utility-model",
    "//tools/boss/engine/utils",
    "//tools/boss/engine/work-db",
    "//tools/boss/engine/worker-policy",
    "//tools/boss/gh_telemetry",
    "//tools/boss/github",
    "//tools/boss/http_retry",
    "//tools/boss/log-files",
    "//tools/boss/protocol",
    "//tools/boss/protocol-spoke",
    "//tools/boss/tmux",
    "//tools/boss/trunk_auth",
    "//tools/boss/trunk_client",
    "//tools/boss/engine/core:runtime",
]

rust_library(
    name = "app",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_app",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"BOSS_ENGINE_BAZEL_RUN_COMMAND": ENGINE_BINARY_BAZEL_RUN_COMMAND},
    visibility = ["//tools/boss/engine/core:__pkg__"],
    deps = APP_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "app_test",
    size = "small",
    # One combinatorial question-surface test alone exceeds 300s on loaded
    # agents; the rest of shard 3 then misses the moderate budget.
    timeout = "long",
    # crate inheritance keeps the production dependency; compile this test
    # against the fixture variant under its usual Rust name instead. App also
    # depends on the runtime crate, so swap that too.
    aliases = TEST_ALIASES | {
        "//tools/boss/engine/spoke-adapter": "boss_spoke_adapter_production",
        "//tools/boss/engine/spoke-adapter:spoke_adapter_test_support": "boss_spoke_adapter",
        "//tools/boss/engine/core:runtime": "boss_engine_runtime_production",
        "//tools/boss/engine/core:runtime_test_support": "boss_engine_runtime",
    },
    crate = ":app",
    data = [
        "//tools/boss/cli:boss",
        "//tools/boss/bossctl",
        # Config loading requires an engine-owned cube, just like the engine.
        "//tools/cube",
        "@jj_test_tools//:jj",
    ],
    edition = "2024",
    env = {
        "BOSS_TEST_CLI": "$(rootpath //tools/boss/cli:boss)",
        "BOSSCTL_TEST_BINARY": "$(rootpath //tools/boss/bossctl)",
        "BOSS_EVENT_BIN": "/opt/boss/bin/boss-event",
        "BOSS_JJ_BIN": "$(rootpath @jj_test_tools//:jj)",
        "HOME": "/tmp",
    },
    experimental_enable_sharding = True,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    shard_count = 4,
    visibility = ["//tools/boss/engine/core:__pkg__"],
    deps = TEST_DEPS + [
        "//tools/boss/engine/core:runtime_test_support",
        "//tools/boss/engine/host-execution",
        "//tools/boss/engine/prose-vocabulary",
        "//tools/boss/engine/spoke-adapter:spoke_adapter_test_support",
        "//tools/boss/engine/spoke-journal",
        "//tools/boss/engine/spoke-worker-api",
        "//tools/boss/engine/task-scope",
        "//tools/boss/protocol-spoke",
        "//tools/boss/worker-processes",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
