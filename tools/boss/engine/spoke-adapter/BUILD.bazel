load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Hub-side adapter installed by the application's optional spoke listener.
rust_library(
    name = "spoke-adapter",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_spoke_adapter",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/app:__pkg__"],
    deps = [
        "//tools/boss/engine/execution-contracts",
        "//tools/boss/engine/host-execution",
        "//tools/boss/engine/recovery",
        "//tools/boss/engine/spoke-stream",
        "//tools/boss/engine/structured-output",
        "//tools/boss/engine/work-db",
        "//tools/boss/protocol",
        "//tools/boss/protocol-spoke",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "integration_test",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        ":spoke-adapter",
        "//tools/boss/engine/core:runtime",
        "//tools/boss/engine/execution-contracts",
        "//tools/boss/engine/host-enrollment",
        "//tools/boss/engine/host-execution",
        "//tools/boss/engine/recovery",
        "//tools/boss/engine/spoke-stream",
        "//tools/boss/engine/structured-output",
        "//tools/boss/engine/work-db",
        "//tools/boss/protocol",
        "//tools/boss/protocol-spoke",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_library(
    name = "spoke_adapter_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
        "//tools/boss/engine/execution-contracts:execution_contracts_test_support": "boss_execution_contracts",
    },
    crate_name = "boss_spoke_adapter",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/app:__pkg__"],
    deps = [
        "//tools/boss/engine/execution-contracts:execution_contracts_test_support",
        "//tools/boss/engine/host-execution",
        "//tools/boss/engine/recovery",
        "//tools/boss/engine/spoke-stream",
        "//tools/boss/engine/structured-output",
        "//tools/boss/engine/work-db:work_db_test_support",
        "//tools/boss/protocol",
        "//tools/boss/protocol-spoke",
    ] + all_crate_deps(normal = True),
)
