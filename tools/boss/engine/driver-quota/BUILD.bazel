load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/boss/test-isolation:boss_rust_test.bzl", "boss_rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "driver-quota",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_driver_quota",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = all_crate_deps(normal = True) + [
        "//tools/boss/engine/codex-hook-trust",
        "//tools/boss/engine/utils",
        "//tools/boss/http_retry",
        "//tools/boss/protocol",
    ],
)

boss_rust_test(
    name = "driver-quota_test",
    size = "small",
    crate = ":driver-quota",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//tools/boss/engine/codex-hook-trust",
        "//tools/boss/engine/utils",
        "//tools/boss/http_retry",
        "//tools/boss/protocol",
    ],
)
