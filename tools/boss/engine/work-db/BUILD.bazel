rust_test(
    name = "work_db_test",
    size = "small",
    # 2,500+ tests in one unsharded process, so it has no shards to spread a
    # loaded host over: `long` rather than `moderate`. Seeded-board scale
    # tests and measurements run in `work_db_scale_test`.
    timeout = "long",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//tools/boss/app-macos:work_board_banners_swift"],
    crate_root = "src/lib.rs",
    data = [
        "//tools/boss/app-macos:work_board_banners_swift",
        "@jj_test_tools//:jj",
    ] + glob(["src/**/*.rs"]),
    edition = "2024",
    env = {
        "BOSS_JJ_BIN": "$(rootpath @jj_test_tools//:jj)",
        "HOME": "/tmp",
    },
    proc_macro_deps = ["//tools/boss/engine/work-db-boundary:work_db_boundary"] + all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"BOSS_WORK_BOARD_BANNERS_SWIFT": "$(execpath //tools/boss/app-macos:work_board_banners_swift)"},
    deps = WORK_DB_TEST_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Seeded-board scale tests and production-cardinality measurements: the
# work-tree, board-projection, queued-wait, design-doc contention and durable
# ingress tests, on fixtures of roughly 10,000 tasks and 20,000 executions (or
# a 100 MB execution history). They are compiled only here:
# `--cfg=boss_scale_tests` gates their modules, so `work_db_test` neither
# builds those fixtures nor holds them in memory. They still run on every
# `bazel test //...`, CI included.
#
# The binary is the whole test crate, so the target selects its tests by name:
# every test whose path contains `scale`. `tests::scale_selection_guard` fails
# if a cfg-gated module would be skipped or an ungated test would match.
# The selection is passed the way `bazel test --test_filter` passes one, as
# TESTBRIDGE_TEST_ONLY, because the rust_test wrapper then refuses to report
# success when it matches nothing. A plain `args` filter that stopped matching
# would pass with zero tests run. An explicit `--test_filter` replaces it, for
# running one measurement.
#
# size/timeout: the tests run side by side for about half a minute on a
# remote-execution worker, and together peak near 1.25 GB of live heap, 1.6
# to 1.8 GB resident (the work-tree measurement alone keeps four probes'
# boards live). That is `enormous` in Bazel's memory classes; the time fits
# `moderate`. `cpu:4` reserves cores for the tests that fan out to dozens of
# threads when the target runs locally.
#
# RUST_TEST_NOCAPTURE puts the measured numbers in the log of every run. It
# is set through the environment, not `args`, because libtest rejects an
# option given twice and `--test_arg=--nocapture` is the habitual way to run
# one measurement. Benchmark-grade sampling is described in
# tools/boss/docs/work-tree-scale-measurement.md.
rust_test(
    name = "work_db_scale_test",
    size = "enormous",
    timeout = "moderate",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//tools/boss/app-macos:work_board_banners_swift"],
    crate_root = "src/lib.rs",
    data = [
        "//tools/boss/app-macos:work_board_banners_swift",
        "@jj_test_tools//:jj",
    ] + glob(["src/**/*.rs"]),
    edition = "2024",
    env = {
        "BOSS_JJ_BIN": "$(rootpath @jj_test_tools//:jj)",
        "HOME": "/tmp",
        "RUST_TEST_NOCAPTURE": "1",
        "TESTBRIDGE_TEST_ONLY": "scale",
    },
    proc_macro_deps = ["//tools/boss/engine/work-db-boundary:work_db_boundary"] + all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"BOSS_WORK_BOARD_BANNERS_SWIFT": "$(execpath //tools/boss/app-macos:work_board_banners_swift)"},
    rustc_flags = ["--cfg=boss_scale_tests"],
    tags = ["cpu:4"],
    deps = WORK_DB_TEST_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

