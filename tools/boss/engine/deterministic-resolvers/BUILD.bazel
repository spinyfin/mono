load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "deterministic-resolvers",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_deterministic_resolvers",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = [
        "//tools/boss/command-runner",
        "//tools/boss/engine/conflict-diagnosis",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "deterministic-resolvers_test",
    size = "small",
    crate = ":deterministic-resolvers",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/command-runner",
        "//tools/boss/engine/conflict-diagnosis",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Offline entry point for the conflict replay under
# //tools/boss/scripts/conflict-replay: runs the keep-both resolver on one
# recorded conflict. Not shipped with the engine.
rust_binary(
    name = "keep_both_replay",
    srcs = ["examples/keep_both_replay.rs"],
    edition = "2024",
    deps = [":deterministic-resolvers"],
)
