load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/boss/engine/core:codex_cli_version.bzl", "CODEX_CLI_VERSION")
load("//tools/boss/engine/core:engine_binary.bzl", "ENGINE_BINARY_BAZEL_RUN_COMMAND")

exports_files(["Cargo.toml"])

rust_library(
    name = "driver",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/grok/testdata/**"]) + ["src/codex-tmux.conf"],
    crate_name = "boss_engine_driver",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {
        # Canonical `bazel run` command for the engine target, sourced from
        # engine_binary.bzl so the PreToolUse guard advice text embedded in
        # BOSS_LAUNCH_GUARD_COMMAND can't drift from the real target label
        # the way the pre-crate-split `//tools/boss/engine:engine` string did.
        "BOSS_ENGINE_BAZEL_RUN_COMMAND": ENGINE_BINARY_BAZEL_RUN_COMMAND,
    },
    visibility = [
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/effort:__pkg__",
        "//tools/boss/engine/stdout-progress:__pkg__",
    ],
    deps = [
        "//tools/boss/codex_auth",
        "//tools/boss/engine/codex-hook-trust",
        "//tools/boss/engine/codex-rollout",
        "//tools/boss/engine/ssh-transport",
        "//tools/boss/engine/structured-output",
        "//tools/boss/engine/transient-error",
        "//tools/boss/engine/utils",
        "//tools/boss/log-files",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "driver_test",
    size = "small",
    compile_data = glob(["src/grok/testdata/**"]) + ["src/codex-tmux.conf"],
    crate = ":driver",
    data = [":codex_test_binary"],
    edition = "2024",
    env = {"BOSS_TEST_CODEX": "$(rootpath :codex_test_binary)"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {
        # Same source of truth as the codex_test_* repos :codex_test_binary
        # selects from (see codex_test_archives.bzl), so the assertion in
        # config_compatibility_tests.rs can never drift from the pinned
        # release the test binaries were fetched from.
        "CODEX_CLI_VERSION": CODEX_CLI_VERSION,
    },
    deps = [
        "//tools/boss/codex_auth",
        "//tools/boss/engine/codex-hook-trust",
        "//tools/boss/engine/codex-rollout",
        "//tools/boss/engine/pr-review",
        "//tools/boss/engine/ssh-transport",
        "//tools/boss/engine/structured-output",
        "//tools/boss/engine/transient-error",
        "//tools/boss/engine/utils",
        "//tools/boss/protocol",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Only the driver compatibility test consumes these release binaries.
config_setting(
    name = "aarch64_macos",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "x86_64_macos",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "x86_64_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "codex_test_binary",
    srcs = select({
        ":aarch64_macos": ["@codex_test_aarch64_macos//:codex"],
        ":x86_64_macos": ["@codex_test_x86_64_macos//:codex"],
        ":x86_64_linux": ["@codex_test_x86_64_linux//:codex"],
        ":aarch64_linux": ["@codex_test_aarch64_linux//:codex"],
    }),
)
