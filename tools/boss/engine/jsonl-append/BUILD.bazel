load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "jsonl-append",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_jsonl_append",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = [
        "//tools/boss/engine/dispatch-events:__pkg__",
    ],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "jsonl-append_test",
    size = "small",
    crate = ":jsonl-append",
    edition = "2024",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
