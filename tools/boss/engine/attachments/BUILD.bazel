load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "attachments",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_attachments",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/bossctl:__pkg__",
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = all_crate_deps(normal = True) + ["//tools/boss/protocol"],
)

rust_test(
    name = "attachments_test",
    size = "small",
    crate = ":attachments",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + ["//tools/boss/protocol"],
)
