load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Production hub stream service: WorkDb-backed journals, enrollment, and the
# authenticated listener. engine/core binds this at startup from config;
# dispatch does not route through it.
rust_library(
    name = "spoke-hub",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_spoke_hub",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/app:__pkg__",
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/host-enrollment",
        "//tools/boss/engine/spoke-stream",
        "//tools/boss/engine/work-db",
        "//tools/boss/protocol-spoke",
    ] + all_crate_deps(normal = True),
)

# Same sources against the work-db test fixture so engine_lib_test / app_test
# can pass their swapped WorkDb into HubStream.
rust_library(
    name = "spoke_hub_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
    },
    crate_name = "boss_spoke_hub",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/app:__pkg__",
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/host-enrollment",
        "//tools/boss/engine/spoke-stream",
        "//tools/boss/engine/work-db:work_db_test_support",
        "//tools/boss/protocol-spoke",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "integration_test",
    size = "medium",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        ":spoke-hub",
        "//tools/boss/engine/host-enrollment",
        "//tools/boss/engine/spoke-stream",
        "//tools/boss/engine/work-db",
        "//tools/boss/protocol-spoke",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
