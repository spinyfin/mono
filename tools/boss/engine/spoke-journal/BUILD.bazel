load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "spoke-journal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_spoke_journal",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/spoke:__pkg__",
        "//tools/boss/engine/spoke-stream:__pkg__",
    ],
    deps = ["//tools/boss/protocol-spoke"] + all_crate_deps(normal = True),
)

rust_test(
    name = "spoke-journal_test",
    size = "small",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/journal.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        ":spoke-journal",
        "//tools/boss/protocol-spoke",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
