load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "execution-contracts",
    srcs = ["src/lib.rs"],
    crate_name = "boss_execution_contracts",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/execution-runner:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/effort",
        "//tools/boss/engine/host-execution",
        "//tools/boss/engine/recovery",
        "//tools/boss/engine/storage-values",
        "//tools/boss/engine/structured-output",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_library(
    name = "execution_contracts_test_support",
    testonly = True,
    srcs = ["src/lib.rs"],
    crate_features = ["test-support"],
    crate_name = "boss_execution_contracts",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/execution-runner:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/effort",
        "//tools/boss/engine/host-execution",
        "//tools/boss/engine/recovery",
        "//tools/boss/engine/storage-values",
        "//tools/boss/engine/structured-output",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "execution_contracts_test",
    size = "small",
    crate = ":execution-contracts",
    edition = "2024",
)
