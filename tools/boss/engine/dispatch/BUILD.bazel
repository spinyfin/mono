load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Deliberately no runner, completion or engine-runtime dependency: those reach
# the coordinator only through the `execution-contracts` interfaces.
DISPATCH_DEPS = [
    "//tools/boss/engine/conflict-diagnosis",
    "//tools/boss/engine/dispatch-events",
    "//tools/boss/engine/effort",
    "//tools/boss/engine/event-bus",
    "//tools/boss/engine/execution-contracts",
    "//tools/boss/engine/host-execution",
    "//tools/boss/engine/metrics",
    "//tools/boss/engine/recovery",
    "//tools/boss/engine/storage-values",
    "//tools/boss/engine/task-scope",
    "//tools/boss/engine/utils",
    "//tools/boss/engine/work-db",
    "//tools/boss/github",
    "//tools/boss/protocol",
]

rust_library(
    name = "dispatch",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_dispatch",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/core:__pkg__"],
    deps = DISPATCH_DEPS + all_crate_deps(normal = True),
)

# The engine's test build compiles against fixture variants of the storage and
# contract crates, so the coordinator it drives must be built against the same
# variants for their types to unify.
rust_library(
    name = "dispatch_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//tools/boss/engine/execution-contracts:execution_contracts_test_support": "boss_execution_contracts",
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
    },
    crate_features = ["test-support"],
    crate_name = "boss_engine_dispatch_test_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/core:__pkg__"],
    deps = [d for d in DISPATCH_DEPS if d not in [
        "//tools/boss/engine/execution-contracts",
        "//tools/boss/engine/work-db",
    ]] + [
        "//tools/boss/engine/execution-contracts:execution_contracts_test_support",
        "//tools/boss/engine/work-db:work_db_test_support",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "dispatch_test",
    size = "small",
    timeout = "moderate",
    aliases = {
        "//tools/boss/engine/work-db": "boss_work_db_production",
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
    },
    crate = ":dispatch",
    edition = "2024",
    env = {"HOME": "/tmp"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/engine/work-db:work_db_test_support",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
