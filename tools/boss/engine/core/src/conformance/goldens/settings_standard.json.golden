          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\nimport json,os,sys,re,shlex\ndef review_guide_masked_command(command):\n    if not isinstance(command,str):\n        return None\n    q=chr(39)\n    dq=chr(34)\n    dl=chr(36)\n    bs=chr(92)\n    literal=q+'(?:[^'+q+']|'+q+dq+q+dq+q+'|'+q+bs+bs+q+q+')*'+q\n    match=re.fullmatch(r'([\\s\\S]*?)[ \\t]+--body[ \\t]+('+literal+r')[ \\t\\r\\n]*',command)\n    if not match:\n        return None\n    prefix=match.group(1)\n    prefixes=(dq+dl+'BOSS_BIN'+dq+' propose review-guide',dq+dl+'{BOSS_BIN}'+dq+' propose review-guide')\n    if prefix not in prefixes:\n        return None\n    return prefix+' --body '+q+'literal'+q\ndef _emit(d):\n    print(json.dumps(d))\n    sys.exit(0)\ndef _approve():\n    _emit({'decision':'approve'})\ndef _block(msg):\n    _emit({'decision':'block','reason':msg})\n_SHAPE=('Blocked (fail-closed): a Boss PreToolUse guard could not read this tool call as a shell command, so it cannot prove the call is allowed. Guards deny what they cannot parse rather than approving by default. Re-issue the work as an ordinary shell command, and report this payload shape to the operator -- it means Boss guard wiring needs updating for this agent driver. Detail: ')\ntry:\n    inp=json.load(sys.stdin)\nexcept Exception as _e:\n    _block(_SHAPE+'hook stdin was not JSON ('+str(_e)+')')\nif not isinstance(inp,dict):\n    _block(_SHAPE+'hook payload was not a JSON object')\n_ti=inp.get('tool_input')\nif not isinstance(_ti,dict):\n    _block(_SHAPE+'tool_input was '+type(_ti).__name__+', not an object')\ncmd=_ti.get('command')\nif not isinstance(cmd,str):\n    _block(_SHAPE+'tool_input.command was '+type(cmd).__name__+', not a string')\n_masked=review_guide_masked_command(cmd)\nif _masked is not None:\n    cmd=_masked\n\nDELIMS = {'&&', '||', ';', '|', '&'}\nWRAPPERS = {'env', 'command', 'builtin', 'exec', 'nohup', 'stdbuf', 'setsid', 'caffeinate', 'sudo', 'time', 'xargs', 'nice', 'ionice', 'chronic'}\nASSIGNMENT_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*=')\n\nSHLEX_WS = ' \\t\\r\\n'\n\ndef skip_arithmetic(line, index):\n    # Double-paren and dollar-bracket arithmetic hold shifts, not redirections. Returns the index after the construct, or None if unclosed.\n    if line.startswith(chr(36) + '[', index):\n        depth, end = 1, index + 2\n        opener, closer = '[', ']'\n    else:\n        depth, end = 2, index + 2\n        opener, closer = '(', ')'\n    while end < len(line) and depth:\n        if line[end] == opener:\n            depth += 1\n        elif line[end] == closer:\n            depth -= 1\n        end += 1\n    return None if depth else end\n\n\nANSI = 'ansi'\n\n\ndef is_ansi_open(text, index, quote):\n    return quote is None and text.startswith(chr(36) + chr(39), index)\n\n\ndef heredoc_word(rest):\n    # Read the whole delimiter word, applying bash quote removal. Any quote or\n    # backslash anywhere in it makes the body non-expanding. False means the\n    # syntax cannot be parsed safely.\n    word, quoted, index = [], False, 0\n    while index < len(rest):\n        char = rest[index]\n        if char in SHLEX_WS or char in ';&|()<>':\n            break\n        if char == chr(92):\n            if index + 1 >= len(rest):\n                return False\n            word.append(rest[index + 1])\n            quoted, index = True, index + 2\n            continue\n        if char == '$' and rest[index + 1:index + 2] in (chr(39), chr(34)):\n            return False\n        if char in (chr(39), chr(34)):\n            quoted = True\n            index += 1\n            while index < len(rest) and rest[index] != char:\n                if char == chr(34) and rest[index] == chr(92) and rest[index + 1:index + 2] in ('$', chr(96), chr(34), chr(92)):\n                    index += 1\n                word.append(rest[index])\n                index += 1\n            if index >= len(rest):\n                return False\n            index += 1\n            continue\n        word.append(char)\n        index += 1\n    return (''.join(word), quoted) if word else False\n\n\ndef heredoc_delim(line):\n    # Unquoted << only. A quoted substring is an argument, not an operator.\n    quote, escaped, index = None, False, 0\n    while index < len(line):\n        char = line[index]\n        if escaped:\n            escaped, index = False, index + 1\n            continue\n        if quote == ANSI:\n            if char == chr(92):\n                escaped, index = True, index + 1\n                continue\n            if char == chr(39):\n                quote = None\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92):\n            escaped, index = True, index + 1\n            continue\n        if quote:\n            if char == quote:\n                quote = None\n            index += 1\n            continue\n        if is_ansi_open(line, index, quote):\n            quote = ANSI\n            index += 2\n            continue\n        if char in (chr(39), chr(34)):\n            quote = char\n            index += 1\n            continue\n        if line.startswith(chr(36) + '[', index) or line.startswith('((', index):\n            index = skip_arithmetic(line, index)\n            if index is None:\n                return False\n            continue\n        if char == '<' and index + 1 < len(line) and line[index + 1] == '<':\n            rest = line[index + 2:]\n            if rest.startswith('<'):\n                return None\n            if rest.startswith('-'):\n                rest = rest[1:]\n            rest = rest.lstrip(SHLEX_WS)\n            return heredoc_word(rest)\n        index += 1\n    return None\n\nclass CommandGroup(list):\n    def __init__(self, tokens, body='', boundary=None, error=None, literal_chars=None, quote_segments=None):\n        super().__init__(tokens)\n        self.body = body\n        self.body_span = None\n        self.literal_chars = literal_chars or [[] for _ in tokens]\n        # Parallel to literal_chars: integer ids of the quote/escape run each\n        # character came from. None means provenance did not match shlex, so\n        # unbraced expansions cannot be verified.\n        self.quote_segments = quote_segments\n        self.expanding_body = False\n        self.boundary = boundary\n        self.error = error\n\n\ndef split_punct_word(word, mask, segs):\n    if word and all(c in '();&|' for c in word):\n        parts, masks, part_segs, offset = [], [], [], 0\n        for part in re.findall(r'[()]|[;&|]+', word):\n            parts.append(part)\n            masks.append(mask[offset:offset + len(part)])\n            part_segs.append(segs[offset:offset + len(part)])\n            offset += len(part)\n        return parts, masks, part_segs\n    return [word], [mask], [segs]\n\n\ndef quote_provenance(text, tokens):\n    # Mirror shlex boundaries while retaining each literal character and the\n    # quote/escape run it came from. Adjacent quoted strings concatenate into\n    # one shlex word (\"$A\"\"B\" -> $AB) but must not share a segment id.\n    words, masks, segs, word, mask, segm = [], [], [], [], [], []\n    quote, index, active, segment = None, 0, False, 0\n    def new_segment():\n        nonlocal segment\n        segment += 1\n    def finish():\n        nonlocal word, mask, segm, active\n        if active:\n            parts, part_masks, part_segs = split_punct_word(''.join(word), mask, segm)\n            words.extend(parts)\n            masks.extend(part_masks)\n            segs.extend(part_segs)\n        word, mask, segm, active = [], [], [], False\n    while index < len(text):\n        char = text[index]\n        if quote == ANSI:\n            if char == chr(92) and index + 1 < len(text):\n                word.append(text[index + 1])\n                mask.append(True)\n                segm.append(segment)\n                active = True\n                index += 2\n                continue\n            if char == chr(39):\n                quote = None\n                new_segment()\n                index += 1\n                continue\n            word.append(char)\n            mask.append(True)\n            segm.append(segment)\n            active = True\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92) and index + 1 < len(text):\n            following = text[index + 1]\n            if quote != chr(34) or following in (chr(34), chr(92)):\n                new_segment()\n                word.append(following)\n                mask.append(True)\n                segm.append(segment)\n                new_segment()\n                active = True\n                index += 2\n                continue\n        if char == quote:\n            quote = None\n            new_segment()\n        elif is_ansi_open(text, index, quote):\n            # The $ of $'...' is not an expansion. Keep it as its own run so\n            # it cannot join the ANSI body into a trusted name.\n            new_segment()\n            word.append(char)\n            mask.append(False)\n            segm.append(segment)\n            new_segment()\n            quote = ANSI\n            active = True\n            index += 2\n            continue\n        elif quote is None and char in (chr(39), chr(34)):\n            quote = char\n            new_segment()\n            active = True\n        elif quote is None and char in SHLEX_WS:\n            finish()\n        elif quote is None and char in ';&|()':\n            finish()\n            end = index + 1\n            while end < len(text) and text[end] in ';&|()':\n                end += 1\n            for part in re.findall(r'[()]|[;&|]+', text[index:end]):\n                words.append(part)\n                masks.append([False] * len(part))\n                segs.append([segment] * len(part))\n            index = end\n            continue\n        else:\n            word.append(char)\n            if quote == chr(39) or char == chr(2):\n                mask.append(True)\n            elif quote == chr(34):\n                mask.append('d')\n            else:\n                mask.append(False)\n            segm.append(segment)\n            active = True\n        index += 1\n    finish()\n    restored = []\n    for position, word in enumerate(words):\n        for marker, value in [('__GUARD_FD_AMP__', '&'), ('__GUARD_REDIRECT_PIPE__', '|'), (chr(2), '$')]:\n            while marker in word:\n                start = word.index(marker)\n                masks[position][start:start + len(marker)] = [masks[position][start]]\n                segs[position][start:start + len(marker)] = [segs[position][start]]\n                word = word[:start] + value + word[start + len(marker):]\n        restored.append(word)\n    if restored != tokens:\n        return [[False] * len(token) for token in tokens], None\n    return masks, segs\n\n\ndef open_quote(text):\n    # The quote left open after lexing text, mirroring shlex posix quoting.\n    quote, index = None, 0\n    while index < len(text):\n        char = text[index]\n        if quote == ANSI:\n            if char == chr(92):\n                index += 2\n                continue\n            if char == chr(39):\n                quote = None\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92):\n            index += 2\n            continue\n        if quote:\n            if char == quote:\n                quote = None\n        elif is_ansi_open(text, index, quote):\n            quote = ANSI\n            index += 2\n            continue\n        elif char in (chr(39), chr(34)):\n            quote = char\n        index += 1\n    return quote\n\n\ndef ansi_escapes_quote(text):\n    # True when an unquoted $'...' string holds an escaped quote. Bash pairs\n    # that quote inside the string while shlex closes the string there, so the\n    # words shlex reports are not the words bash runs.\n    quote, index = None, 0\n    while index < len(text):\n        char = text[index]\n        if quote == ANSI:\n            if char == chr(92):\n                if text[index + 1:index + 2] == chr(39):\n                    return True\n                index += 2\n                continue\n            if char == chr(39):\n                quote = None\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92):\n            index += 2\n            continue\n        if quote:\n            if char == quote:\n                quote = None\n        elif is_ansi_open(text, index, quote):\n            quote = ANSI\n            index += 2\n            continue\n        elif char in (chr(39), chr(34)):\n            quote = char\n        index += 1\n    return False\n\n\ndef odd_trailing_backslashes(text):\n    return (len(text) - len(text.rstrip(chr(92)))) % 2 == 1\n\n\ndef strip_line_continuations(text):\n    # Remove backslash-newline only where the shell does: not inside comments,\n    # single quotes or non-expanding heredoc bodies.\n    lines = text.split(chr(10))\n    out, current, pending, carry = [], '', '', ''\n    heredoc_end, expanding = None, False\n    for number, line in enumerate(lines):\n        last = number == len(lines) - 1\n        if heredoc_end is not None:\n            joined = carry + line\n            if expanding and not last and odd_trailing_backslashes(joined):\n                carry = joined[:-1]\n                continue\n            carry = ''\n            out.append(joined)\n            if joined.lstrip(chr(9)) == heredoc_end:\n                heredoc_end = None\n            continue\n        shaped = shell_text(pending + line + chr(10))\n        body = shaped[:-1]\n        if not last and odd_trailing_backslashes(body) and open_quote(body[:-1]) != chr(39):\n            pending = body[:-1]\n            current += line[:-1]\n            continue\n        out.append(current + line)\n        current = ''\n        if open_quote(shaped):\n            pending = shaped\n            continue\n        pending = ''\n        delim = heredoc_delim(shaped)\n        if delim:\n            heredoc_end, expanding = delim[0], not delim[1]\n    return chr(10).join(out + ([current] if current else []))\n\n\ndef shell_text(text):\n    # Comments cannot open quotes. Protect fd redirections from punctuation\n    # splitting, while preserving quoted data exactly.\n    out, quote, escaped, comment, index = [], None, False, False, 0\n    while index < len(text):\n        char = text[index]\n        if comment:\n            if char == chr(10):\n                comment = False\n                out.append(char)\n            index += 1\n            continue\n        if escaped:\n            # shlex preserves these escapes inside double quotes, while the\n            # shell consumes them before executing an extracted -c body.\n            if quote == chr(34) and char in (chr(36), chr(96)):\n                out.pop()\n                if char == chr(36):\n                    char = chr(2)\n            out.append(char)\n            escaped = False\n            index += 1\n            continue\n        if char == chr(92) and quote != chr(39):\n            escaped = True\n        elif quote == ANSI:\n            if char == chr(39):\n                quote = None\n        elif quote:\n            if char == quote:\n                quote = None\n        elif is_ansi_open(text, index, quote):\n            quote = ANSI\n            out.append(char)\n            out.append(text[index + 1])\n            index += 2\n            continue\n        elif char in (chr(39), chr(34)):\n            quote = char\n        elif char == '#' and (index == 0 or text[index - 1].isspace() or text[index - 1] in ';|&()<>'):\n            comment = True\n            index += 1\n            continue\n        elif char == '&':\n            before = text[index - 1:index]\n            after = text[index + 1:index + 2]\n            if before in ('>', '<') or after == '>':\n                char = '__GUARD_FD_AMP__'\n            elif before == '|':\n                index += 1\n                continue\n        elif char == '|' and text[index - 1:index] == '>':\n            char = '__GUARD_REDIRECT_PIPE__'\n        out.append(char)\n        index += 1\n    return ''.join(out)\n\n\ndef command_records(command, stripped=False):\n    groups = []\n    pending = ''\n    receiver = None\n    heredoc_end = None\n    if not stripped:\n        command = strip_line_continuations(command)\n    offset = 0\n    for line in command.split(chr(10)):\n        line_start = offset\n        offset += len(line) + 1\n        if heredoc_end is not None:\n            if line.lstrip(chr(9)) == heredoc_end:\n                heredoc_end = None\n            else:\n                receiver.body += line + chr(10)\n                start = receiver.body_span[0] if receiver.body_span else line_start\n                receiver.body_span = (start, min(offset, len(command)))\n            continue\n        pending = shell_text(pending + line + chr(10))\n        if ansi_escapes_quote(pending):\n            groups.append(CommandGroup([], error='incomplete shell syntax'))\n            pending = ''\n            continue\n        try:\n            lexer = shlex.shlex(pending, posix=True, punctuation_chars=';&|()')\n            lexer.whitespace_split = True\n            lexer.commenters = ''\n            tokens = [token.replace('__GUARD_FD_AMP__', '&').replace('__GUARD_REDIRECT_PIPE__', '|').replace(chr(2), '$') for token in lexer]\n        except ValueError:\n            # A quote can span physical lines. If our tracker says every quote\n            # is closed, shlex failed on a construct it does not model (ANSI-C\n            # escaped quotes). Keep later lines visible instead of swallowing\n            # them as continuation of an opener shlex invented.\n            if open_quote(pending):\n                continue\n            groups.append(CommandGroup([], error='incomplete shell syntax'))\n            pending = ''\n            continue\n        logical_line = pending\n        pending = ''\n        current = []\n        tokens = [part for token in tokens for part in (re.findall(r'[()]|[;&|]+', token) if token and all(c in '();&|' for c in token) else [token])]\n        try:\n            literal, segments = quote_provenance(logical_line, tokens)\n        except Exception:\n            literal = [[False] * len(token) for token in tokens]\n            segments = None\n        if literal is None or len(literal) != len(tokens):\n            literal = [[False] * len(token) for token in tokens]\n            segments = None\n        elif segments is not None and len(segments) != len(tokens):\n            segments = None\n        current_literal = []\n        current_segments = [] if segments is not None else None\n        for index, token in enumerate(tokens):\n            if token in DELIMS or (token and all(c in '()' for c in token)):\n                if current:\n                    groups.append(CommandGroup(current, literal_chars=current_literal, quote_segments=current_segments))\n                current = []\n                current_literal = []\n                current_segments = [] if segments is not None else None\n                groups.append(CommandGroup([], boundary=token))\n            else:\n                current.append(token)\n                current_literal.append(literal[index])\n                if current_segments is not None:\n                    current_segments.append(segments[index])\n        if current:\n            groups.append(CommandGroup(current, literal_chars=current_literal, quote_segments=current_segments))\n        delim = heredoc_delim(logical_line)\n        if delim is False:\n            groups.append(CommandGroup([], error='incomplete shell syntax'))\n        elif delim and groups:\n            heredoc_end, quoted = delim\n            receiver = groups[-1]\n            receiver.expanding_body = not quoted\n        if tokens and tokens[-1] not in ('&&', '||', '|'):\n            groups.append(CommandGroup([], boundary=';'))\n    if pending or heredoc_end:\n        groups.append(CommandGroup([], error='incomplete shell syntax'))\n    return groups\n\n\ndef command_groups(command):\n    records = command_records(command)\n    if any(group.error for group in records):\n        # Keep every physical command visible to denylists after a lex error.\n        return [part.split() for line in shell_text(command).splitlines()\n                for part in re.split(r'[;&|()]', line) if part.split()]\n    return [group for group in records if group]\n\ndef without_redirection_indices(group):\n    result = []\n    index = 0\n    while index < len(group):\n        token = group[index]\n        redirect = re.match(r'^(?:[0-9]+|&)?(?:>\\||>>?|<>|<<-?|<)(.*)$', token)\n        if redirect:\n            if redirect.group(1) in ('', '&'):\n                index += 1\n        else:\n            result.append(index)\n        index += 1\n    return result\n\ndef without_redirections(group):\n    return [group[i] for i in without_redirection_indices(group)]\n\nWRAPPER_VALUE_OPTIONS = {\n    'env': {'-u', '--unset', '-C', '--chdir'},\n    'sudo': {'-u', '--user', '-g', '--group', '-h', '--host', '-p', '--prompt'},\n    'nice': {'-n', '--adjustment'},\n    'ionice': {'-c', '--class', '-n', '--classdata', '-p', '--pid'},\n    'stdbuf': {'-i', '-o', '-e', '--input', '--output', '--error'},\n    'timeout': {'-k', '--kill-after', '-s', '--signal'},\n    'xargs': {'-n', '-L', '-P', '-I', '-d', '--max-args', '--max-lines', '--max-procs', '--replace', '--delimiter'},\n}\n\ndef strip_prefix_offset(group):\n    index = 0\n    while index < len(group):\n        token = group[index]\n        base = os.path.basename(token)\n        if ASSIGNMENT_RE.match(token):\n            index += 1\n            continue\n        if base in WRAPPERS or base == 'timeout':\n            index += 1\n            value_options = WRAPPER_VALUE_OPTIONS.get(base, set())\n            while index < len(group) and group[index].startswith('-'):\n                option = group[index]\n                index += 1\n                if base == 'command' and option in ('-v', '-V'):\n                    return len(group)\n                if option == '--':\n                    break\n                if option in value_options and index < len(group):\n                    index += 1\n            if base == 'timeout' and index < len(group):\n                index += 1\n            continue\n        break\n    return index\n\ndef strip_prefixes(group):\n    stripped = without_redirections(group)\n    return stripped[strip_prefix_offset(stripped):]\n\ndef strip_prefix_indices(group):\n    kept = without_redirection_indices(group)\n    start = strip_prefix_offset([group[i] for i in kept])\n    return kept[start:]\n# Embedded in the always-on launch guard for every driver. Reuse its shell\n# tokenizer; this fragment must contain no shell double quotes, backticks,\n# dollars or backslashes because the enclosing command uses double quotes.\nSIGNAL_REASON = ('Blocked unsafe process signalling: pkill/killall select processes by '\n                 'name or pattern, and kill with indirect PIDs, process groups or broad '\n                 'targets can terminate other workers. Stop only processes you started '\n                 'yourself using explicit positive numeric PIDs (for example, the PID '\n                 'captured from ' + chr(36) + '! when starting your process), or wait '\n                 'for or time out your own command.')\n\nSIG_NL, SIG_TAB, SIG_SQ, SIG_DQ = chr(10), chr(9), chr(39), chr(34)\nSIG_BT, SIG_BS, SIG_DOLLAR = chr(96), chr(92), chr(36)\nSIG_BANG = (SIG_DOLLAR + '!', SIG_DOLLAR + '{!}')\nSIG_BLANKS = ' ' + SIG_TAB + SIG_NL + chr(13) + ';&|('\nSIG_IDENT = re.compile('[A-Za-z_][A-Za-z0-9_]*')\nSIG_ASSIGN = re.compile('^([A-Za-z_][A-Za-z0-9_]*)([+]?)=(.*)', re.S)\nSIG_NAME = re.compile('(?<![A-Za-z_])(pkill|killall)(?![A-Za-z_])')\nSIG_HOLDER = re.compile('__indirect_pid_([0-9]+)__')\nSIG_VARIABLE = re.compile(re.escape(SIG_DOLLAR) + '(?:[{]([A-Za-z_][A-Za-z0-9_]*)[}]|([A-Za-z_][A-Za-z0-9_]*))')\nSIG_PARAM = re.compile(re.escape(SIG_DOLLAR) + '[{]([A-Za-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_}])')\nSIG_ARITH_SET = re.compile('([A-Za-z_][A-Za-z0-9_]*)[ ]*(?:[-+*/%&|^]|<<|>>)?=(?!=)')\nSIG_ARITH_STEP = re.compile('([A-Za-z_][A-Za-z0-9_]*)[ ]*(?:[+][+]|--)|(?:[+][+]|--)[ ]*([A-Za-z_][A-Za-z0-9_]*)')\nSIG_WORD_STEP = re.compile('([A-Za-z_][A-Za-z0-9_]*)(?:[+][+]|--)|[+][+]([A-Za-z_][A-Za-z0-9_]*)')\nSIG_SHELLS = ('bash', 'sh', 'zsh', 'dash', 'ksh')\nSIG_DECLARERS = ('export', 'declare', 'typeset', 'local', 'readonly')\nSIG_BINDERS = ('read', 'mapfile', 'readarray', 'getopts', 'for', 'select', 'unset', 'wait')\nSIG_EVALUATORS = ('let', 'eval', 'source', '.')\nSIG_KEYWORDS = ('!', '{', '}', 'then', 'do', 'if', 'elif', 'while', 'until', 'else')\nSIG_LAUNCHERS = ('timeout', 'builtin', 'busybox', 'nice', 'ionice', 'doas',\n                 'flock', 'chrt', 'taskset', 'script')\nSIG_POSITIONAL = {'timeout': 1, 'flock': 1, 'chrt': 1, 'taskset': 1, 'script': 1}\n\ndef signal_ansi(text):\n    # Decode the body of an ANSI-C quoted word so that its spelling cannot hide a name.\n    simple = {'n': SIG_NL, 't': SIG_TAB, 'r': chr(13), 'a': chr(7), 'b': chr(8), 'e': chr(27),\n              'E': chr(27), 'f': chr(12), 'v': chr(11), SIG_BS: SIG_BS, SIG_SQ: SIG_SQ,\n              SIG_DQ: SIG_DQ, '?': '?'}\n    widths = {'x': 2, 'u': 4, 'U': 8}\n    out, i = [], 0\n    while i < len(text):\n        c = text[i]\n        if c != SIG_BS or i + 1 >= len(text):\n            out.append(c)\n            i += 1\n            continue\n        d = text[i+1]\n        if d in simple:\n            out.append(simple[d])\n            i += 2\n        elif d in widths:\n            digits = re.match('[0-9a-fA-F]*', text[i+2:i+2+widths[d]]).group()\n            if digits:\n                out.append(chr(int(digits, 16)))\n            else:\n                out.append(c + d)\n            i += 2 + len(digits)\n        elif d in '01234567':\n            digits = re.match('[0-7]{1,3}', text[i+1:]).group()\n            out.append(chr(int(digits, 8) % 256))\n            i += 1 + len(digits)\n        else:\n            out.append(c + d)\n            i += 2\n    return ''.join(out)\n\ndef signal_word_end(source, i):\n    # Read one shell word (a heredoc delimiter) starting at i. Returns the word with\n    # its quoting removed, whether any quoting was present, and the end offset.\n    n, value, quoted = len(source), [], False\n    while i < n and source[i] not in ' ;&|()<>' + SIG_TAB + SIG_NL + chr(13):\n        c = source[i]\n        if c == SIG_DOLLAR and i + 1 < n and source[i+1] in (SIG_SQ, SIG_DQ):\n            i += 1\n        elif c == SIG_BS:\n            quoted = True\n            if i + 1 < n:\n                value.append(source[i+1])\n            i += 2\n        elif c in (SIG_SQ, SIG_DQ):\n            end = source.find(c, i + 1)\n            if end < 0:\n                raise ValueError('unterminated quote in heredoc delimiter')\n            value.append(source[i+1:end])\n            quoted = True\n            i = end + 1\n        else:\n            value.append(c)\n            i += 1\n    return ''.join(value), quoted, i\n\ndef signal_leading(text):\n    # Bash reads a dollar-double-paren as arithmetic only when the inner paren that\n    # opens the text closes at its very end; anything else is a subshell command.\n    if not text.startswith('('):\n        return False\n    try:\n        return signal_scan(text, 1, ')', 'probe')['end'] == len(text) - 1\n    except ValueError:\n        return False\n\ndef signal_scan(source, start=0, stop=None, kind='command'):\n    # One quote-aware pass that separates executable substitutions from ordinary\n    # quoted arguments, drops comments and heredoc bodies, and keeps a nonnumeric\n    # placeholder at each call site so kill cannot accept their output.\n    # kind: command (everything), arith (quotes and substitutions),\n    # probe (quotes only) or literal (substitutions only, for heredoc bodies).\n    quotes, subs_on, command = kind != 'literal', kind != 'probe', kind == 'command'\n    n = len(source)\n    out, subs, holders, heredocs, ariths, scripts = [], [], [], [], [], set()\n    pending, quote, depth, found = [], None, 0, False\n    word_start, arith_until, i = True, 0, start\n    while i < n:\n        c = source[i]\n        if c == SIG_BS and quote != SIG_SQ:\n            if source[i+1:i+2] == SIG_NL:\n                i += 2\n                continue\n            out.append(source[i:i+2])\n            i += 2\n            word_start = False\n            continue\n        if command and quote is None and word_start and c == '#':\n            end = source.find(SIG_NL, i)\n            i = n if end < 0 else end\n            continue\n        if stop == SIG_BT and c == SIG_BT:\n            found = True\n            break\n        if stop == ')' and quote is None and c in '()':\n            if c == '(':\n                depth += 1\n            elif depth == 0:\n                found = True\n                break\n            else:\n                depth -= 1\n        if quotes and c in (SIG_SQ, SIG_DQ) and quote in (None, c):\n            quote = None if quote else c\n            out.append(c)\n            i += 1\n            word_start = False\n            continue\n        if quotes and quote is None and c == SIG_DOLLAR and source[i+1:i+2] == SIG_DQ:\n            i += 1\n            word_start = False\n            continue\n        if quotes and quote is None and c == SIG_DOLLAR and source[i+1:i+2] == SIG_SQ:\n            end = i + 2\n            while end < n and source[end] != SIG_SQ:\n                end += 2 if source[end] == SIG_BS else 1\n            if end >= n:\n                raise ValueError('unterminated ANSI-C quote')\n            decoded = signal_ansi(source[i+2:end]).replace(SIG_SQ, SIG_SQ + SIG_BS + SIG_SQ + SIG_SQ)\n            out.append(SIG_SQ + decoded + SIG_SQ)\n            i = end + 1\n            word_start = False\n            continue\n        if subs_on and quote != SIG_SQ and (c == SIG_BT or source.startswith(SIG_DOLLAR + '(', i)\n                or (quote is None and source.startswith('<(', i))):\n            if c == SIG_BT:\n                j = signal_scan(source, i + 1, SIG_BT)['end']\n                text = source[i+1:j]\n                subs.append(text)\n            else:\n                s, arithmetic = i + 2, False\n                if source.startswith('((', i + 1):\n                    j = signal_scan(source, s, ')', 'probe')['end']\n                    text = source[s:j]\n                    arithmetic = signal_leading(text)\n                if arithmetic:\n                    subs.extend(signal_scan(text, 0, None, 'arith')['subs'])\n                    ariths.append(text)\n                else:\n                    j = signal_scan(source, s, ')')['end']\n                    text = source[s:j]\n                    subs.append(text)\n            if source.startswith('<(', i):\n                scripts.add(len(holders))\n            holders.append(text)\n            out.append('__indirect_pid_' + str(len(holders) - 1) + '__')\n            i = j + 1\n            word_start = False\n            continue\n        if command and quote is None and word_start and i >= arith_until and source.startswith('((', i):\n            # An arithmetic command: record what it assigns, and keep its text\n            # visible while suspending heredoc detection for the shifts inside it.\n            try:\n                j = signal_scan(source, i + 2, ')', 'probe')['end']\n                if source[j+1:j+2] == ')':\n                    ariths.append(source[i+2:j])\n                    arith_until = j + 2\n            except ValueError:\n                pass\n        if command and quote is None and c == '<' and i >= arith_until and source.startswith('<<', i):\n            if source.startswith('<<<', i):\n                out.append('<<<')\n                i += 3\n                word_start = False\n                continue\n            j = i + 2\n            strip = j < n and source[j] == '-'\n            j += 1 if strip else 0\n            while j < n and source[j] in ' ' + SIG_TAB:\n                j += 1\n            delimiter, quoted, end = signal_word_end(source, j)\n            if not delimiter:\n                raise ValueError('unrecognised heredoc delimiter')\n            marker = '__signal_doc_' + str(len(heredocs) + len(pending)) + '__'\n            pending.append((delimiter, strip, quoted, marker))\n            out.append('<< ' + marker)\n            i = end\n            word_start = False\n            continue\n        if command and quote is None and c == SIG_NL:\n            out.append(SIG_NL)\n            i += 1\n            for delimiter, strip, quoted, marker in pending:\n                body = []\n                while True:\n                    if i >= n:\n                        raise ValueError('unterminated heredoc')\n                    end = source.find(SIG_NL, i)\n                    end = n if end < 0 else end\n                    line = source[i:end]\n                    i = end + 1\n                    if (line.lstrip(SIG_TAB) if strip else line) == delimiter:\n                        break\n                    body.append(line)\n                heredocs.append((marker, SIG_NL.join(body), quoted))\n            pending = []\n            word_start = True\n            continue\n        out.append(c)\n        i += 1\n        if quote is None:\n            word_start = c in SIG_BLANKS\n    if stop is not None and not found:\n        raise ValueError('unterminated command substitution')\n    if pending:\n        raise ValueError('unterminated heredoc')\n    return {'out': ''.join(out), 'subs': subs, 'holders': holders, 'heredocs': heredocs,\n            'ariths': ariths, 'scripts': scripts, 'end': i}\n\ndef signal_operand(words):\n    # Shell options may follow -c before its command operand.\n    i = 0\n    while i < len(words):\n        word = words[i]\n        if word == '--':\n            return words[i+1:i+2]\n        if word in ('-o', '+o', '-O', '+O', '--rcfile', '--init-file'):\n            i += 2\n        elif word[:1] in ('-', '+'):\n            i += 1\n        else:\n            return words[i:i+1]\n    return []\n\ndef signal_cstrings(words):\n    # Shell command strings handed to a launcher with -c or --command.\n    found = []\n    for i, word in enumerate(words):\n        if word.startswith('--command='):\n            found.append(word.split('=', 1)[1])\n        elif i + 1 < len(words) and (word == '--command' or (\n                word.startswith('-') and not word.startswith('--') and 'c' in word)):\n            found.extend(signal_operand(words[i+1:]))\n    return found\n\ndef signal_argv(group):\n    # Retain xargs provenance and consume wrapper options with operands before\n    # finding the program, extending the common tokenizer prefix handling.\n    # Redirections can precede the executable as well as follow its arguments.\n    # Returns the command words, whether xargs fed it, shell strings that a\n    # launcher will run, and the assignments seen in leading positions.\n    words, i = [], 0\n    redirects = ('<', '>', '>>', '<<', '<<<', '<>', '>&', '<&', '&>', '&>>', '>|')\n    while i < len(group):\n        if not words and group[i].isdigit() and i+1 < len(group) and group[i+1] in redirects:\n            i += 1\n        if group[i] in redirects:\n            i += 2\n        else:\n            words.append(group[i])\n            i += 1\n    group = words\n    indirect, strings, assigns = False, [], []\n    while group:\n        base = os.path.basename(group[0])\n        match = SIG_ASSIGN.match(group[0])\n        if match:\n            assigns.append((match.group(1), match.group(2) == '+', match.group(3)))\n            group = group[1:]\n            continue\n        if base in SIG_KEYWORDS:\n            group = group[1:]\n            continue\n        if base == 'coproc':\n            group = group[1:]\n            if len(group) > 1 and group[1] == '{':\n                group = group[1:]\n            continue\n        if base == 'function':\n            group = group[2:]\n            continue\n        if base == 'su':\n            return [], indirect, strings + signal_cstrings(group[1:]), assigns\n        if base == 'watch':\n            group = group[1:]\n            while group and group[0].startswith('-'):\n                group = group[2:] if group[0] in ('-n', '--interval') else group[1:]\n            return [], indirect, strings + [' '.join(group)], assigns\n        if base not in WRAPPERS and base not in SIG_LAUNCHERS:\n            break\n        indirect |= base == 'xargs'\n        group = group[1:]\n        if base in ('flock', 'script'):\n            strings.extend(signal_cstrings(group))\n        if base == 'command' and group and group[0] in ('-v', '-V'):\n            return [], indirect, strings, assigns\n        takes_value = {\n            'sudo': ('-u', '-g', '-h', '-p', '-C', '-T', '-R', '-D', '-r', '-t', '-U',\n                     '--user', '--group', '--host', '--prompt', '--chdir', '--chroot',\n                     '--role', '--type', '--other-user', '--close-from', '--command-timeout'),\n            'env': ('-u', '-C', '-a', '--unset', '--chdir', '--argv0'),\n            'exec': ('-a',),\n            'nice': ('-n', '--adjustment'),\n            'ionice': ('-c', '-n', '-p', '-P', '-u', '--class', '--classdata', '--pid', '--pgid', '--uid'),\n            'doas': ('-u', '-C'),\n            'xargs': ('-I', '-J', '-n', '-P', '-s', '-E', '-L', '-d', '--replace', '--max-args', '--max-procs'),\n            'timeout': ('-s', '-k', '--signal', '--kill-after'),\n            'caffeinate': ('-t', '-w'),\n            'stdbuf': ('-i', '-o', '-e'),\n            'flock': ('-w', '--timeout', '-E', '--conflict-exit-code', '-c', '--command'),\n            'chrt': ('-T', '-P', '-D'),\n            'taskset': ('-c', '--cpu-list'),\n            'script': ('-t', '-F', '-c', '--command', '-I', '-O', '-B', '-T', '-E', '-m',\n                       '--log-in', '--log-out', '--log-io', '--log-timing', '--timing',\n                       '--output-limit'),\n        }.get(base, ())\n        positional = SIG_POSITIONAL.get(base, 0)\n        while group and group[0].startswith('-'):\n            option = group[0]\n            if base == 'env' and option in ('-S', '--split-string'):\n                group = shlex.split(group[1]) + group[2:]\n                break\n            if base == 'env' and option.startswith('--split-string='):\n                group = shlex.split(option.split('=', 1)[1]) + group[1:]\n                break\n            if base == 'env' and option.startswith('-S'):\n                group = shlex.split(option[2:]) + group[1:]\n                break\n            if base == 'taskset' and (option == '-c' or option.startswith('--cpu-list')):\n                positional = 0\n            group = group[2:] if option in takes_value else group[1:]\n            if option == '--':\n                break\n        group = group[positional:]\n    return group, indirect, strings, assigns\n\ndef signal_kill(args, indirect, captures):\n    if args and args[0] in ('-l', '-L', '--list', '--table'):\n        return\n    if indirect or not args:\n        _block(SIGNAL_REASON)\n    if args[0] in ('-s', '-n', '--signal'):\n        args = args[2:]\n    elif args[0].startswith('--signal='):\n        args = args[1:]\n    elif args[0].startswith('-') and args[0] != '--':\n        # A lone negative argument (notably kill -1) is never an explicit PID.\n        args = args[1:]\n    if args and args[0] == '--':\n        args = args[1:]\n    # pid_t is signed 32-bit on worker hosts; prevent positive literals from\n    # wrapping into a process group or the all-processes sentinel.\n    def valid(pid):\n        if pid in SIG_BANG:\n            return True\n        if pid.startswith(SIG_DOLLAR) and pid[1:].strip('{}') in captures:\n            return True\n        return re.fullmatch('[0-9]+', pid) and 0 < int(pid) <= 2147483647\n    if not args or not all(valid(pid) for pid in args):\n        _block(SIGNAL_REASON)\n\ndef signal_shell(args):\n    return args and os.path.basename(args[0]) in SIG_SHELLS\n\ndef signal_stdin(args):\n    # A shell reads its commands from stdin unless given -c or a script file.\n    rest, i = args[1:], 0\n    if any(a.startswith('-') and not a.startswith('--') and 'c' in a for a in rest):\n        return False\n    while i < len(rest):\n        if rest[i] in ('-o', '+o', '-O', '+O', '--rcfile', '--init-file'):\n            i += 2\n        elif rest[i][:1] in ('-', '+'):\n            i += 1\n        else:\n            return rest[i] in ('/dev/stdin', '/dev/fd/0', '-') or any(\n                a.startswith('-') and not a.startswith('--') and 's' in a for a in rest)\n    return True\n\ndef signal_text(text, depth, values=None, unknown=None):\n    # Inspect text that a shell will later read. Text that cannot be parsed is\n    # still refused when it names the forbidden programs.\n    try:\n        signal_check(text, depth, values, unknown)\n    except ValueError:\n        if SIG_NAME.search(text):\n            _block(SIGNAL_REASON)\n\ndef signal_groups(source):\n    # Split into command groups like the shared tokenizer, but also report\n    # whether each group is fed by a pipe and which groups feed it.\n    lex = shlex.shlex(source, posix=True, punctuation_chars=';&|()<>' + SIG_NL)\n    lex.whitespace = ' ' + SIG_TAB + chr(13)\n    lex.whitespace_split = True\n    lex.commenters = ''\n    tokens = [p for t in lex for p in (re.split('([()])', t) if all(c in ';&|()<>' + SIG_NL for c in t) else [t]) if p]\n    groups, current, piped, pipeline = [], [], False, []\n    for token in tokens + [';']:\n        if token in DELIMS or all(c in ';&|()' + SIG_NL for c in token):\n            if current:\n                groups.append((current, piped, pipeline if piped else []))\n                pipeline = pipeline + [current] if piped else [current]\n                current, piped = [], False\n            if token in ('|', '|&'):\n                piped = True\n            elif token not in ('(', '{') and token.strip(SIG_NL):\n                piped = False\n        else:\n            current.append(token)\n    return groups\n\ndef signal_arith_names(text):\n    names = {m.group(1) for m in SIG_ARITH_SET.finditer(text)}\n    names.update(m.group(1) or m.group(2) for m in SIG_ARITH_STEP.finditer(text))\n    return names\n\ndef signal_writes(group, args):\n    # Names a command may rebind in the current shell, over-approximated.\n    names = set()\n    for k, word in enumerate(group):\n        names.update(m.group(1) for m in SIG_PARAM.finditer(word))\n        if SIG_IDENT.fullmatch(word) and k + 1 < len(group) and group[k+1].startswith(\n                ('=', '+=', '-=', '*=', '/=', '%=', '++', '--')):\n            names.add(word)\n        names.update(m.group(1) or m.group(2) for m in [SIG_WORD_STEP.fullmatch(word)] if m)\n    if args:\n        base, rest = os.path.basename(args[0]), args[1:]\n        if base in SIG_BINDERS:\n            names.update(w for w in rest if SIG_IDENT.fullmatch(w))\n        elif base == 'printf':\n            for k, word in enumerate(rest):\n                if word == '-v' and k + 1 < len(rest):\n                    names.add(rest[k+1])\n                elif word.startswith('-v') and len(word) > 2:\n                    names.add(word[2:])\n        elif base in SIG_EVALUATORS:\n            names.update(SIG_IDENT.findall(' '.join(rest)))\n    return names\n\ndef signal_check(source, depth=0, inherited=None, unknown=None):\n    if depth > 40:\n        _block(SIGNAL_REASON + ' Shell nesting is too deep to inspect safely.')\n    scan = signal_scan