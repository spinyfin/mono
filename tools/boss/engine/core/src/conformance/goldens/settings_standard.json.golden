{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Edit(/Users/brianduff/Library/Application Support/Boss)",
      "Edit(/Users/brianduff/Library/Application Support/Boss/**)",
      "Bash(bossctl)",
      "Bash(bossctl:*)",
      "Bash(boss engine start)",
      "Bash(boss engine start:*)",
      "Bash(boss engine stop)",
      "Bash(boss engine stop:*)",
      "Bash(\"$BOSS_BIN\" engine start)",
      "Bash(\"$BOSS_BIN\" engine start:*)",
      "Bash(\"$BOSS_BIN\" engine stop)",
      "Bash(\"$BOSS_BIN\" engine stop:*)",
      "Bash($BOSS_BIN engine start)",
      "Bash($BOSS_BIN engine start:*)",
      "Bash($BOSS_BIN engine stop)",
      "Bash($BOSS_BIN engine stop:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "BOSS_EVENTS_SOCKET='/Users/brianduff/Library/Application Support/Boss/events.sock' BOSS_LEASE_ID='lease-conformance-golden' BOSS_RUN_ID='run-conformance-golden' BOSS_WORKSPACE='/Users/brianduff/Documents/dev/workspaces/mono-agent-007' '/Users/brianduff/Library/Application Support/Boss/bin/boss-event'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "BOSS_EVENTS_SOCKET='/Users/brianduff/Library/Application Support/Boss/events.sock' BOSS_LEASE_ID='lease-conformance-golden' BOSS_RUN_ID='run-conformance-golden' BOSS_WORKSPACE='/Users/brianduff/Documents/dev/workspaces/mono-agent-007' '/Users/brianduff/Library/Application Support/Boss/bin/boss-event'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "BOSS_EVENTS_SOCKET='/Users/brianduff/Library/Application Support/Boss/events.sock' BOSS_LEASE_ID='lease-conformance-golden' BOSS_RUN_ID='run-conformance-golden' BOSS_WORKSPACE='/Users/brianduff/Documents/dev/workspaces/mono-agent-007' '/Users/brianduff/Library/Application Support/Boss/bin/boss-event'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "BOSS_DATA_DIR='/Users/brianduff/Library/Application Support/Boss' python3 '$TMPDIR/boss-worker-settings/path-guard-<sha256>/boss-path-guard.py'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "BOSS_WORKSPACE='/Users/brianduff/Documents/dev/workspaces/mono-agent-007' python3 '$TMPDIR/boss-worker-settings/git-store-guard-<sha256>/boss-git-store-guard.py'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\nimport json,os,sys,re,shlex\ndef review_guide_masked_command(command):\n    if not isinstance(command,str):\n        return None\n    q=chr(39)\n    dq=chr(34)\n    dl=chr(36)\n    bs=chr(92)\n    literal=q+'(?:[^'+q+']|'+q+dq+q+dq+q+'|'+q+bs+bs+q+q+')*'+q\n    match=re.fullmatch(r'([\\s\\S]*?)[ \\t]+--body[ \\t]+('+literal+r')[ \\t\\r\\n]*',command)\n    if not match:\n        return None\n    prefix=match.group(1)\n    prefixes=(dq+dl+'BOSS_BIN'+dq+' propose review-guide',dq+dl+'{BOSS_BIN}'+dq+' propose review-guide')\n    if prefix not in prefixes:\n        return None\n    return prefix+' --body '+q+'literal'+q\ndef _emit(d):\n    print(json.dumps(d))\n    sys.exit(0)\ndef _approve():\n    _emit({'decision':'approve'})\ndef _block(msg):\n    _emit({'decision':'block','reason':msg})\n_SHAPE=('Blocked (fail-closed): a Boss PreToolUse guard could not read this tool call as a shell command, so it cannot prove the call is allowed. Guards deny what they cannot parse rather than approving by default. Re-issue the work as an ordinary shell command, and report this payload shape to the operator -- it means Boss guard wiring needs updating for this agent driver. Detail: ')\ntry:\n    inp=json.load(sys.stdin)\nexcept Exception as _e:\n    _block(_SHAPE+'hook stdin was not JSON ('+str(_e)+')')\nif not isinstance(inp,dict):\n    _block(_SHAPE+'hook payload was not a JSON object')\n_ti=inp.get('tool_input')\nif not isinstance(_ti,dict):\n    _block(_SHAPE+'tool_input was '+type(_ti).__name__+', not an object')\ncmd=_ti.get('command')\nif not isinstance(cmd,str):\n    _block(_SHAPE+'tool_input.command was '+type(cmd).__name__+', not a string')\n_masked=review_guide_masked_command(cmd)\nif _masked is not None:\n    cmd=_masked\n\nDELIMS = {'&&', '||', ';', '|', '&'}\nWRAPPERS = {'env', 'command', 'exec', 'nohup', 'stdbuf', 'setsid', 'caffeinate', 'sudo', 'time', 'xargs', 'nice', 'ionice', 'chronic'}\nASSIGNMENT_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*=')\n\ndef heredoc_delim(line):\n    index = line.find('<<')\n    if index < 0:\n        return None\n    rest = line[index + 2:]\n    if rest.startswith('-'):\n        rest = rest[1:]\n    rest = rest.lstrip()\n    if not rest:\n        return None\n    quote = rest[0] if rest[0] in (chr(39), chr(34)) else None\n    if quote:\n        rest = rest[1:]\n    end = 0\n    while end < len(rest) and (rest[end].isalnum() or rest[end] == '_'):\n        end += 1\n    word = rest[:end]\n    if not word:\n        return None\n    if quote and (end == len(rest) or rest[end] != quote):\n        return None\n    return word, bool(quote)\n\nclass CommandGroup(list):\n    def __init__(self, tokens, body='', boundary=None, error=None):\n        super().__init__(tokens)\n        self.body = body\n        self.expanding_body = False\n        self.boundary = boundary\n        self.error = error\n\n\ndef shell_text(text):\n    # Comments cannot open quotes. Protect fd redirections from punctuation\n    # splitting, while preserving quoted data exactly.\n    out, quote, escaped, comment = [], None, False, False\n    for index, char in enumerate(text):\n        if comment:\n            if char != chr(10):\n                continue\n            comment = False\n        if escaped:\n            out.append(char)\n            escaped = False\n            continue\n        if char == chr(92) and quote != chr(39):\n            escaped = True\n        elif quote:\n            if char == quote:\n                quote = None\n        elif char in (chr(39), chr(34)):\n            quote = char\n        elif char == '#' and (index == 0 or text[index - 1].isspace() or text[index - 1] in ';|&()<>'):\n            comment = True\n            continue\n        elif char == '&':\n            before = text[index - 1:index]\n            after = text[index + 1:index + 2]\n            if before in ('>', '<') or after == '>':\n                char = '__GUARD_FD_AMP__'\n            elif before == '|':\n                continue\n        out.append(char)\n    return ''.join(out)\n\n\ndef command_records(command):\n    groups = []\n    pending = ''\n    receiver = None\n    heredoc_end = None\n    # Shell escaped newlines do not delimit commands.\n    command = command.replace(chr(92) + chr(10), '')\n    for line in command.split(chr(10)):\n        if heredoc_end is not None:\n            if line.lstrip(chr(9)) == heredoc_end:\n                heredoc_end = None\n            else:\n                receiver.body += line + chr(10)\n            continue\n        pending = shell_text(pending + line + chr(10))\n        try:\n            lexer = shlex.shlex(pending, posix=True, punctuation_chars=';&|()')\n            lexer.whitespace_split = True\n            lexer.commenters = ''\n            tokens = [token.replace('__GUARD_FD_AMP__', '&') for token in lexer]\n        except ValueError:\n            # A quote can span physical lines. Never reinterpret failed lexing\n            # as whitespace-separated argv.\n            continue\n        logical_line = pending\n        pending = ''\n        current = []\n        tokens = [part for token in tokens for part in (re.findall(r'[()]|[;&|]+', token) if token and all(c in '();&|' for c in token) else [token])]\n        for token in tokens:\n            if token in DELIMS or (token and all(c in '()' for c in token)):\n                if current:\n                    groups.append(CommandGroup(current))\n                current = []\n                groups.append(CommandGroup([], boundary=token))\n            else:\n                current.append(token)\n        if current:\n            groups.append(CommandGroup(current))\n        delim = heredoc_delim(logical_line)\n        if delim and groups:\n            heredoc_end, quoted = delim\n            receiver = groups[-1]\n            receiver.expanding_body = not quoted\n        if tokens and tokens[-1] not in ('&&', '||', '|'):\n            groups.append(CommandGroup([], boundary=';'))\n    if pending or heredoc_end:\n        groups.append(CommandGroup([], error='incomplete shell syntax'))\n    return groups\n\n\ndef command_groups(command):\n    records = command_records(command)\n    if any(group.error for group in records):\n        # Keep every physical command visible to denylists after a lex error.\n        return [part.split() for line in shell_text(command).splitlines()\n                for part in re.split(r'[;&|()]', line) if part.split()]\n    return [group for group in records if group]\n\ndef strip_prefixes(group):\n    index = 0\n    while index < len(group):\n        token = group[index]\n        base = os.path.basename(token)\n        if ASSIGNMENT_RE.match(token) or base in WRAPPERS:\n            index += 1\n            continue\n        if base == 'timeout' and index + 1 < len(group):\n            index += 2\n            continue\n        break\n    return group[index:]\n# Embedded in the always-on launch guard for every driver. Reuse its shell\n# tokenizer; this fragment must contain no shell double quotes, backticks,\n# dollars or backslashes because the enclosing command uses double quotes.\nSIGNAL_REASON = ('Blocked unsafe process signalling: pkill/killall select processes by '\n                 'name or pattern, and kill with indirect PIDs, process groups or broad '\n                 'targets can terminate other workers. Stop only processes you started '\n                 'yourself using explicit positive numeric PIDs (for example, the PID '\n                 'captured from ' + chr(36) + '! when starting your process), or wait '\n                 'for or time out your own command.')\n\ndef signal_comment(source, i):\n    return source[i] == '#' and (i == 0 or source[i-1] in ' ;&|()<>'+chr(9)+chr(10))\n\ndef signal_body_end(source, start, newline):\n    delimiter, _ = signal_heredoc(source[start:newline])\n    if delimiter is None:\n        return newline\n    end = newline + 1\n    while end < len(source):\n        next_line = source.find(chr(10), end)\n        if next_line < 0:\n            next_line = len(source)\n        if source[end:next_line].lstrip(chr(9)) == delimiter:\n            return next_line\n        end = next_line + 1\n    raise ValueError('unterminated heredoc')\n\ndef signal_substitutions(source, literal_quotes=False):\n    # Separate executable substitutions from ordinary quoted arguments. Keep a\n    # nonnumeric placeholder at the call site so kill cannot accept their output.\n    output, substitutions = [], []\n    quote = None\n    i = 0\n    while i < len(source):\n        c = source[i]\n        if not literal_quotes and quote is None and signal_comment(source, i):\n            end = source.find(chr(10), i)\n            i = len(source) if end < 0 else end\n            continue\n        if not literal_quotes and quote is None and c == chr(10):\n            header = ''.join(output).rsplit(chr(10), 1)[-1]\n            tail = header + source[i:]\n            end = i + signal_body_end(tail, 0, len(header)) - len(header)\n            output.append(source[i:end+1])\n            i = end + 1\n            continue\n        if c == chr(92) and quote != chr(39):\n            output.append(source[i:i+2])\n            i += 2\n            continue\n        if not literal_quotes and c == chr(39) and quote != chr(34):\n            quote = None if quote else c\n        elif not literal_quotes and c == chr(34) and quote != chr(39):\n            quote = None if quote else c\n        elif quote != chr(39) and (c == chr(96) or source[i:i+2] == chr(36)+'('):\n            backtick = c == chr(96)\n            start = i + (1 if backtick else 2)\n            j, depth, inner_quote = start, 1, None\n            inner_start = start\n            arithmetic = source[i:i+3] == chr(36)+'(('\n            while j < len(source):\n                t = source[j]\n                if inner_quote is None and signal_comment(source, j):\n                    end = source.find(chr(10), j)\n                    j = len(source) if end < 0 else end\n                    continue\n                if inner_quote is None and t == chr(10):\n                    j = (j if arithmetic else signal_body_end(source, inner_start, j)) + 1\n                    inner_start = j\n                    continue\n                if t == chr(92):\n                    j += 2\n                    continue\n                if backtick and t == chr(96):\n                    break\n                if not backtick:\n                    if t in (chr(39), chr(34)):\n                        if inner_quote is None:\n                            inner_quote = t\n                        elif inner_quote == t:\n                            inner_quote = None\n                    elif inner_quote is None:\n                        if t == '(':\n                            depth += 1\n                        elif t == ')':\n                            depth -= 1\n                            if depth == 0:\n                                break\n                j += 1\n            if j == len(source):\n                raise ValueError('unterminated command substitution')\n            content = source[start:j]\n            if arithmetic:\n                substitutions.extend(signal_substitutions(content)[1])\n            else:\n                substitutions.append(content)\n            output.append('__indirect_pid__')\n            i = j + 1\n            continue\n        output.append(c)\n        i += 1\n    return ''.join(output), substitutions\n\ndef signal_argv(group):\n    # Retain xargs provenance and consume wrapper options with operands before\n    # finding the program, extending the common tokenizer prefix handling.\n    # Redirections can precede the executable as well as follow its arguments.\n    words, i = [], 0\n    redirects = ('<', '>', '>>', '<<', '<<<', '<>', '>&', '<&', '&>', '&>>', '>|')\n    while i < len(group):\n        if not words and group[i].isdigit() and i+1 < len(group) and group[i+1] in redirects:\n            i += 1\n        if group[i] in redirects:\n            i += 2\n        else:\n            words.append(group[i])\n            i += 1\n    group = words\n    indirect = False\n    while group:\n        base = os.path.basename(group[0])\n        if ASSIGNMENT_RE.match(group[0]) or base in ('!', '{', '}', 'then', 'do', 'if', 'elif', 'while', 'until', 'else', 'coproc'):\n            group = group[1:]\n            continue\n        if base == 'function':\n            group = group[2:]\n            continue\n        if base not in WRAPPERS and base not in ('timeout', 'builtin', 'busybox', 'nice', 'ionice', 'doas'):\n            break\n        indirect |= base == 'xargs'\n        group = group[1:]\n        if base == 'command' and group and group[0] in ('-v', '-V'):\n            return [], indirect\n        takes_value = {\n            'sudo': ('-u', '-g', '-h', '-p', '-C', '-T', '-R', '-D', '-r', '-t', '-U',\n                     '--user', '--group', '--host', '--prompt', '--chdir', '--chroot',\n                     '--role', '--type', '--other-user', '--close-from', '--command-timeout'),\n            'env': ('-u', '-C', '-a', '--unset', '--chdir', '--argv0'),\n            'exec': ('-a',),\n            'nice': ('-n', '--adjustment'),\n            'ionice': ('-c', '-n', '-p', '-P', '-u', '--class', '--classdata', '--pid', '--pgid', '--uid'),\n            'doas': ('-u', '-C'),\n            'xargs': ('-I', '-J', '-n', '-P', '-s', '-E', '-L', '-d', '--replace', '--max-args', '--max-procs'),\n            'timeout': ('-s', '-k', '--signal', '--kill-after'),\n            'caffeinate': ('-t', '-w'),\n            'stdbuf': ('-i', '-o', '-e'),\n        }.get(base, ())\n        while group and group[0].startswith('-'):\n            option = group[0]\n            if base == 'env' and option in ('-S', '--split-string'):\n                group = shlex.split(group[1]) + group[2:]\n                break\n            if base == 'env' and option.startswith('--split-string='):\n                group = shlex.split(option.split('=', 1)[1]) + group[1:]\n                break\n            if base == 'env' and option.startswith('-S'):\n                group = shlex.split(option[2:]) + group[1:]\n                break\n            group = group[2:] if option in takes_value else group[1:]\n            if option == '--':\n                break\n        if base == 'timeout':\n            group = group[1:]\n    return group, indirect\n\ndef signal_kill(args, indirect, captures):\n    if args and args[0] in ('-l', '-L', '--list', '--table'):\n        return\n    if indirect or not args:\n        _block(SIGNAL_REASON)\n    if args[0] in ('-s', '-n', '--signal'):\n        args = args[2:]\n    elif args[0].startswith('--signal='):\n        args = args[1:]\n    elif args[0].startswith('-') and args[0] != '--':\n        # A lone negative argument (notably kill -1) is never an explicit PID.\n        args = args[1:]\n    if args and args[0] == '--':\n        args = args[1:]\n    # pid_t is signed 32-bit on worker hosts; prevent positive literals from\n    # wrapping into a process group or the all-processes sentinel.\n    def valid(pid):\n        if pid in (chr(36)+'!', chr(36)+'{!}'):\n            return True\n        if pid.startswith(chr(36)) and pid[1:].strip('{}') in captures:\n            return True\n        return re.fullmatch('[0-9]+', pid) and 0 < int(pid) <= 2147483647\n    if not args or not all(valid(pid) for pid in args):\n        _block(SIGNAL_REASON)\n\ndef signal_heredoc(line):\n    # Only a real redirection introduces a heredoc, never quoted documentation\n    # such as echo '<<EOF'. Reuse the shared delimiter reader at that position.\n    quote, i = None, 0\n    while i < len(line):\n        c = line[i]\n        if c == chr(92) and quote != chr(39):\n            i += 2\n            continue\n        if c in (chr(39), chr(34)):\n            if quote is None:\n                quote = c\n            elif quote == c:\n                quote = None\n        elif quote is None and signal_comment(line, i):\n            break\n        elif quote is None and line[i:i+2] == '<<':\n            if line[i:i+3] == '<<<':\n                i += 3\n                continue\n            rest = line[i+2:].lstrip('-').lstrip()\n            delim = heredoc_delim(line[i:])\n            if delim is None:\n                raise ValueError('unrecognised heredoc delimiter')\n            return delim, rest.startswith((chr(39), chr(34)))\n        i += 1\n    return None, False\n\ndef signal_shell(args):\n    return args and os.path.basename(args[0]) in ('bash', 'sh', 'zsh', 'dash', 'ksh')\n\ndef signal_source(source, depth):\n    lines, body, heredoc_end, quoted, shell_body = [], [], None, False, False\n    for line in source.split(chr(10)):\n        if heredoc_end is not None:\n            if line.lstrip(chr(9)) == heredoc_end:\n                data = chr(10).join(body)\n                if shell_body:\n                    signal_check(data, depth+1)\n                elif not quoted:\n                    for substitution in signal_substitutions(data, literal_quotes=True)[1]:\n                        signal_check(substitution, depth+1)\n                heredoc_end = None\n                body = []\n            else:\n                body.append(line)\n            continue\n        heredoc_end, quoted = signal_heredoc(line)\n        if heredoc_end:\n            shell_body = any(signal_shell(signal_argv(g)[0]) for g in command_groups(line, nested=True))\n        lines.append(line)\n    if heredoc_end is not None:\n        raise ValueError('unterminated heredoc')\n    return chr(10).join(lines)\n\ndef signal_check(source, depth=0):\n    if depth > 40:\n        _block(SIGNAL_REASON + ' Shell nesting is too deep to inspect safely.')\n    source = source.replace(chr(92)+chr(10), '')\n    source, substitutions = signal_substitutions(source)\n    source = signal_source(source, depth)\n    for substitution in substitutions:\n        signal_check(substitution, depth+1)\n    variables, assignments, captures = {}, set(), set()\n    groups = command_groups(source, nested=True)\n    for group in groups:\n        args, indirect = signal_argv(group)\n        # Only assignment prefixes change shell variables; arguments to echo\n        # or another program cannot establish or overwrite PID provenance.\n        for word in group:\n            if not ASSIGNMENT_RE.match(word):\n                break\n            name, value = word.split('=', 1)\n            captures.discard(name)\n            if not args and name not in assignments and value in (chr(36)+'!', chr(36)+'{!}'):\n                captures.add(name)\n            assignments.add(name)\n            variables[name] = value\n        if not args:\n            continue\n        program = args[0]\n        if program.startswith(chr(36)):\n            program = variables.get(program[1:].strip('{}'), program)\n        base = os.path.basename(program)\n        if base == '__indirect_pid__' and any(re.search(r'(?<![A-Za-z_])(pkill|killall)(?![A-Za-z_])', sub) for sub in substitutions):\n            _block(SIGNAL_REASON)\n        if base in ('pkill', 'killall'):\n            _block(SIGNAL_REASON + ' Refused command: ' + base + '.')\n        if base == 'kill':\n            signal_kill(args[1:], indirect, captures)\n        if signal_shell(args):\n            if '|' in source and any(re.search(r'(?<![A-Za-z_])(pkill|killall)(?![A-Za-z_])', word) for g in groups for word in g):\n                _block(SIGNAL_REASON)\n            for i, arg in enumerate(args[1:], 1):\n                if arg.startswith('-') and not arg.startswith('--') and 'c' in arg:\n                    if i+1 < len(args):\n                        signal_check(args[i+1], depth+1)\n                    break\n        if base == 'eval':\n            signal_check(' '.join(args[1:]), depth+1)\n\ntry:\n    signal_check(cmd)\nexcept Exception as error:\n    _block(SIGNAL_REASON + ' Cannot safely parse this shell command: ' + str(error))\nPROD='/tmp/boss-engine.sock'\nASSIGN=re.compile(r'^([A-Za-z_][A-Za-z0-9_]*)=(.*)$', re.S)\nvars={}\nfor k in ('BOSS_BIN','CUBE_BIN','BOSS_BIN_DIR','BOSS_WORKER_BIN_DIR'):\n    v=os.environ.get(k)\n    if v:\n        vars[k]=v\ndef expand(t):\n    keys=sorted(vars, key=len, reverse=True)\n    for k in keys:\n        t=t.replace('$'+'{'+k+'}',vars[k]).replace('$'+k,vars[k])\n    return t\ngroups=[]\nfor g in command_groups(cmd):\n    resolved=[]\n    for t in g:\n        m=ASSIGN.match(t)\n        if m:\n            vars[m.group(1)]=expand(m.group(2))\n        resolved.append(expand(t))\n    groups.append(resolved)\ndef socket_arg(g):\n    for j,t in enumerate(g):\n        if t=='--socket-path' and j+1<len(g):\n            return g[j+1]\n        if t.startswith('--socket-path='):\n            return t.split('=',1)[1]\n    return None\ndef is_bundle_cli(p):\n    d=os.path.dirname(os.path.normpath(p))\n    return d.endswith('/Contents/Resources/bin')\nmatched=None\nfor g in groups:\n    rest=strip_prefixes(g)\n    if not rest:\n        continue\n    prog=rest[0]\n    base=os.path.basename(prog)\n    if base in ('Boss','engine','boss-engine','bossctl'):\n        matched=prog\n        break\n    if 'Boss.app' in prog and not is_bundle_cli(prog):\n        matched=prog\n        break\n    if base=='boss' and len(rest)>=3 and rest[1]=='engine' and rest[2] in ('start','stop'):\n        matched=prog+' engine '+rest[2]\n        break\n    if base=='open':\n        joined=' '.join(rest)\n        if 'Boss.app' in joined or 'dev.spinyfin.bossmacapp' in joined or re.search(r'(^| )-a +Boss( |$)',joined):\n            matched=joined[:120]\n            break\n    if base in ('bazel','bazelisk') and len(rest)>1 and rest[1]=='run':\n        joined=' '.join(rest)\n        if 'tools/boss/app-macos' in joined:\n            sock=vars.get('BOSS_SOCKET_PATH')\n            auto=vars.get('BOSS_ENGINE_AUTOSTART')\n            if (sock is None or os.path.normpath(sock)==PROD\n                    or 'Library/Application Support/Boss' in sock or auto!='0'):\n                matched='bazel run of an app-macos target without an isolating BOSS_SOCKET_PATH and BOSS_ENGINE_AUTOSTART=0'\n                break\n        if 'tools/boss/engine' in joined:\n            sp=socket_arg(rest)\n            if sp is None or os.path.normpath(sp)==PROD or 'Library/Application Support/Boss' in sp:\n                matched='bazel run of an engine target without an isolating --socket-path'\n                break\n    if base=='swift' and len(rest)>1 and rest[1]=='run':\n        matched='swift run'\n        break\nif matched:\n    msg=('Blocked: this would start Boss itself (matched: '+matched+'). Workers must not launch the installed /Applications/Boss.app or an engine that can reach production state on this machine -- the live app seizes the running engine, and an unisolated launch puts a window on the operator screen. To exercise a real engine, start an isolated one: env -u BOSS_EVENTS_SOCKET bazel run //tools/boss/engine/core:engine -- --socket-path /tmp/boss-test-<id>.sock. Any --socket-path other than /tmp/boss-engine.sock derives its own db, events socket, pid file and control token; unsetting BOSS_EVENTS_SOCKET matters because every worker pane inherits one pointing at production. To screenshot the real Boss UI quietly, launch an isolated capture instance: BOSS_SOCKET_PATH=/tmp/boss-shot-<id>.sock BOSS_ENGINE_AUTOSTART=0 bazel run //tools/boss/app-macos:Boss -- --capture-to <path>.png. The instance renders itself in-process via cacheDisplay and exits; it never shows a window, never takes focus, and needs no screen-recording permission. Read the PNG back and state in the PR what you verified. Building and testing are unaffected (bazel build, bazel test).')\n    _block(msg)\nWATCH={'boss','cube'}\nREPOBIN='repobin'\nDOL=chr(36)\ndef which(name):\n    if os.sep in name:\n        return name if os.path.isfile(name) else None\n    for d in os.environ.get('PATH','').split(':'):\n        if not d: continue\n        p=os.path.join(d,name)\n        if os.path.isfile(p) and os.access(p,os.X_OK):\n            return p\n    return None\ndef is_shim(p):\n    if not p: return False\n    if os.path.basename(p)==REPOBIN: return True\n    try:\n        return os.path.basename(os.path.realpath(p))==REPOBIN\n    except Exception:\n        return False\nshim=None\nbare=None\nnamed_unset=None\ndef peel_shell_c(rest):\n    if not rest: return rest\n    base=os.path.basename(rest[0])\n    if base not in ('sh','bash','zsh'): return rest\n    j=1\n    payload=None\n    while j<len(rest):\n        t=rest[j]\n        if t.startswith('-') and 'c' in t[1:]:\n            if j+1<len(rest):\n                payload=rest[j+1]\n            break\n        j+=1\n    if payload is None: return rest\n    try:\n        toks=shlex.split(payload,posix=True)\n    except Exception:\n        toks=payload.split()\n    return strip_prefixes(toks) if toks else rest\nfor g in groups:\n    rest=peel_shell_c(strip_prefixes(g))\n    if not rest: continue\n    orig=rest[0]\n    if orig in (DOL+'BOSS_BIN', DOL+'{BOSS_BIN}', DOL+'CUBE_BIN', DOL+'{CUBE_BIN}'):\n        key=orig.strip(DOL+'{}')\n        target=vars.get(key) or os.environ.get(key) or ''\n        if not target:\n            named_unset=key\n            break\n        if is_shim(target):\n            shim=target\n            break\n        continue\n    base=os.path.basename(orig)\n    if orig in WATCH:\n        resolved=which(orig)\n        if resolved and is_shim(resolved):\n            shim=resolved\n        else:\n            bare=orig\n        break\n    if base in WATCH:\n        candidate=orig if os.path.isfile(orig) else (which(orig) or orig)\n        if is_shim(candidate):\n            shim=candidate\n            break\nif named_unset:\n    _block('Blocked: '+named_unset+' is unset in this worker session, so the named-binary invocation cannot run. Report this as a finding: the engine should have exported '+named_unset+' to the launcher under BOSS_WORKER_BIN_DIR.')\nif shim or bare:\n    name=bare or os.path.basename(shim or '')\n    where=('repobin shim at '+shim) if shim else ('bare PATH lookup of '+name)\n    q=chr(34)\n    _block('Blocked: this command would run '+name+' via '+where+'. That is a build-from-source multiplexer (repobin) or an untrusted PATH lookup: a driver shell snapshot can demote the launcher directory and silently bazel-build the CLI from a checkout for ~30s. Workers must name the engine-owned binary, not a PATH entry: '+q+DOL+'BOSS_BIN'+q+' / '+q+DOL+'CUBE_BIN'+q+'. Re-issue quoting the env var, e.g. '+q+DOL+'BOSS_BIN'+q+' pr status --json. Do not work around this gate and do not suppress bazel output.')\n_approve()\n\""
