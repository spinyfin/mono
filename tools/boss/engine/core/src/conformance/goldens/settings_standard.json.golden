        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\nimport json,os,sys,re,shlex\ndef review_guide_masked_command(command):\n    if not isinstance(command,str):\n        return None\n    q=chr(39)\n    dq=chr(34)\n    dl=chr(36)\n    bs=chr(92)\n    literal=q+'(?:[^'+q+']|'+q+dq+q+dq+q+'|'+q+bs+bs+q+q+')*'+q\n    match=re.fullmatch(r'([\\s\\S]*?)[ \\t]+--body[ \\t]+('+literal+r')[ \\t\\r\\n]*',command)\n    if not match:\n        return None\n    prefix=match.group(1)\n    prefixes=(dq+dl+'BOSS_BIN'+dq+' propose review-guide',dq+dl+'{BOSS_BIN}'+dq+' propose review-guide','boss propose review-guide')\n    if prefix not in prefixes:\n        return None\n    return prefix+' --body '+q+'literal'+q\ndef _emit(d):\n    print(json.dumps(d))\n    sys.exit(0)\ndef _approve():\n    _emit({'decision':'approve'})\ndef _block(msg):\n    _emit({'decision':'block','reason':msg})\n_SHAPE=('Blocked (fail-closed): a Boss PreToolUse guard could not read this tool call as a shell command, so it cannot prove the call is allowed. Guards deny what they cannot parse rather than approving by default. Re-issue the work as an ordinary shell command, and report this payload shape to the operator -- it means Boss guard wiring needs updating for this agent driver. Detail: ')\ntry:\n    inp=json.load(sys.stdin)\nexcept Exception as _e:\n    _block(_SHAPE+'hook stdin was not JSON ('+str(_e)+')')\nif not isinstance(inp,dict):\n    _block(_SHAPE+'hook payload was not a JSON object')\n_ti=inp.get('tool_input')\nif not isinstance(_ti,dict):\n    _block(_SHAPE+'tool_input was '+type(_ti).__name__+', not an object')\ncmd=_ti.get('command')\nif not isinstance(cmd,str):\n    _block(_SHAPE+'tool_input.command was '+type(cmd).__name__+', not a string')\n_masked=review_guide_masked_command(cmd)\nif _masked is not None:\n    cmd=_masked\n\nDELIMS = {'&&', '||', ';', '|', '&'}\nWRAPPERS = {'env', 'command', 'builtin', 'exec', 'nohup', 'stdbuf', 'setsid', 'caffeinate', 'sudo', 'time', 'xargs', 'nice', 'ionice', 'chronic', 'timeout', 'doas', 'flock', 'chrt', 'taskset', 'script', 'watch', 'su', 'busybox', 'noglob', 'nocorrect', '-'}\nASSIGNMENT_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*=')\n\nSHLEX_WS = ' \\t\\r\\n'\n\ndef skip_arithmetic(line, index):\n    # Double-paren and dollar-bracket arithmetic hold shifts, not redirections. Returns the index after the construct, or None if unclosed.\n    if line.startswith(chr(36) + '[', index):\n        depth, end = 1, index + 2\n        opener, closer = '[', ']'\n    else:\n        depth, end = 2, index + 2\n        opener, closer = '(', ')'\n    while end < len(line) and depth:\n        if line[end] == opener:\n            depth += 1\n        elif line[end] == closer:\n            depth -= 1\n        end += 1\n    return None if depth else end\n\n\nANSI = 'ansi'\n\n\ndef is_ansi_open(text, index, quote):\n    return quote is None and text.startswith(chr(36) + chr(39), index)\n\n\ndef heredoc_word(rest):\n    # Read the whole delimiter word, applying bash quote removal. Any quote or\n    # backslash anywhere in it makes the body non-expanding. False means the\n    # syntax cannot be parsed safely.\n    word, quoted, index = [], False, 0\n    while index < len(rest):\n        char = rest[index]\n        if char in SHLEX_WS or char in ';&|()<>':\n            break\n        if char == chr(92):\n            if index + 1 >= len(rest):\n                return False\n            word.append(rest[index + 1])\n            quoted, index = True, index + 2\n            continue\n        if char == '$' and rest[index + 1:index + 2] in (chr(39), chr(34)):\n            return False\n        if char in (chr(39), chr(34)):\n            quoted = True\n            index += 1\n            while index < len(rest) and rest[index] != char:\n                if char == chr(34) and rest[index] == chr(92) and rest[index + 1:index + 2] in ('$', chr(96), chr(34), chr(92)):\n                    index += 1\n                word.append(rest[index])\n                index += 1\n            if index >= len(rest):\n                return False\n            index += 1\n            continue\n        word.append(char)\n        index += 1\n    return (''.join(word), quoted, index) if word else False\n\n\ndef heredoc_ops(line):\n    # Every unquoted, non-arithmetic << heredoc as (offset, word, quoted), or\n    # False when the syntax cannot be parsed safely.\n    found = []\n    quote, escaped, index = None, False, 0\n    while index < len(line):\n        char = line[index]\n        if escaped:\n            escaped, index = False, index + 1\n            continue\n        if quote == ANSI:\n            if char == chr(92):\n                escaped, index = True, index + 1\n                continue\n            if char == chr(39):\n                quote = None\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92):\n            escaped, index = True, index + 1\n            continue\n        if quote:\n            if char == quote:\n                quote = None\n            index += 1\n            continue\n        if is_ansi_open(line, index, quote):\n            quote = ANSI\n            index += 2\n            continue\n        if char in (chr(39), chr(34)):\n            quote = char\n            index += 1\n            continue\n        if line.startswith(chr(36) + '[', index) or line.startswith('((', index):\n            index = skip_arithmetic(line, index)\n            if index is None:\n                return False\n            continue\n        if char == '<' and index + 1 < len(line) and line[index + 1] == '<':\n            rest = line[index + 2:]\n            if rest.startswith('<'):\n                index += 3\n                continue\n            if rest.startswith('-'):\n                rest = rest[1:]\n            rest = rest.lstrip(SHLEX_WS)\n            parsed = heredoc_word(rest)\n            if parsed is False:\n                return False\n            found.append((index, parsed[0], parsed[1]))\n            index += 2\n            continue\n        index += 1\n    return found\n\n\n\nclass CommandGroup(list):\n    def __init__(self, tokens, body='', boundary=None, error=None, literal_chars=None, quote_segments=None):\n        super().__init__(tokens)\n        self.body = body\n        self.body_span = None\n        self.literal_chars = literal_chars or [[] for _ in tokens]\n        # Parallel to literal_chars: integer ids of the quote/escape run each\n        # character came from. None means provenance did not match shlex, so\n        # unbraced expansions cannot be verified.\n        self.quote_segments = quote_segments\n        self.expanding_body = False\n        self.boundary = boundary\n        self.error = error\n        self.pipe_sources = []\n\n\ndef split_punct_word(word, mask, segs):\n    if word and all(c in '();&|' for c in word):\n        parts, masks, part_segs, offset = [], [], [], 0\n        for part in re.findall(r'[()]|[;&|]+', word):\n            parts.append(part)\n            masks.append(mask[offset:offset + len(part)])\n            part_segs.append(segs[offset:offset + len(part)])\n            offset += len(part)\n        return parts, masks, part_segs\n    return [word], [mask], [segs]\n\n\ndef quote_provenance(text, tokens, spans=None):\n    # Mirror shlex boundaries while retaining each literal character and the\n    # quote/escape run it came from. Adjacent quoted strings concatenate into\n    # one shlex word (\"$A\"\"B\" -> $AB) but must not share a segment id.\n    words, masks, segs, word, mask, segm = [], [], [], [], [], []\n    quote, index, active, segment = None, 0, False, 0\n    word_start = 0\n    def new_segment():\n        nonlocal segment\n        segment += 1\n    def finish():\n        nonlocal word, mask, segm, active\n        if active:\n            parts, part_masks, part_segs = split_punct_word(''.join(word), mask, segm)\n            if spans is not None:\n                spans.extend([(word_start, index)] * len(parts))\n            words.extend(parts)\n            masks.extend(part_masks)\n            segs.extend(part_segs)\n        word, mask, segm, active = [], [], [], False\n    while index < len(text):\n        char = text[index]\n        if not active and char not in SHLEX_WS:\n            word_start = index\n        if quote == ANSI:\n            if char == chr(92) and index + 1 < len(text):\n                word.append(text[index + 1])\n                mask.append(True)\n                segm.append(segment)\n                active = True\n                index += 2\n                continue\n            if char == chr(39):\n                quote = None\n                new_segment()\n                index += 1\n                continue\n            word.append(char)\n            mask.append(True)\n            segm.append(segment)\n            active = True\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92) and index + 1 < len(text):\n            following = text[index + 1]\n            if quote != chr(34) or following in (chr(34), chr(92)):\n                new_segment()\n                word.append(following)\n                mask.append(True)\n                segm.append(segment)\n                new_segment()\n                active = True\n                index += 2\n                continue\n        if char == quote:\n            quote = None\n            new_segment()\n        elif is_ansi_open(text, index, quote):\n            # The $ of $'...' is not an expansion. Keep it as its own run so\n            # it cannot join the ANSI body into a trusted name.\n            new_segment()\n            word.append(char)\n            mask.append(False)\n            segm.append(segment)\n            new_segment()\n            quote = ANSI\n            active = True\n            index += 2\n            continue\n        elif quote is None and char in (chr(39), chr(34)):\n            quote = char\n            new_segment()\n            active = True\n        elif quote is None and char in SHLEX_WS:\n            finish()\n        elif quote is None and char in ';&|()':\n            finish()\n            end = index + 1\n            while end < len(text) and text[end] in ';&|()':\n                end += 1\n            for part in re.findall(r'[()]|[;&|]+', text[index:end]):\n                words.append(part)\n                if spans is not None:\n                    spans.append((index, index + len(part)))\n                    index += len(part)\n                masks.append([False] * len(part))\n                segs.append([segment] * len(part))\n            index = end\n            continue\n        else:\n            word.append(char)\n            if quote == chr(39) or char == chr(2):\n                mask.append(True)\n            elif quote == chr(34):\n                mask.append('d')\n            else:\n                mask.append(False)\n            segm.append(segment)\n            active = True\n        index += 1\n    finish()\n    restored = []\n    for position, word in enumerate(words):\n        for marker, value in [('__GUARD_FD_AMP__', '&'), ('__GUARD_REDIRECT_PIPE__', '|'), (chr(2), '$')]:\n            while marker in word:\n                start = word.index(marker)\n                masks[position][start:start + len(marker)] = [masks[position][start]]\n                segs[position][start:start + len(marker)] = [segs[position][start]]\n                word = word[:start] + value + word[start + len(marker):]\n        restored.append(word)\n    if restored != tokens:\n        return [[False] * len(token) for token in tokens], None\n    return masks, segs\n\n\ndef open_quote(text):\n    # The quote left open after lexing text, mirroring shlex posix quoting.\n    quote, index = None, 0\n    while index < len(text):\n        char = text[index]\n        if quote == ANSI:\n            if char == chr(92):\n                index += 2\n                continue\n            if char == chr(39):\n                quote = None\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92):\n            index += 2\n            continue\n        if quote:\n            if char == quote:\n                quote = None\n        elif is_ansi_open(text, index, quote):\n            quote = ANSI\n            index += 2\n            continue\n        elif char in (chr(39), chr(34)):\n            quote = char\n        index += 1\n    return quote\n\n\ndef ansi_escapes_quote(text):\n    # True when an unquoted $'...' string holds an escaped quote. Bash pairs\n    # that quote inside the string while shlex closes the string there, so the\n    # words shlex reports are not the words bash runs.\n    quote, index = None, 0\n    while index < len(text):\n        char = text[index]\n        if quote == ANSI:\n            if char == chr(92):\n                if text[index + 1:index + 2] == chr(39):\n                    return True\n                index += 2\n                continue\n            if char == chr(39):\n                quote = None\n            index += 1\n            continue\n        if quote != chr(39) and char == chr(92):\n            index += 2\n            continue\n        if quote:\n            if char == quote:\n                quote = None\n        elif is_ansi_open(text, index, quote):\n            quote = ANSI\n            index += 2\n            continue\n        elif char in (chr(39), chr(34)):\n            quote = char\n        index += 1\n    return False\n\n\ndef odd_trailing_backslashes(text):\n    return (len(text) - len(text.rstrip(chr(92)))) % 2 == 1\n\n\ndef strip_line_continuations(text):\n    # Remove backslash-newline only where the shell does: not inside comments,\n    # single quotes or non-expanding heredoc bodies.\n    lines = text.split(chr(10))\n    out, current, pending, carry = [], '', '', ''\n    heredoc_end, expanding = None, False\n    heredocs = []\n    for number, line in enumerate(lines):\n        last = number == len(lines) - 1\n        if heredoc_end is not None:\n            joined = carry + line\n            if expanding and not last and odd_trailing_backslashes(joined):\n                carry = joined[:-1]\n                continue\n            carry = ''\n            out.append(joined)\n            if joined.lstrip(chr(9)) == heredoc_end:\n                if heredocs:\n                    heredoc_end, quoted = heredocs.pop(0)\n                    expanding = not quoted\n                else:\n                    heredoc_end = None\n            continue\n        shaped = shell_text(pending + line + chr(10))\n        body = shaped[:-1]\n        if not last and odd_trailing_backslashes(body) and open_quote(body[:-1]) != chr(39):\n            pending = body[:-1]\n            current += line[:-1]\n            continue\n        out.append(current + line)\n        current = ''\n        if open_quote(shaped):\n            pending = shaped\n            continue\n        pending = ''\n        ops = heredoc_ops(shaped)\n        if ops:\n            heredocs = [op[1:] for op in ops]\n            heredoc_end, quoted = heredocs.pop(0)\n            expanding = not quoted\n    return chr(10).join(out + ([current] if current else []))\n\n\ndef shell_text(text):\n    # Comments cannot open quotes. Protect fd redirections from punctuation\n    # splitting, while preserving quoted data exactly.\n    out, quote, escaped, comment, index = [], None, False, False, 0\n    while index < len(text):\n        char = text[index]\n        if comment:\n            if char == chr(10):\n                comment = False\n                out.append(char)\n            index += 1\n            continue\n        if escaped:\n            # shlex preserves these escapes inside double quotes, while the\n            # shell consumes them before executing an extracted -c body.\n            if quote == chr(34) and char in (chr(36), chr(96)):\n                out.pop()\n                if char == chr(36):\n                    char = chr(2)\n            out.append(char)\n            escaped = False\n            index += 1\n            continue\n        if char == chr(92) and quote != chr(39):\n            escaped = True\n        elif quote == ANSI:\n            if char == chr(39):\n                quote = None\n        elif quote:\n            if char == quote:\n                quote = None\n        elif is_ansi_open(text, index, quote):\n            quote = ANSI\n            out.append(char)\n            out.append(text[index + 1])\n            index += 2\n            continue\n        elif char in (chr(39), chr(34)):\n            quote = char\n        elif char == '#' and (index == 0 or text[index - 1].isspace() or text[index - 1] in ';|&()<>'):\n            # An escaped space is still inside a word, so a hash after that\n            # space does not start a comment and later commands stay visible.\n            slashes = 0\n            j = index - 2\n            while j >= 0 and text[j] == chr(92):\n                slashes += 1\n                j -= 1\n            escaped_space = index > 0 and text[index - 1].isspace() and slashes % 2 == 1\n            if not escaped_space:\n                comment = True\n                index += 1\n                continue\n        elif char == '&':\n            before = text[index - 1:index]\n            after = text[index + 1:index + 2]\n            if before in ('>', '<') or after == '>':\n                char = '__GUARD_FD_AMP__'\n            elif before == '|':\n                index += 1\n                continue\n        elif char == '|' and text[index - 1:index] == '>':\n            char = '__GUARD_REDIRECT_PIPE__'\n        out.append(char)\n        index += 1\n    return ''.join(out)\n\n\n\ndef command_records(command, stripped=False):\n    groups = []\n    pending = ''\n    receiver = None\n    heredoc_end = None\n    heredocs = []\n    if not stripped:\n        command = strip_line_continuations(command)\n    offset = 0\n    for line in command.split(chr(10)):\n        line_start = offset\n        offset += len(line) + 1\n        if heredoc_end is not None:\n            if line.lstrip(chr(9)) == heredoc_end:\n                if heredocs:\n                    receiver, heredoc_end, quoted = heredocs.pop(0)\n                    receiver.expanding_body = not quoted\n                else:\n                    heredoc_end = None\n            else:\n                receiver.body += line + chr(10)\n                start = receiver.body_span[0] if receiver.body_span else line_start\n                receiver.body_span = (start, min(offset, len(command)))\n            continue\n        pending = shell_text(pending + line + chr(10))\n        if ansi_escapes_quote(pending):\n            groups.append(CommandGroup([], error='incomplete shell syntax'))\n            pending = ''\n            continue\n        try:\n            lexer = shlex.shlex(pending, posix=True, punctuation_chars=';&|()')\n            lexer.whitespace_split = True\n            lexer.commenters = ''\n            tokens = [token.replace('__GUARD_FD_AMP__', '&').replace('__GUARD_REDIRECT_PIPE__', '|').replace(chr(2), '$') for token in lexer]\n        except ValueError:\n            # A quote can span physical lines. If our tracker says every quote\n            # is closed, shlex failed on a construct it does not model (ANSI-C\n            # escaped quotes). Keep later lines visible instead of swallowing\n            # them as continuation of an opener shlex invented.\n            if open_quote(pending):\n                continue\n            groups.append(CommandGroup([], error='incomplete shell syntax'))\n            pending = ''\n            continue\n        logical_line = pending\n        pending = ''\n        line_group_start = len(groups)\n        current = []\n        tokens = [part for token in tokens for part in (re.findall(r'[()]|[;&|]+', token) if token and all(c in '();&|' for c in token) else [token])]\n        spans = []\n        try:\n            literal, segments = quote_provenance(logical_line, tokens, spans)\n        except Exception:\n            literal = [[False] * len(token) for token in tokens]\n            segments = None\n        if literal is None or len(literal) != len(tokens):\n            literal = [[False] * len(token) for token in tokens]\n            segments = None\n        elif segments is not None and len(segments) != len(tokens):\n            segments = None\n        if segments is None:\n            spans = []\n        current_literal = []\n        current_segments = [] if segments is not None else None\n        token_owners = {}\n        for index, token in enumerate(tokens):\n            if token in DELIMS or token in ('(', ')') or (token in ('{', '}') and not current and not any(literal[index])):\n                if current:\n                    groups.append(CommandGroup(current, literal_chars=current_literal, quote_segments=current_segments))\n                current = []\n                current_literal = []\n                current_segments = [] if segments is not None else None\n                groups.append(CommandGroup([], boundary=token))\n            else:\n                token_owners[index] = len(groups)\n                current.append(token)\n                current_literal.append(literal[index])\n                if current_segments is not None:\n                    current_segments.append(segments[index])\n        if current:\n            groups.append(CommandGroup(current, literal_chars=current_literal, quote_segments=current_segments))\n        ops = heredoc_ops(logical_line)\n        if ops is False:\n            groups.append(CommandGroup([], error='incomplete shell syntax'))\n        elif ops:\n            owners = [g for g in groups[line_group_start:] if g] or [g for g in groups if g]\n            if not owners:\n                owners = [CommandGroup([])]\n            for source_offset, word, quoted in ops:\n                owner = None\n                for i, (start, end) in enumerate(spans):\n                    if start <= source_offset < end and i in token_owners:\n                        owner = groups[token_owners[i]]\n                        break\n                if owner is None:\n                    groups.append(CommandGroup([], error='cannot locate heredoc owner'))\n                    owner = owners[-1]\n                heredocs.append((owner, word, quoted))\n            if heredocs:\n                receiver, heredoc_end, quoted = heredocs.pop(0)\n                receiver.expanding_body = not quoted\n        if tokens and tokens[-1] not in ('&&', '||', '|'):\n            groups.append(CommandGroup([], boundary=';'))\n    if pending or heredoc_end:\n        groups.append(CommandGroup([], error='incomplete shell syntax'))\n    attach_pipe_sources(groups)\n    return groups\n\n\ndef command_groups(command):\n    records = command_records(command)\n    if any(group.error for group in records):\n        # Keep every physical command visible to denylists after a lex error.\n        return [part.split() for line in shell_text(command).splitlines()\n                for part in re.split(r'[;&|()]', line) if part.split()]\n    return [group for group in records if group]\n\ndef without_redirection_indices(group):\n    result = []\n    index = 0\n    while index < len(group):\n        token = group[index]\n        redirect = re.match(r'^(?:[0-9]+|&)?(?:>\\||>>?|<>|<<-?|<)(.*)$', token)\n        if redirect:\n            attached = redirect.group(1)\n            if attached in ('', '&'):\n                index += 1\n            elif attached.startswith('<'):\n                if attached == '<':\n                    index += 1\n        else:\n            result.append(index)\n        index += 1\n    return result\n\ndef without_redirections(group):\n    return [group[i] for i in without_redirection_indices(group)]\n\nWRAPPER_VALUE_OPTIONS = {\n    'env': {'-u', '--unset', '-C', '--chdir', '-a', '--argv0'},\n    'sudo': {'-u', '--user', '-g', '--group', '-h', '--host', '-p', '--prompt',\n             '-C', '-T', '-R', '-D', '-r', '-t', '-U', '--chdir', '--chroot',\n             '--role', '--type', '--other-user', '--close-from', '--command-timeout'},\n    'exec': {'-a'},\n    'nice': {'-n', '--adjustment'},\n    'ionice': {'-c', '--class', '-n', '--classdata', '-p', '--pid', '-P', '-u', '--pgid', '--uid'},\n    'stdbuf': {'-i', '-o', '-e', '--input', '--output', '--error'},\n    'timeout': {'-k', '--kill-after', '-s', '--signal'},\n    'xargs': {'-n', '-L', '-P', '-I', '-J', '-d', '-s', '-E', '--max-args', '--max-lines',\n              '--max-procs', '--replace', '--delimiter'},\n    'caffeinate': {'-t', '-w'},\n    'doas': {'-u', '-C'},\n    'flock': {'-w', '--timeout', '-E', '--conflict-exit-code', '-c', '--command'},\n    'chrt': {'-T', '-P', '-D'},\n    'taskset': {'-c', '--cpu-list'},\n    'script': {'-t', '-F', '-c', '--command', '-I', '-O', '-B', '-T', '-E', '-m',\n               '--log-in', '--log-out', '--log-io', '--log-timing', '--timing', '--output-limit'},\n    'watch': {'-n', '--interval'},\n    'su': {'-c', '--command', '-s', '--shell'},\n}\n\nWRAPPER_POSITIONAL = {'timeout': 1, 'flock': 1, 'chrt': 1, 'taskset': 1, 'script': 1}\n\ndef consume_wrapper(group, index, base):\n    index += 1\n    value_options = WRAPPER_VALUE_OPTIONS.get(base, set())\n    positional = WRAPPER_POSITIONAL.get(base, 0)\n    while index < len(group) and group[index].startswith('-'):\n        option = group[index]\n        index += 1\n        if base == 'command' and option in ('-v', '-V'):\n            return len(group)\n        if option == '--':\n            break\n        if option in value_options and index < len(group):\n            index += 1\n        if base == 'taskset' and (option == '-c' or option.startswith('--cpu-list')):\n            positional = 0\n    return index + positional\n\ndef wrapper_basename(token):\n    return os.path.basename(token[1:] if token.startswith('=') else token)\n\ndef strip_prefix_offset(group):\n    index = 0\n    while index < len(group):\n        token = group[index]\n        base = wrapper_basename(token)\n        if ASSIGNMENT_RE.match(token):\n            index += 1\n        elif base in WRAPPERS:\n            index = consume_wrapper(group, index, base)\n        else:\n            break\n    return index\n\ndef expand_env_split_string(tokens):\n    out, index = [], 0\n    while index < len(tokens):\n        token = tokens[index]\n        out.append(token)\n        index += 1\n        if wrapper_basename(token) != 'env':\n            continue\n        while index < len(tokens) and tokens[index].startswith('-'):\n            option = tokens[index]\n            if option in ('-S', '--split-string') and index + 1 < len(tokens):\n                out.extend(shlex.split(tokens[index + 1]))\n                out.extend(tokens[index + 2:])\n                return out\n            if option.startswith('--split-string='):\n                out.extend(shlex.split(option.split('=', 1)[1]))\n                out.extend(tokens[index + 1:])\n                return out\n            if option.startswith('-S') and option != '-S':\n                out.extend(shlex.split(option[2:]))\n                out.extend(tokens[index + 1:])\n                return out\n            out.append(option)\n            index += 1\n            if option in WRAPPER_VALUE_OPTIONS.get('env', set()) and index < len(tokens):\n                out.append(tokens[index])\n                index += 1\n            if option == '--':\n                break\n    return out\n\ndef strip_prefixes(group):\n    stripped = expand_env_split_string(without_redirections(list(group)))\n    return stripped[strip_prefix_offset(stripped):]\n\ndef wrapper_has_xargs(group):\n    tokens = without_redirections(group)\n    end = min(strip_prefix_offset(tokens), len(tokens))\n    return any(wrapper_basename(tokens[i]) == 'xargs' for i in range(end))\n\ndef strip_prefix_indices(group):\n    kept = without_redirection_indices(group)\n    start = strip_prefix_offset([group[i] for i in kept])\n    return kept[start:]\n\ndef write_redirection_targets(group):\n    targets, index = [], 0\n    while index < len(group):\n        token = group[index]\n        fd = 0\n        while fd < len(token) and token[fd].isdigit():\n            fd += 1\n        rest = token[fd:]\n        op = None\n        for candidate in ('&>>', '&>', '>>', '>|', '>'):\n            if rest.startswith(candidate):\n                op = candidate\n                break\n        if op is None:\n            index += 1\n            continue\n        attached = rest[len(op):]\n        if attached:\n            targets.append(attached)\n        elif index + 1 < len(group):\n            targets.append(group[index + 1])\n            index += 1\n        index += 1\n    return targets\n\ndef here_string_body(group):\n    for index, token in enumerate(group):\n        if token == '<<<' and index + 1 < len(group):\n            return group[index + 1]\n        if token.startswith('<<<') and len(token) > 3:\n            return token[3:]\n    return ''\n\nclass _PipeLevel:\n    def __init__(self):\n        self.all_cmds = []\n        self.pipeline = []\n        self.pending_pipe = False\n        self.inherited = []\n\ndef attach_pipe_sources(records):\n    stack = [_PipeLevel()]\n    for group in records:\n        group.pipe_sources = []\n        level = stack[-1]\n        boundary = group.boundary\n        if boundary in ('(', '{'):\n            inner = _PipeLevel()\n            if level.pending_pipe:\n                inner.inherited = list(level.pipeline)\n                level.pending_pipe = False\n            stack.append(inner)\n            continue\n        if boundary in (')', '}'):\n            inner = stack.pop()\n            if not stack:\n                stack.append(_PipeLevel())\n            outer = stack[-1]\n            producers = inner.inherited + inner.all_cmds\n            outer.all_cmds.extend(producers)\n            if outer.pending_pipe:\n                outer.pipeline.extend(producers)\n            else:\n                outer.pipeline = list(producers)\n            continue\n        if boundary in ('|', '|&'):\n            level.pending_pipe = True\n            continue\n        if boundary:\n            if boundary.strip():\n                level.pipeline = []\n                level.pending_pipe = False\n            continue\n        if not group:\n            continue\n        sources = list(level.inherited)\n        if level.pending_pipe:\n            sources.extend(level.pipeline)\n            level.pipeline.append(group)\n            level.pending_pipe = False\n        else:\n            level.pipeline = [group]\n        group.pipe_sources = sources\n        level.all_cmds.append(group)\n\ndef decode_ansi_c(text):\n    simple = {'n': chr(10), 't': chr(9), 'r': chr(13), 'a': chr(7), 'b': chr(8), 'e': chr(27),\n              'E': chr(27), 'f': chr(12), 'v': chr(11), chr(92): chr(92), chr(39): chr(39),\n              chr(34): chr(34), '?': '?'}\n    widths = {'x': 2, 'u': 4, 'U': 8}\n    out, i = [], 0\n    while i < len(text):\n        c = text[i]\n        if c != chr(92) or i + 1 >= len(text):\n            out.append(c)\n            i += 1\n            continue\n        d = text[i + 1]\n        if d in simple:\n            out.append(simple[d])\n            i += 2\n        elif d in widths:\n            digits = re.match('[0-9a-fA-F]*', text[i + 2:i + 2 + widths[d]]).group()\n            if digits:\n                out.append(chr(int(digits, 16)))\n            else:\n                out.append(c + d)\n            i += 2 + len(digits)\n        elif d in '01234567':\n            digits = re.match('[0-7]{1,3}', text[i + 1:]).group()\n            out.append(chr(int(digits, 8) % 256))\n            i += 1 + len(digits)\n        else:\n            out.append(c + d)\n            i += 2\n    return ''.join(out)\n\ndef is_arithmetic_inner(text):\n    if not text.startswith('('):\n        return False\n    try:\n        return extract_substitutions(text, start=1, stop=')', kind='probe')['end'] == len(text) - 1\n    except ValueError:\n        return False\n\ndef extract_substitutions(source, holders=None, scripts=None, ariths=None, start=0, stop=None, kind='command'):\n    # Replace dollar-paren, backtick, and process-substitution scripts with\n    # globally numbered placeholders so nested checks share one holder registry.\n    if holders is None:\n        holders = []\n    if scripts is None:\n        scripts = set()\n    if ariths is None:\n        ariths = []\n    if kind == 'command' and start == 0 and stop is None:\n        source = strip_line_continuations(source)\n    quotes, subs_on, command = kind != 'literal', kind != 'probe', kind == 'command'\n    n = len(source)\n    out, subs, pending = [], [], []\n    quote, depth, found = None, 0, False\n    word_start, arith_until, i = True, 0, start\n    blanks = ' ' + chr(9) + chr(10) + chr(13) + ';&|('\n    while i < n:\n        c = source[i]\n        if c == chr(92) and quote != chr(39):\n            if source[i + 1:i + 2] == chr(10):\n                i += 2\n                continue\n            out.append(source[i:i + 2])\n            i += 2\n            word_start = False\n            continue\n        if command and quote is None and word_start and c == '#':\n            end = source.find(chr(10), i)\n            i = n if end < 0 else end\n            continue\n        if stop == chr(96) and c == chr(96):\n            found = True\n            break\n        if stop == ')' and quote is None and c in '()':\n            if c == '(':\n                depth += 1\n            elif depth == 0:\n                found = True\n                break\n            else:\n                depth -= 1\n        if quotes and c in (chr(39), chr(34)) and quote in (None, c):\n            quote = None if quote else c\n            out.append(c)\n            i += 1\n            word_start = False\n            continue\n        if quotes and quote is None and c == chr(36) and source[i + 1:i + 2] == chr(34):\n            i += 1\n            word_start = False\n            continue\n        if quotes and quote is None and c == chr(36) and source[i + 1:i + 2] == chr(39):\n            end = i + 2\n            while end < n and source[end] != chr(39):\n                end += 2 if source[end] == chr(92) else 1\n            if end >= n:\n                raise ValueError('unterminated ANSI-C quote')\n            decoded = decode_ansi_c(source[i + 2:end]).replace(chr(39), chr(39) + chr(92) + chr(39) + chr(39))\n            out.append(chr(39) + decoded + chr(39))\n            i = end + 1\n            word_start = False\n            continue\n        if subs_on and quote != chr(39) and (c == chr(96) or source.startswith(chr(36) + '(', i)\n                or (quote is None and source.startswith('<(', i))):\n            if c == chr(96):\n                inner = extract_substitutions(source, holders, scripts, ariths, i + 1, chr(96))\n                j = inner['end']\n                text = source[i + 1:j]\n                subs.append(text)\n            else:\n                s, arithmetic = i + 2, False\n                if source.startswith('((', i + 1):\n                    inner = extract_substitutions(source, holders, scripts, ariths, s, ')', 'probe')\n                    j = inner['end']\n                    text = source[s:j]\n                    arithmetic = is_arithmetic_inner(text)\n                if arithmetic:\n                    nested = extract_substitutions(text, holders, scripts, ariths, 0, None, 'arith')\n                    subs.extend(nested['subs'])\n                    ariths.append(text)\n                else:\n                    inner = extract_substitutions(source, holders, scripts, ariths, s, ')')\n                    j = inner['end']\n                    text = source[s:j]\n                    subs.append(text)\n            if source.startswith('<(', i):\n                scripts.add(len(holders))\n            holders.append(text)\n            out.append('__indirect_pid_' + str(len(holders) - 1) + '__')\n            i = j + 1\n            word_start = False\n            continue\n        if command and quote is None and word_start and i >= arith_until and source.startswith('((', i):\n            try:\n                inner = extract_substitutions(source, holders, scripts, ariths, i + 2, ')', 'probe')\n                j = inner['end']\n                if source[j + 1:j + 2] == ')':\n                    ariths.append(source[i + 2:j])\n                    arith_until = j + 2\n            except ValueError:\n                pass\n        if command and quote is None and c == '<' and i >= arith_until and source.startswith('<<', i):\n            if source.startswith('<<<', i):\n                out.append('<<<')\n                i += 3\n                word_start = False\n                continue\n            j = i + 2\n            strip = j < n and source[j] == '-'\n            j += 1 if strip else 0\n            while j < n and source[j] in ' ' + chr(9):\n                j += 1\n            parsed = heredoc_word(source[j:])\n            if not parsed:\n                raise ValueError('unrecognised heredoc delimiter')\n            delimiter, quoted, consumed = parsed\n            end = j + consumed\n            pending.append((delimiter, strip, quoted))\n            out.append(source[i:end])\n            i = end\n            word_start = False\n            continue\n        if command and quote is None and c == chr(10):\n            out.append(chr(10))\n            i += 1\n            for delimiter, strip, quoted in pending:\n                body = []\n                while True:\n                    if i >= n:\n                        raise ValueError('unterminated heredoc')\n                    end = source.find(chr(10), i)\n                    end = n if end < 0 else end\n                    line = source[i:end]\n                    i = end + 1\n                    if (line.lstrip(chr(9)) if strip else line) == delimiter:\n                        out.append(line)\n                        if end < n:\n                            out.append(chr(10))\n                        break\n                    if quoted:\n                        out.append(line)\n                    else:\n                        nested = extract_substitutions(line, holders, scripts, ariths, 0, None, 'literal')\n                        out.append(nested['out'])\n                        subs.extend(nested['subs'])\n                    out.append(chr(10))\n            pending = []\n            word_start = True\n            continue\n        out.append(c)\n        i += 1\n        if quote is None:\n            word_start = c in blanks\n    if stop is not None and not found:\n        raise ValueError('unterminated command substitution')\n    if pending:\n        raise ValueError('unterminated heredoc')\n    return {'out': ''.join(out), 'subs': subs, 'holders': holders, 'ariths': ariths,\n            'scripts': scripts, 'end': i}\n# Embedded in the always-on launch guard for every driver. Reuse its shell\n# tokenizer; this fragment must contain no shell double quotes, backticks,\n# dollars or backslashes because the enclosing command uses double quotes.\nSIGNAL_REASON = ('Blocked unsafe process signalling: pkill/killall select processes by '\n                 'name or pattern, and kill with indirect PIDs, process groups or broad '\n                 'targets can terminate other workers. Stop only processes you started '\n                 'yourself using explicit positive numeric PIDs (for example, the PID '\n                 'captured from ' + chr(36) + '! when starting your process), or wait '\n                 'for or time out your own command.')\n\nSIG_NL, SIG_TAB, SIG_SQ, SIG_DQ = chr(10), chr(9), chr(39), chr(34)\nSIG_BT, SIG_BS, SIG_DOLLAR = chr(96), chr(92), chr(36)\nSIG_BANG = (SIG_DOLLAR + '!', SIG_DOLLAR + '{!}')\nSIG_IDENT = re.compile('[A-Za-z_][A-Za-z0-9_]*')\nSIG_ASSIGN = re.compile('^([A-Za-z_][A-Za-z0-9_]*)([+]?)=(.*)', re.S)\nSIG_NAME = re.compile('(?<![A-Za-z_])(pkill|killall)(?![A-Za-z_])')\nSIG_KILL_WORD = re.compile('(?<![A-Za-z_])(kill|pkill|killall)(?![A-Za-z_])')\nSIG_HOLDER = re.compile('__indirect_pid_([0-9]+)__')\nSIG_VARIABLE = re.compile(re.escape(SIG_DOLLAR) + '(?:[{]([A-Za-z_][A-Za-z0-9_]*)[}]|([A-Za-z_][A-Za-z0-9_]*))')\nSIG_PARAM = re.compile(re.escape(SIG_DOLLAR) + '[{]([A-Za-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_}])')\nSIG_ARITH_SET = re.compile('([A-Za-z_][A-Za-z0-9_]*)[ ]*(?:[-+*/%&|^]|<<|>>)?=(?!=)')\nSIG_ARITH_STEP = re.compile('([A-Za-z_][A-Za-z0-9_]*)[ ]*(?:[+][+]|--)|(?:[+][+]|--)[ ]*([A-Za-z_][A-Za-z0-9_]*)')\nSIG_WORD_STEP = re.compile('([A-Za-z_][A-Za-z0-9_]*)(?:[+][+]|--)|[+][+]([A-Za-z_][A-Za-z0-9_]*)')\nSIG_SHELLS = ('bash', 'sh', 'zsh', 'dash', 'ksh')\nSIG_DECLARERS = ('export', 'declare', 'typeset', 'local', 'readonly')\nSIG_BINDERS = ('read', 'mapfile', 'readarray', 'getopts', 'for', 'select', 'unset', 'wait')\nSIG_EVALUATORS = ('let', 'eval', 'source', '.')\nSIG_KEYWORDS = ('!', '{', '}', 'then', 'do', 'if', 'elif', 'while', 'until', 'else')\n\ndef signal_shell_operands(words):\n    i = 0\n    while i < len(words):\n        word = words[i]\n        if word == '--':\n            return words[i+1:]\n        if word in ('-o', '+o', '-O', '+O', '--rcfile', '--init-file'):\n            i += 2\n        elif word[:1] in ('-', '+'):\n            i += 1\n        else:\n            return words[i:]\n    return []\n\ndef signal_operand(words):\n    return signal_shell_operands(words)[:1]\n\ndef signal_launcher_strings(words):\n    if not words:\n        return []\n    _, base = signal_program(words[0])\n    if base in SIG_SHELLS or base in ('su', 'flock', 'script'):\n        return signal_cstrings(words[1:])\n    if base == 'watch':\n        extra = words[1:]\n        while extra and extra[0].startswith('-'):\n            extra = extra[2:] if extra[0] in ('-n', '--interval') else extra[1:]\n        return [' '.join(extra)]\n    return []\n\ndef signal_cstrings(words):\n    # Shell command strings handed to a launcher with -c or --command.\n    found = []\n    for i, word in enumerate(words):\n        if word.startswith('--command='):\n            found.append(word.split('=', 1)[1])\n        elif i + 1 < len(words) and (word == '--command' or (\n                word.startswith('-') and not word.startswith('--') and 'c' in word)):\n            found.extend(signal_operand(words[i+1:]))\n    return found\n\ndef signal_program(word):\n    if word.startswith('='):\n        word = word[1:]\n    return word, os.path.basename(word)\n\ndef signal_split_heredocs(group):\n    # A heredoc attached to its command (cat<<EOF) is one shell word; split the\n    # unquoted operator off so the program and its redirections read normally.\n    masks = getattr(group, 'literal_chars', None) or []\n    words = []\n    for i, word in enumerate(group):\n        mask = masks[i] if i < len(masks) else [True] * len(word)\n        at = word.find('<<')\n        if at > 0 and not any(mask[at:at+2]) and word[at+2:at+3] != '<' and (\n                word[at-1] not in '<>&' and not re.fullmatch('[0-9]+', word[:at])):\n            words.extend([word[:at], word[at:]])\n        else:\n            words.append(word)\n    return words\n\ndef signal_argv(group):\n    # Assignments, xargs provenance and wrapper peeling come from the shared\n    # tokenizer so launch-guard and signal-guard see the same program.\n    words = without_redirections(signal_split_heredocs(group))\n    rest = words\n    assigns, strings = [], []\n    indirect = False\n    while rest:\n        indirect = indirect or wrapper_has_xargs(rest)\n        peeled = strip_prefixes(rest)\n        stop = len(rest) - len(peeled)\n        for i, token in enumerate(rest[:stop]):\n            match = SIG_ASSIGN.match(token)\n            if match:\n                assigns.append((match.group(1), match.group(2) == '+', match.group(3)))\n            strings.extend(signal_launcher_strings(rest[i:]))\n        rest = peeled\n        if not rest:\n            break\n        program, base = signal_program(rest[0])\n        match = SIG_ASSIGN.match(rest[0])\n        if match:\n            assigns.append((match.group(1), match.group(2) == '+', match.group(3)))\n            rest = rest[1:]\n            continue\n        if base in SIG_KEYWORDS:\n            rest = rest[1:]\n            continue\n        if base == 'coproc':\n            rest = rest[1:]\n            if len(rest) > 1 and rest[1] == '{':\n                rest = rest[1:]\n            continue\n        if base == 'function':\n            rest = rest[2:]\n            continue\n        rest = [program] + rest[1:]\n        break\n    strings.extend(signal_launcher_strings(rest))\n    return rest, indirect, strings, assigns\n\ndef signal_kill(args, indirect, captures):\n    if args and args[0] in ('-l', '-L', '--list', '--table'):\n        return\n    if indirect or not args:\n        _block(SIGNAL_REASON)\n    if args[0] in ('-s', '-n', '--signal'):\n        args = args[2:]\n    elif args[0].startswith('--signal='):\n        args = args[1:]\n    elif args[0].startswith('-') and args[0] != '--':\n        # A lone negative argument (notably kill -1) is never an explicit PID.\n        args = args[1:]\n    if args and args[0] == '--':\n        args = args[1:]\n    # pid_t is signed 32-bit on worker hosts; prevent positive literals from\n    # wrapping into a process group or the all-processes sentinel.\n    def valid(pid):\n        if pid in SIG_BANG:\n            return True\n        if pid.startswith(SIG_DOLLAR) and pid[1:].strip('{}') in captures:\n            return True\n        return re.fullmatch('[0-9]+', pid) and 0 < int(pid) <= 2147483647\n    if not args or not all(valid(pid) for pid in args):\n        _block(SIGNAL_REASON)\n\ndef signal_shell(args):\n    return args and os.path.basename(signal_program(args[0])[0]) in SIG_SHELLS\n\ndef signal_stdin(args):\n    # A shell reads its commands from stdin unless given -c or a script file.\n    rest = args[1:]\n    if any(a.startswith('-') and not a.startswith('--') and 'c' in a for a in rest):\n        return False\n    operands = signal_shell_operands(rest)\n    return not operands or operands[0] in ('/dev/stdin', '/dev/fd/0', '-') or any(\n        a.startswith('-') and not a.startswith('--') and 's' in a for a in rest)\n\ndef signal_script_file(args):\n    _, base = signal_program(args[0])\n    if not (base in SIG_SHELLS or base in ('source', '.')):\n        return None\n    if signal_cstrings(args[1:]):\n        return None\n    operands = signal_shell_operands(args[1:])\n    return operands[0] if operands else None\n\ndef signal_text(text, depth, values=None, unknown=None, holders=None, scripts=None, ariths=None, written=None):\n    # Inspect text that a shell will later read. Text that cannot be parsed is\n    # still refused when it names the forbidden programs.\n    try:\n        signal_check(text, depth, values, unknown, holders, scripts, ariths, written)\n    except ValueError:\n        if SIG_NAME.search(text):\n            _block(SIGNAL_REASON)\n\ndef signal_arith_names(text):\n    names = {m.group(1) for m in SIG_ARITH_SET.finditer(text)}\n    names.update(m.group(1) or m.group(2) for m in SIG_ARITH_STEP.finditer(text))\n    return names\n\ndef signal_writes(group, args):\n    # Names a command may rebind in the current shell, over-approximated.\n    names = set()\n    for k, word in enumerate(group):\n        names.update(m.group(1) for m in SIG_PARAM.finditer(word))\n        if SIG_IDENT.fullmatch(word) and k + 1 < len(group) and group[k+1].startswith(\n                ('=', '+=', '-=', '*=', '/=', '%=', '++', '--')):\n            names.add(word)\n        names.update(m.group(1) or m.group(2) for m in [SIG_WORD_STEP.fullmatch(word)] if m)\n    if args:\n        _, base = signal_program(args[0])\n        rest = args[1:]\n        if base in SIG_BINDERS:\n            names.update(w for w in rest if SIG_IDENT.fullmatch(w))\n        elif base == 'printf':\n            for k, word in enumerate(rest):\n                if word == '-v' and k + 1 < len(rest):\n                    names.add(rest[k+1])\n                elif word.startswith('-v') and len(word) > 2:\n                    names.add(word[2:])\n        elif base in SIG_EVALUATORS:\n            names.update(SIG_IDENT.findall(' '.join(rest)))\n    return names\n\ndef signal_decode(text, operand=False, fallback=None):\n    out, index = [], 0\n    escapes = dict(zip('abefnrtv', map(chr, (7, 8, 27, 12, 10, 13, 9, 11))))\n    escapes[SIG_BS] = SIG_BS\n    while index < len(text):\n        char = text[index]\n        index += 1\n        if char != SIG_BS or index == len(text):\n            out.append(char)\n            continue\n        char = text[index]\n        index += 1\n        if char == 'c':\n            return ''.join(out), True\n        if char in escapes:\n            out.append(escapes[char])\n            continue\n        digits, base, limit = '', 8, 3\n        if char == 'x':\n            base, limit = 16, 2\n        elif char in '01234567':\n            digits = '' if operand and char == '0' else char\n            limit -= len(digits)\n        else:\n            # Unknown shell-specific escapes cannot hide a signalling word.\n            if SIG_KILL_WORD.search(text if fallback is None else fallback):\n                return 'pkill' + SIG_NL, False\n            out.extend((SIG_BS, char))\n            continue\n        alphabet = '0123456789abcdef'[:base]\n        while limit and index < len(text) and text[index].lower() in alphabet:\n            digits += text[index]\n            index += 1\n            limit -= 1\n        if digits:\n            out.append(chr(int(digits, base)))\n        elif SIG_KILL_WORD.search(text if fallback is None else fallback):\n            return 'pkill' + SIG_NL, False\n        else:\n            out.extend((SIG_BS, char))\n    return ''.join(out), False\n\ndef signal_output(group):\n    content = getattr(group, 'body', '')\n    if content:\n        return content\n    if here_string_body(group):\n        return here_string_body(group) + SIG_NL\n    args, _, _, _ = signal_argv(group)\n    if not args:\n        return ''\n    _, base = signal_program(args[0])\n    if base == 'echo':\n        words = args[1:]\n        expanding, newline = True, SIG_NL\n        while words and re.fullmatch('-[neE]+', words[0]):\n            if 'E' in words[0]:\n                expanding = False\n            if 'e' in words[0]:\n                expanding = True\n            newline = '' if 'n' in words[0] else newline\n            words = words[1:]\n        text = ' '.join(words)\n        decoded, stopped = signal_decode(text, True) if expanding else (text, False)\n        return decoded + ('' if stopped else newline)\n    if base == 'printf' and len(args) > 1:\n        if args[1] == '%s':\n            return ''.join(args[2:])\n        if args[1] == '%b':\n            out = []\n            for item in args[2:]:\n                decoded, stopped = signal_decode(item, True, ''.join(args[2:]))\n                out.append(decoded)\n                if stopped:\n                    break\n            return ''.join(out)\n        if args[1] == '%s' + SIG_BS + 'n':\n            return ''.join(item + SIG_NL for item in args[2:])\n        if '%' not in args[1]:\n            return signal_decode(args[1])[0]\n    if SIG_KILL_WORD.search(signal_chain_text(group)):\n        return 'pkill' + SIG_NL\n    return ''\n\ndef signal_redirects(group, writing):\n    found = []\n    group = signal_split_heredocs(group)\n    for i, token in enumerate(group):\n        pattern = '^(?:[0-9]+|&)?(>>|>[|]?)(.*)' if writing else '^(?:0)?(<)([^<].*|)'\n        match = re.fullmatch(pattern, token)\n        if not match and writing:\n            # cat <<EOF>out.txt: the redirection follows the heredoc word.\n            match = re.fullmatch('^(?:[0-9]+)?<<-?[^<>]+(>>|>[|]?)(.+)', token)\n        if match:\n            path = match.group(2) or (group[i+1] if i + 1 < len(group) else '')\n            if path:\n                found.append((path, match.group(1) == '>>'))\n    return found\n\ndef signal_chain_text(upstream):\n    parts = list(upstream)\n    body = getattr(upstream, 'body', '') or ''\n    here = here_string_body(upstream)\n    return ' '.join(parts) + ' ' + body + ' ' + here\n\ndef signal_check(source, depth=0, inherited=None, unknown=None, holders=None, scripts=None, ariths=None, written=None):\n    if depth > 40:\n        _block(SIGNAL_REASON + ' Shell nesting is too deep to inspect safely.')\n    if holders is None:\n        holders = []\n    if scripts is None:\n        scripts = set()\n    if ariths is None:\n        ariths = []\n    if written is None:\n        written = {}\n    scan = extract_substitutions(source, holders, scripts, ariths)\n    records = command_records(scan['out'])\n    if any(group.error for group in records):\n        raise ValueError(next(group.error for group in records if group.error))\n    groups = [group for group in records if group]\n    parsed = [signal_argv(group) for group in groups]\n\n    # Provenance is decided over the whole command: a name holds a captured PID\n    # only if every write to it is a pure assignment of the background PID.\n    values = {name: set(items) for name, items in (inherited or {}).items()}\n    writes, first, rebound = {}, {}, set()\n    for index, group in enumerate(groups):\n        args, _, _, assigns = parsed[index]\n        for name, plus, value in assigns:\n            if plus:\n                rebound.add(name)\n            pure = not args and not plus and value in SIG_BANG\n            writes.setdefault(name, []).append(pure)\n            if not plus:\n                values.setdefault(name, set()).add(value)\n            if pure:\n                first.setdefault(name, index)\n        if args and signal_program(args[0])[1] in SIG_DECLARERS:\n            for word in args[1:]:\n                match = SIG_ASSIGN.match(word)\n                if match:\n                    writes.setdefault(match.group(1), []).append(False)\n                    if not match.group(2):\n                        values.setdefault(match.group(1), set()).add(match.group(3))\n                elif SIG_IDENT.fullmatch(word):\n                    writes.setdefault(word, []).append(False)\n                    rebound.add(word)\n        rebound |= signal_writes(group, args)\n    for text in scan['ariths']:\n        rebound |= signal_arith_names(text)\n    # Check every raw identifier occurrence, including nested commands and data.\n    # Arithmetic writes and namerefs revoke provenance without a syntax allowlist.\n    def pure_occurrences(name):\n        occurrence = re.compile('(?<![A-Za-z0-9_])' + re.escape(name) + '(?![A-Za-z0-9_])')\n        for match in occurrence.finditer(source):\n            before, after = source[:match.start()], source[match.end():]\n            capture = any(after.startswith('=' + bang) for bang in SIG_BANG)\n            plain = before.endswith(SIG_DOLLAR) or (\n                before.endswith(SIG_DOLLAR + '{') and after.startswith('}'))\n            if not capture and not plain:\n                return False\n        return True\n    qualified = {name for name in first if name not in rebound and all(writes[name])\n                 and pure_occurrences(name)}\n    mentions = SIG_NAME.search(source)\n    unknown = dict(unknown or {})\n    for name in rebound:\n        unknown[name] = unknown.get(name, False) or bool(mentions)\n\n    def inspect(text, hops=0):\n        # Expand recorded command-string variables without executing the shell.\n        if hops >= 8:\n            _block(SIGNAL_REASON + ' Variable indirection is too deep to inspect safely.')\n        variable = re.search(re.escape(SIG_DOLLAR) + '([{]?[A-Za-z_][A-Za-z0-9_]*[}]?)', text)\n        if variable:\n            name = variable.group(1).strip('{}')\n            if name in values and not unknown.get(name, False):\n                for value in sorted(values[name]):\n                    inspect(text[:variable.start()] + value + text[variable.end():], hops + 1)\n                return\n        signal_text(text, depth+1, values, unknown, holders, scripts, ariths, written)\n\n    def input_words(text):\n        rewritten = extract_substitutions(text, holders, scripts, ariths)['out']\n        for group in command_records(rewritten):\n            if not group:\n                continue\n            for word in group:\n                inspect(word)\n\n    def lookup_holder(index):\n        if index < 0 or index >= len(holders):\n            _block(SIGNAL_REASON)\n        return holders[index]\n\n    def dispatch(group, args, indirect, chain, hops, captures):\n        if not args:\n            return\n        program = args[0]\n        variables = list(SIG_VARIABLE.finditer(program))\n        for variable in variables:\n            name = variable.group(1) or variable.group(2)\n            if unknown.get(name, False):\n                _block(SIGNAL_REASON)\n            if name in values:\n                if hops >= 8:\n                    _block(SIGNAL_REASON + ' Variable indirection is too deep to inspect safely.')\n                for value in sorted(values[name]):\n                    expanded = program[:variable.start()] + value + program[variable.end():]\n                    # Conservatively inspect field splitting as well when quote provenance\n                    # is unavailable after recursive expansion.\n                    positions = [i for i, word in enumerate(group) if word == program]\n                    masks = getattr(group, 'literal_chars', [])\n                    quoted = bool(positions and masks and all(\n                        masks[positions[0]][variable.start():variable.end()]))\n                    shapes = [[expanded]] if quoted else [expanded.split()]\n                    if not positions or not masks or getattr(group, 'quote_segments', None) is None:\n                        shapes.append([expanded])\n                    for fields in shapes:\n                        inner, inner_indirect, inner_strings, _ = signal_argv(fields + args[1:])\n                        for string in inner_strings:\n                            inspect(string)\n                        dispatch(group, inner, indirect or inner_indirect, chain, hops + 1, captures)\n                return\n        if variables:\n            for string in signal_cstrings(args[1:]):\n                inspect(string)\n        program, base = signal_program(program)\n        args = [program] + args[1:]\n        for match in SIG_HOLDER.finditer(program):\n            if SIG_NAME.search(lookup_holder(int(match.group(1)))):\n                _block(SIGNAL_REASON)\n        parts = SIG_VARIABLE.sub(chr(0), SIG_HOLDER.sub(chr(0), program)).split(chr(0))\n        if len(parts) > 1 and any(len(p) > 1 and (p in 'pkill' or p in 'killall' or p in 'kill') for p in parts):\n            _block(SIGNAL_REASON)\n        if base in ('pkill', 'killall'):\n            _block(SIGNAL_REASON + ' Refused command: ' + base + '.')\n        if base == 'kill':\n            signal_kill(args[1:], indirect, captures)\n        if base == 'find':\n            for k, word in enumerate(args):\n                if word in ('-exec', '-execdir', '-ok', '-okdir'):\n                    command = []\n                    for item in args[k+1:]:\n                        if item in (';', '+'):\n                            break\n                        command.append(item)\n                    inner, inner_indirect, inner_strings, _ = signal_argv(command)\n                    for string in inner_strings:\n                        inspect(string)\n                    dispatch(group, inner, inner_indirect, chain, hops, captures)\n        if base == 'eval':\n            inspect(' '.join(args[1:]))\n        if base == 'trap':\n            action, i = args[1:], 0\n            while i < len(action):\n                if action[i] == '--':\n                    i += 1\n                    break\n                if action[i] in ('-p', '-l'):\n                    action = []\n                    break\n                if action[i].startswith('-'):\n                    i += 1\n                    continue\n                break\n            if i < len(action):\n                inspect(action[i])\n        if signal_shell(args) or base in ('source', '.'):\n            for word in args[1:]:\n                for match in SIG_HOLDER.finditer(word):\n                    index = int(match.group(1))\n                    if index in scan['scripts']:\n                        input_words(lookup_holder(index))\n            path = signal_script_file(args)\n            if path:\n                inspect_written(path)\n        inspect_written(program)\n        if signal_shell(args):\n            if signal_stdin(args):\n                for path, _ in signal_redirects(group, False):\n                    inspect_written(path)\n                if getattr(group, 'body', ''):\n                    inspect(group.body)\n                here = here_string_body(group)\n                if here:\n                    inspect(here)\n                if chain:\n                    for upstream in chain:\n                        if SIG_KILL_WORD.search(signal_chain_text(upstream)):\n                            _block(SIGNAL_REASON)\n                        if getattr(upstream, 'body', ''):\n                            inspect(upstream.body)\n                        here = here_string_body(upstream)\n                        if here:\n                            inspect(here)\n                        for word in upstream:\n                            inspect(word)\n            for string in signal_cstrings(args[1:]):\n                inspect(string)\n\n    def inspect_written(path):\n        key = os.path.normpath(path)\n        for content in tuple(written.get(key, set())):\n            inspect(content)\n\n    for index, group in enumerate(groups):\n        args, indirect, strings, _ = parsed[index]\n        content = getattr(group, 'body', '') or (\n            here_string_body(group) + SIG_NL if here_string_body(group) else '')\n        targets = signal_redirects(group, True)\n        if args:\n            _, base = signal_program(args[0])\n            if base in ('echo', 'printf'):\n                content = signal_output(group)\n            if base == 'tee':\n                targets.extend((word, '-a' in args or '--append' in args)\n                               for word in args[1:] if not word.startswith('-'))\n            if not content:\n                content = ''.join(signal_output(upstream)\n                                  for upstream in getattr(group, 'pipe_sources', []))\n            if not content and SIG_KILL_WORD.search(' '.join(args)):\n                content = 'pkill' + SIG_NL\n        for target, append in targets:\n            key = os.path.normpath(target)\n            variants = written.setdefault(key, set())\n            additions = {prior + content for prior in variants | {''}} if append else {content}\n            variants.update(additions)\n\n    # Deferred actions and conditional writes can observe any recorded variant.\n    for index, group in enumerate(groups):\n        args, indirect, strings, _ = parsed[index]\n        for string in strings:\n            inspect(string)\n        captures = {name for name in qualified if first[name] < index}\n        dispatch(group, args, indirect, getattr(group, 'pipe_sources', []), 0, captures)\n\n    # Substitutions run before or during the commands that contain them, so\n    # check them once every script written by this command is on record.\n    for substitution in scan['subs']:\n        signal_check(substitution, depth+1, values, unknown, holders, scripts, ariths, written)\n    for group in groups:\n        if group.body and group.expanding_body:\n            nested = extract_substitutions(group.body, holders, scripts, ariths, 0, None, 'literal')\n            for substitution in nested['subs']:\n                signal_check(substitution, depth+1, values, unknown, holders, scripts, ariths, written)\n\ntry:\n    signal_check(cmd)\nexcept Exception as error:\n    _block(SIGNAL_REASON + ' Cannot safely parse this shell command: ' + str(error))\nPROD='/tmp/boss-engine.sock'\nASSIGN=re.compile(r'^([A-Za-z_][A-Za-z0-9_]*)=(.*)$', re.S)\nvars={}\nfor k in ('BOSS_BIN','CUBE_BIN','CHECKLEFT_BIN','BOSS_BIN_DIR','BOSS_WORKER_BIN_DIR'):\n    v=os.environ.get(k)\n    if v:\n        vars[k]=v\ndef expand(t):\n    keys=sorted(vars, key=len, reverse=True)\n    for k in keys:\n        t=t.replace('$'+'{'+k+'}',vars[k]).replace('$'+k,vars[k])\n    return t\ngroups=[]\nfor g in command_groups(cmd):\n    resolved=[]\n    for t in g:\n        m=ASSIGN.match(t)\n        if m:\n            vars[m.group(1)]=expand(m.group(2))\n        resolved.append(expand(t))\n    groups.append(resolved)\ndef socket_arg(g):\n    for j,t in enumerate(g):\n        if t=='--socket-path' and j+1<len(g):\n            return g[j+1]\n        if t.startswith('--socket-path='):\n            return t.split('=',1)[1]\n    return None\ndef is_bundle_cli(p):\n    d=os.path.dirname(os.path.normpath(p))\n    return d.endswith('/Contents/Resources/bin')\ndef guard_handoff(rest):\n    if rest and os.path.basename(rest[0])=='boss':\n        j=1\n        while j<len(rest) and rest[j].startswith('-'):\n            j += 2 if rest[j] in ('--socket-path','--engine-max-wait') else 1\n        if j<len(rest) and rest[j]=='handoff':\n            _block('Blocked: boss handoff is coordinator-only; workers cannot read or mutate the coordinator handoff. If this blocks your task, use '+chr(34)+chr(36)+'BOSS_BIN'+chr(34)+' propose blocked --reason '+chr(34)+'<specific question>'+chr(34)+'.')\nmatched=None\nfor g in groups:\n    rest=strip_prefixes(g)\n    if not rest:\n        continue\n    prog=rest[0]\n    base=os.path.basename(prog)\n    guard_handoff(rest)\n    if base in ('Boss','engine','boss-engine','bossctl'):\n        matched=prog\n        break\n    if 'Boss.app' in prog and not is_bundle_cli(prog):\n        matched=prog\n        break\n    if base=='boss' and len(rest)>=3 and rest[1]=='engine' and rest[2] in ('start','stop'):\n        matched=prog+' engine '+rest[2]\n        break\n    if base=='open':\n        joined=' '.join(rest)\n        if 'Boss.app' in joined or 'dev.spinyfin.bossmacapp' in joined or re.search(r'(^| )-a +Boss( |$)',joined):\n            matched=joined[:120]\n            break\n    if base in ('bazel','bazelisk') and len(rest)>1 and rest[1]=='run':\n        joined=' '.join(rest)\n        if 'tools/boss/app-macos' in joined:\n            sock=vars.get('BOSS_SOCKET_PATH')\n            auto=vars.get('BOSS_ENGINE_AUTOSTART')\n            if (sock is None or os.path.normpath(sock)==PROD\n                    or 'Library/Application Support/Boss' in sock or auto!='0'):\n                matched='bazel run of an app-macos target without an isolating BOSS_SOCKET_PATH and BOSS_ENGINE_AUTOSTART=0'\n                break\n        if 'tools/boss/engine' in joined:\n            sp=socket_arg(rest)\n            if sp is None or os.path.normpath(sp)==PROD or 'Library/Application Support/Boss' in sp:\n                matched='bazel run of an engine target without an isolating --socket-path'\n                break\n    if base=='swift' and len(rest)>1 and rest[1]=='run':\n        matched='swift run'\n        break\nif matched:\n    msg=('Blocked: this would start Boss itself (matched: '+matched+'). Workers must not launch the installed /Applications/Boss.app or an engine that can reach production state on this machine -- the