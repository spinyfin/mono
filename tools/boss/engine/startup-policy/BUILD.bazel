load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "startup-policy",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_startup_policy",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = [
        "//tools/boss/engine/app:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/dispatch:__pkg__",
        "//tools/boss/engine/live-worker-state:__pkg__",
    ],
)

rust_test(
    name = "startup-policy_test",
    size = "small",
    crate = ":startup-policy",
    edition = "2024",
)
