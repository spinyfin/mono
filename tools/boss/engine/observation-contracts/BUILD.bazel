load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "observation-contracts",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_observation_contracts",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/completion:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/merge-poller:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/work-db",
        "//tools/boss/engine/worker-bin",
        "//tools/boss/github",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_library(
    name = "observation_contracts_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
    },
    crate_name = "boss_observation_contracts",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/completion:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/merge-poller:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/work-db:work_db_test_support",
        "//tools/boss/engine/worker-bin",
        "//tools/boss/github",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "observation_contracts_test",
    size = "small",
    crate = ":observation-contracts",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)
