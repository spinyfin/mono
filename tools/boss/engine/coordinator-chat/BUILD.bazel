load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Coordinator chat conversation reducer and credential redaction.
# No other target links this crate yet, so its visibility is private; widen it
# to specific consumers when they are added.
rust_library(
    name = "coordinator-chat",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["testdata/*.jsonl"]),
    crate_name = "boss_engine_coordinator_chat",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:private"],
    deps = [
        "//tools/boss/acp_client",
        "//tools/boss/agent-host:agent_host",
        "//tools/boss/engine/utils",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "coordinator-chat_test",
    size = "small",
    compile_data = glob(["testdata/*.jsonl"]),
    crate = ":coordinator-chat",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/acp_client",
        "//tools/boss/agent-host:agent_host",
        "//tools/boss/engine/utils",
        "//tools/boss/protocol",
        "@mono_crates//:tempfile",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
