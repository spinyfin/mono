load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "driver-home-retention",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_driver_home_retention",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/agy-home-retention:__pkg__",
        "//tools/boss/engine/codex-rollout-retention:__pkg__",
        "//tools/boss/engine/coordinator-chat:__pkg__",
        "//tools/boss/engine/grok-home-retention:__pkg__",
    ],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "driver-home-retention_test",
    size = "small",
    crate = ":driver-home-retention",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
