load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "timer-wheel",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_timer_wheel",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = [
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/event-bus",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "timer-wheel_test",
    size = "small",
    crate = ":timer-wheel",
    edition = "2024",
    deps = [
        "//tools/boss/engine/event-bus",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
