load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "boothby-executor",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_boothby_executor",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/app:__pkg__"],
    deps = [
        "//tools/boss/engine/work-db",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

# The engine's test build compiles against the fixture variant of the storage
# crate, so the executor the app embeds must be built against the same variant
# for the `WorkDb` types to unify.
rust_library(
    name = "boothby_executor_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {"//tools/boss/engine/work-db:work_db_test_support": "boss_work_db"},
    crate_name = "boss_engine_boothby_executor_test_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/app:__pkg__"],
    deps = [
        "//tools/boss/engine/work-db:work_db_test_support",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "boothby_executor_test",
    size = "small",
    aliases = {
        "//tools/boss/engine/work-db": "boss_work_db_production",
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
    },
    crate = ":boothby-executor",
    edition = "2024",
    env = {"HOME": "/tmp"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = ["//tools/boss/engine/work-db:work_db_test_support"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
