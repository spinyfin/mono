load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "progression-brief",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_progression_brief",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/execution-runner:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/ci-log-reader",
        "//tools/boss/engine/conflict-diagnosis",
        "//tools/boss/engine/storage-values",
        "//tools/boss/engine/work-db",
        "//tools/boss/github",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_library(
    name = "progression_brief_test_support",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
    },
    crate_name = "boss_progression_brief_test_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/execution-runner:__pkg__",
    ],
    deps = [
        "//tools/boss/engine/ci-log-reader",
        "//tools/boss/engine/conflict-diagnosis",
        "//tools/boss/engine/storage-values",
        "//tools/boss/engine/work-db:work_db_test_support",
        "//tools/boss/github",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "progression-brief_test",
    size = "small",
    aliases = {
        "//tools/boss/engine/work-db": "boss_work_db_production",
        "//tools/boss/engine/work-db:work_db_test_support": "boss_work_db",
    },
    crate = ":progression-brief",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/engine/ci-log-reader",
        "//tools/boss/engine/conflict-diagnosis",
        "//tools/boss/engine/storage-values",
        "//tools/boss/engine/work-db:work_db_test_support",
        "//tools/boss/github",
        "//tools/boss/protocol",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
