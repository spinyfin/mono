load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

exports_files(
    ["jj_repository.bzl"],
    visibility = ["//tools/cube:__pkg__"],
)

rust_library(
    name = "recovery",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_recovery",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/app:__pkg__",
        "//tools/boss/engine/completion:__pkg__",
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/dispatch:__pkg__",
        "//tools/boss/engine/execution-contracts:__pkg__",
        "//tools/boss/engine/execution-runner:__pkg__",
        "//tools/boss/engine/host-execution:__pkg__",
        "//tools/boss/engine/merge-poller:__pkg__",
        "//tools/boss/engine/recovery-fixtures:__pkg__",
        "//tools/boss/engine/spoke-adapter:__pkg__",
        "//tools/boss/engine/work-db:__pkg__",
    ],
    deps = ["//lib/rust/git_utils"] + all_crate_deps(normal = True),
)

# The same suite against the oldest and the newest supported jj (see
# //tools/cube/docs/jj-compatibility.md).
[
    rust_test(
        name = name,
        size = "medium",
        # Every bookmark/reconcile test drives a real `jj` subprocess against a
        # scratch repo. Observed on the linux-amd64 CI runners over 60 recent
        # main builds: p50 25 s, max 57 s against small's 60 s default budget;
        # locally on an Apple Silicon dev box the whole target takes 12 s.
        # Keep the moderate (300 s) timeout and medium size for loaded CI hosts.
        timeout = "moderate",
        crate = ":recovery",
        data = [jj],
        edition = "2024",
        env = {"BOSS_JJ_BIN": "$(rootpath {})".format(jj)},
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
            proc_macro_dev = True,
        ),
        # The jj 0.46 twin is manual-only (skipped by `//...` wildcard runs, still
        # runnable by explicit label) since 2026-11-20: jj 0.46's store rewrite
        # forces a whole-drive flush (F_FULLFSYNC) per operation file on macOS
        # and saturates the shared remote workers. Re-enable once the 0.46 suite
        # is made cheap (its GC fixture is being shrunk separately).
        tags = ["manual"] if name.endswith("_jj_046_test") else [],
        deps = [
            "//tools/boss/engine/test-git",
        ] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for name, jj in [
        ("recovery_test", "@jj_test_tools//:jj"),
        ("recovery_jj_046_test", "@jj_upgrade_test_tools//:jj"),
    ]
]

# Share the pinned recovery fixture tool without widening its repository exports.
filegroup(
    name = "jj_test_binary",
    testonly = True,
    srcs = ["@jj_test_tools//:jj"],
    visibility = [
        "//tools/boss/engine/completion:__pkg__",
        "//tools/boss/engine/host-execution:__pkg__",
    ],
)
