load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "recovery",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_recovery",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/core:__pkg__",
        "//tools/boss/engine/host-execution:__pkg__",
        "//tools/boss/engine/work-db:__pkg__",
    ],
    deps = [
        "//lib/rust/git_utils",
        "//tools/boss/log-files",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "recovery_test",
    size = "medium",
    # Every bookmark/reconcile test drives a real `jj` subprocess against a
    # scratch repo. Observed on the linux-amd64 CI runners over 60 recent
    # main builds: p50 25 s, max 57 s against small's 60 s default budget;
    # locally on an Apple Silicon dev box the whole target takes 12 s.
    # Keep the moderate (300 s) timeout and medium size for loaded CI hosts.
    timeout = "moderate",
    crate = ":recovery",
    data = ["@jj_test_tools//:jj"],
    edition = "2024",
    env = {"BOSS_JJ_BIN": "$(rootpath @jj_test_tools//:jj)"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//lib/rust/git_utils",
        "//tools/boss/engine/test-git",
        "//tools/boss/log-files",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Share the pinned recovery fixture tool without widening its repository exports.
filegroup(
    name = "jj_test_binary",
    testonly = True,
    srcs = ["@jj_test_tools//:jj"],
    visibility = ["//tools/boss/engine/host-execution:__pkg__"],
)
