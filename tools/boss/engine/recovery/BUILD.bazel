load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "recovery",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_engine_recovery",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/core:__pkg__",
    ],
    deps = [
        "//tools/boss/log-files",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "recovery_test",
    size = "small",
    crate = ":recovery",
    data = ["@jj_test_tools//:jj"],
    edition = "2024",
    env = {"BOSS_JJ_BIN": "$(rootpath @jj_test_tools//:jj)"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/engine/test-git",
        "//tools/boss/log-files",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
