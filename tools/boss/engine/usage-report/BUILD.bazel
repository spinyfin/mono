load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Seed history for isolated engines. The work database's test applies it to a
# freshly migrated schema, so it cannot drift from the schema or from the cases
# the usage rows request has to render.
filegroup(
    name = "token_usage_seed_sql",
    srcs = ["fixtures/token-usage-seed.sql"],
    visibility = ["//tools/boss/engine/work-db:__pkg__"],
)

rust_library(
    name = "usage-report",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_usage_report",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss/engine/app:__pkg__",
        "//tools/boss/engine/work-db:__pkg__",
    ],
    deps = [
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "usage-report_test",
    size = "small",
    crate = ":usage-report",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/protocol",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
