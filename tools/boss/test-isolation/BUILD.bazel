load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    "boss_rust_test.bzl",
])

rust_library(
    name = "test-isolation",
    srcs = ["src/lib.rs"],
    crate_name = "boss_test_isolation",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    # Every `rust_test` target under tools/boss/** links this via the
    # `boss_rust_test` macro (see boss_rust_test.bzl) — deliberately scoped
    # to the whole tree rather than an enumerated allowlist, since that is
    # this crate's entire purpose. Production targets (the `engine` binary,
    # `bossctl`, the `boss` CLI) must never depend on it directly.
    visibility = ["//tools/boss:__subpackages__"],
    deps = [
        "//tools/boss/log-files",
    ] + all_crate_deps(normal = True),
)

# Deliberately a plain `rust_test`, not `boss_rust_test`: this target
# recompiles this very crate with `--cfg test` (`crate = ":test-isolation"`),
# so the ctor under test is already linked into the resulting binary. Adding
# `//tools/boss/test-isolation` to its own `deps` (what `boss_rust_test`
# would do) would pull in a second, un-`--cfg test` copy of the same crate
# name and fail to compile. The `boss/raw-rust-test-forbidden` checkleft
# check (tools/boss/CHECKS.yaml) excludes this one file for exactly this
# reason.
rust_test(
    name = "test-isolation_test",
    size = "small",
    crate = ":test-isolation",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//tools/boss/log-files",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
