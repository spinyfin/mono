load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "boss-event",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    # Bundled in the Boss engine/app; stamp = 0 so --config=release does not
    # feed stable-status.txt into this rustc action on every release tag.
    stamp = 0,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "boss-event_test",
    size = "small",
    crate = ":boss-event",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The engine contract test checks the independently compiled ingress limits.
exports_files(
    ["src/main.rs"],
    visibility = ["//tools/boss/engine/core:__pkg__"],
)
