load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//tools/boss/engine/core:engine_binary.bzl",
    "ENGINE_BINARY_BUNDLE_FRAGMENT",
    "ENGINE_BINARY_NAME",
)
load(":pkg.bzl", "boss_pkg_payload", "boss_pkg_unsigned", "boss_short_version_plist", "build_info_rs", "build_provenance_rs")
load(":stamp.bzl", "stamp_flag", "stamp_inputs_analysis_test")

package(default_visibility = ["//visibility:private"])

# The set of binaries bundled inside Boss.app/Contents/Resources/bin/.
# cube is bundled here so that the engine can find it even when the macOS GUI
# launchd PATH excludes the user's shell PATH (~/bin, /opt/homebrew/bin, etc.).
# Workers run inside Ghostty terminal panes and inherit the user's shell PATH,
# so they continue to resolve cube (and jj, gh, claude, etc.) from PATH — only
# the engine needs the bundled copy.
filegroup(
    name = "bundled_binaries",
    srcs = [
        "//tools/boss/bossctl",
        "//tools/boss/cli:boss",
        "//tools/boss/engine/core:engine",
        "//tools/boss/event-shim:boss-event",
        "//tools/cube",
    ],
)

filegroup(
    name = "installer_scripts",
    srcs = glob(["scripts/*"]),
)

# Canonical engine binary name for release.sh, sourced from
# engine_binary.bzl so codesigning targets the same file that
# bundled_binaries and //tools/boss/app-macos:Boss actually build.
genrule(
    name = "engine_binary_name_txt",
    outs = ["engine_binary_name.txt"],
    cmd = "echo -n '%s' > $@" % ENGINE_BINARY_NAME,
    visibility = ["//visibility:private"],
)

# Staged payload directory: Boss.app/ tree with bundled binaries in
# Contents/Resources/bin/ (binaries are included via additional_contents
# on the macos_application rule in //tools/boss/app-macos:Boss).
boss_pkg_payload(
    name = "boss_pkg_payload",
    app = "//tools/boss/app-macos:Boss",
)

# Regression coverage against the real bundle layout (not a tempdir mock):
# asserts the staged Boss.app payload actually contains a regular file at
# Contents/Resources/bin/$ENGINE_BINARY_NAME, at the path
# ENGINE_BINARY_BUNDLE_FRAGMENT describes. Fails on a rename of either the
# engine binary (ENGINE_BINARY_NAME) or the bundle's bin/ directory
# (ENGINE_BINARY_BUNDLE_FRAGMENT) that isn't reflected in the payload the
# macos_application rule actually produces.
sh_test(
    name = "boss_pkg_payload_contains_engine_binary_test",
    # A file-existence check inside an already-built payload; well under a
    # second on CI.
    size = "small",
    srcs = ["boss_pkg_payload_contains_engine_binary_test.sh"],
    args = [
        "$(location :boss_pkg_payload)/Boss.app/%s" % ENGINE_BINARY_BUNDLE_FRAGMENT,
    ],
    data = [":boss_pkg_payload"],
)

# Unsigned .pkg installer.  Output: boss_pkg_unsigned/Boss-<sha>.pkg.
# Requires --config=release to embed the git SHA in the filename; without
# --stamp the output is Boss-unknown.pkg.
#
# Done criteria reference (design doc Q4 Phase 1 + Phase 2):
#   Phase 1 — Bazel produces the binaries (this rule + boss_pkg_payload)
#   Phase 2 — workspace-status.sh threads the git SHA into the filename
boss_pkg_unsigned(
    name = "boss_pkg_unsigned",
    distribution = "distribution.xml",
    payload = ":boss_pkg_payload",
    scripts = ":installer_scripts",
)

# config_setting + provider so Starlark rules can observe `--stamp`
# (bazelbuild/bazel#11164). Private to this package except the flag
# target, which stamp-aware rules depend on via STAMP_ATTRS.
config_setting(
    name = "stamp_detect",
    values = {"stamp": "1"},
)

stamp_flag(
    name = "stamp_flag",
    value = select({
        ":stamp_detect": True,
        "//conditions:default": False,
    }),
    visibility = ["//tools/boss:__subpackages__"],
)

# Stamped Rust constants file consumed ONLY by the `boss-build-info` leaf
# crate (never engine_lib / runtime / app). Unstamped (the default) writes
# a constant 0.0.0-dev placeholder and does not read stable-status.txt, so
# a new boss-v* tag does not rebuild engine libraries or their tests.
# `--config=release` (`--stamp`) embeds STABLE_BOSS_BASE_VERSION; a new
# tag then recompiles the leaf crate and relinks boss / bossctl / engine.
build_info_rs(
    name = "build_info_rs",
    out = "build_info_generated.rs",
    visibility = ["//tools/boss/build-info:__pkg__"],
)

# Deterministic stable-status fixture for build_info_stamp_test so stamped
# assertions verify exact tag-derived values regardless of local git tags.
genrule(
    name = "stable_status_fixture",
    testonly = True,
    outs = ["stable_status_fixture.txt"],
    cmd = "printf 'STABLE_BOSS_BASE_VERSION 1.0.42\\nSTABLE_BOSS_VERSION 1.0.42-dev-abc1234\\n' > $@",
)

# Always-stamped sibling of :build_info_rs, used only by
# build_info_stamp_test / //tools/boss/build-info:build-info-stamped to
# assert a --stamp build embeds the tag-derived version rather than the
# placeholder. Not on the production library/test graph.
build_info_rs(
    name = "build_info_rs_stamped",
    testonly = True,
    out = "build_info_stamped.rs",
    stamp = 1,
    status_file = ":stable_status_fixture",
    visibility = ["//tools/boss/build-info:__pkg__"],
)

# Plist counterparts of the two build_info_rs targets above. The
# production plist lives on //tools/boss/app-macos:boss_version_plist;
# these exist so the stamp test can compare unstamped vs always-stamped
# output without pulling the macOS app graph.
boss_short_version_plist(
    name = "version_plist_unstamped",
    testonly = True,
    out = "BossVersionUnstamped.plist",
)

boss_short_version_plist(
    name = "version_plist_stamped",
    testonly = True,
    out = "BossVersionStamped.plist",
    stamp = 1,
    status_file = ":stable_status_fixture",
)

sh_test(
    name = "build_info_stamp_test",
    size = "small",
    srcs = ["build_info_stamp_test.sh"],
    args = [
        "$(location :build_info_rs)",
        "$(location :build_info_rs_stamped)",
        "$(location :version_plist_unstamped)",
        "$(location :version_plist_stamped)",
        "$(location //tools/boss/cli:boss)",
        "$(location //tools/boss/bossctl)",
        "$(location :build_provenance_rs)",
        "$(location //tools/boss/build-info:version_probe)",
        "$(location //tools/boss/build-info:version_probe_stamped)",
        "$(location //tools/boss/engine/core:engine_fixture_test)",
    ],
    data = [
        ":build_info_rs",
        ":build_info_rs_stamped",
        ":build_provenance_rs",
        ":version_plist_stamped",
        ":version_plist_unstamped",
        "//tools/boss/bossctl",
        "//tools/boss/build-info:version_probe",
        "//tools/boss/build-info:version_probe_stamped",
        "//tools/boss/cli:boss",
        "//tools/boss/engine/core:engine_fixture_test",
    ],
)

# Positive-control targets for stamp_inputs_analysis_test (reading real
# stable-status.txt rather than the test fixture).
build_info_rs(
    name = "build_info_rs_stamped_default_status",
    testonly = True,
    out = "build_info_stamped_default_status.rs",
    stamp = 1,
)

boss_short_version_plist(
    name = "version_plist_stamped_default_status",
    testonly = True,
    out = "BossVersionStampedDefaultStatus.plist",
    stamp = 1,
)

# Structural regression guards: unstamped build_info_rs and version plist
# must never take stable-status.txt as an action input (tag-change cache
# stability); stamped counterparts must (positive control).
stamp_inputs_analysis_test(
    name = "build_info_rs_unstamped_no_status_input_test",
    expect_input = False,
    target_under_test = ":build_info_rs",
)

stamp_inputs_analysis_test(
    name = "version_plist_unstamped_no_status_input_test",
    expect_input = False,
    target_under_test = ":version_plist_unstamped",
)

stamp_inputs_analysis_test(
    name = "build_info_rs_stamped_has_status_input_test",
    expect_input = True,
    target_under_test = ":build_info_rs_stamped_default_status",
)

stamp_inputs_analysis_test(
    name = "version_plist_stamped_has_status_input_test",
    expect_input = True,
    target_under_test = ":version_plist_stamped_default_status",
)

# Stamped Rust constants file consumed ONLY by the `boss-build-provenance`
# crate (never engine_lib directly) — see that crate's BUILD.bazel and
# pkg.bzl's `build_provenance_rs` doc comment for why a value that changes
# on every commit/build lives here instead of in `build_info_rs` above.
build_provenance_rs(
    name = "build_provenance_rs",
    out = "build_provenance_generated.rs",
    visibility = ["//tools/boss/build-provenance:__pkg__"],
)

# Always-stamped sibling of :build_provenance_rs, the positive control for
# the analysis tests below.
build_provenance_rs(
    name = "build_provenance_rs_stamped",
    testonly = True,
    out = "build_provenance_stamped.rs",
    stamp = 1,
)

# The wall-clock build time is in volatile-status.txt, whose content differs
# on every build. An unstamped build_provenance_rs must not take it as an
# input: its output would then differ every time the action ran, relinking
# both engine binaries at an unchanged commit, and no remote cache entry
# could match. A stamped (release) build embeds the time.
stamp_inputs_analysis_test(
    name = "build_provenance_rs_unstamped_no_build_time_input_test",
    expect_input = False,
    status_file = "volatile-status.txt",
    target_under_test = ":build_provenance_rs",
)

stamp_inputs_analysis_test(
    name = "build_provenance_rs_stamped_has_build_time_input_test",
    expect_input = True,
    status_file = "volatile-status.txt",
    target_under_test = ":build_provenance_rs_stamped",
)

# Human-facing release driver (design doc Q4 Phase 3).
# Signs, notarizes, and staples the Boss installer .pkg.
#
# Full release:
#   bazel run //tools/boss/installer:release --config=release
#
# CI / sign-only (no notarization):
#   bazel run //tools/boss/installer:release --config=release -- --skip-notary
#
# Required env vars: BOSS_DEVELOPER_ID_APPLICATION, BOSS_DEVELOPER_ID_INSTALLER
# See release.sh header for notarization credentials documentation.
sh_binary(
    name = "release",
    srcs = ["release.sh"],
    data = [
        # boss_pkg_unsigned provides the SHA-stamped .pkg filename.
        ":boss_pkg_unsigned",
        # boss_pkg_payload provides the staged Boss.app tree (with bundled
        # binaries) that release.sh signs before rebuilding the .pkg.
        ":boss_pkg_payload",
        # Pre/postinstall scripts for pkgbuild --scripts.
        ":installer_scripts",
        # Entitlements files for codesign invocations.
        "entitlements/app.entitlements",
        "entitlements/engine.entitlements",
        # Distribution XML for productbuild (per-user domain configuration).
        "distribution.xml",
        # Canonical engine binary name, so codesigning stays in sync with
        # the name //tools/boss/engine/core:engine actually builds.
        ":engine_binary_name_txt",
    ],
    visibility = ["//visibility:public"],
)
