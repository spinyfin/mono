load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "bossctl_lib",
    srcs = [
        "src/agents.rs",
        "src/agents_tests.rs",
        "src/command_types.rs",
        "src/comments.rs",
        "src/dispatch_concurrency.rs",
        "src/dispatch_stats.rs",
        "src/doctor.rs",
        "src/doctor_spawn.rs",
        "src/doctor_tests.rs",
        "src/enrollment.rs",
        "src/enrollment_tests.rs",
        "src/focus.rs",
        "src/homes.rs",
        "src/host_load.rs",
        "src/hosts.rs",
        "src/lib.rs",
        "src/logs.rs",
        "src/pause.rs",
        "src/probe.rs",
        "src/progression.rs",
        "src/proposals.rs",
        "src/review.rs",
        "src/selected_product.rs",
        "src/stream_integrity.rs",
        "src/stuck_report.rs",
        "src/tests.rs",
        "src/traffic_split.rs",
        "src/work_wait.rs",
        "src/work_wait_tests.rs",
    ],
    crate_name = "bossctl",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//tools/boss/engine/core:__pkg__"],
    deps = [
        "//tools/boss/backoff",
        "//tools/boss/client",
        "//tools/boss/command-runner",
        "//tools/boss/engine/core:engine_lib",
        "//tools/boss/engine/execution-contracts",
        "//tools/boss/engine/host-enrollment",
        "//tools/boss/github",
        "//tools/boss/log-files",
        "//tools/boss/protocol",
    ] + all_crate_deps(normal = True),
)

rust_binary(
    name = "bossctl",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    # Version comes from the boss_build_info leaf crate, not from this
    # crate's own compile. stamp = 0 so --config=release does not feed
    # stable-status.txt into this rustc action; a new tag recompiles the
    # leaf and relinks this binary over the cached bossctl_lib.
    stamp = 0,
    visibility = ["//visibility:public"],
    deps = [
        ":bossctl_lib",
        "//tools/boss/build-info",
    ],
)

rust_test(
    name = "bossctl_test",
    size = "small",
    crate = ":bossctl_lib",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    visibility = ["//tools/boss/engine/core:__pkg__"],
    deps = [
        "//tools/boss/backoff",
        "//tools/boss/client",
        "//tools/boss/command-runner",
        "//tools/boss/engine/core:engine_lib",
        "//tools/boss/engine/execution-contracts",
        "//tools/boss/engine/host-enrollment",
        "//tools/boss/github",
        "//tools/boss/log-files",
        "//tools/boss/protocol",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "review_show_test",
    size = "small",
    srcs = ["tests/review_show.rs"],
    data = [":bossctl"],
    edition = "2024",
    env = {"BOSSCTL_TEST_BINARY": "$(rootpath :bossctl)"},
    deps = [
        "//tools/boss/engine/core:engine_lib",
        "//tools/boss/protocol",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "review_start_test",
    size = "small",
    srcs = ["tests/review_start.rs"],
    data = [":bossctl"],
    edition = "2024",
    env = {"BOSSCTL_TEST_BINARY": "$(rootpath :bossctl)"},
    deps = [
        "//tools/boss/engine/core:engine_lib",
        "//tools/boss/protocol",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "work_wait_test",
    size = "medium",
    srcs = ["tests/work_wait.rs"],
    data = [":bossctl"],
    edition = "2024",
    env = {"BOSSCTL_TEST_BINARY": "$(rootpath :bossctl)"},
    deps = ["//tools/boss/protocol"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Production sources scanned by `//tools/boss/engine/core:tmux_only_surface_test`,
# the architecture guard for the tmux-only local-pane invariant.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//tools/boss/engine/core:__pkg__"],
)
