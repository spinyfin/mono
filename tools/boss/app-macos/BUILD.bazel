# TestSourcesDoNotCallRealOpenerTests.swift (included by the catch-all
# glob below) scans all BossTests sources for banned real-OS-opener APIs. Under
# `swift test`/Xcode it does that scan at test *runtime* using `#filePath`, but
# `bazel test` compiles Swift with `-file-prefix-pwd-is-dot`, which rewrites
# `#filePath` to a build-relative path that doesn't match the runtime cwd —
# scanning at runtime under bazel silently finds nothing. So under bazel we
# instead run the same scan as a build action, over the real `srcs` Bazel
# resolved, and bake the result into a generated Swift file the test asserts
# against (selected via the BOSS_BAZEL_TEST_BUILD compile condition below).
genrule(
    name = "generate_real_opener_scan",
    srcs = glob(
        ["Tests/BossTests/**/*.swift"],
        exclude = ["Tests/BossTests/TestSourcesDoNotCallRealOpenerTests.swift"],
    ),
    outs = ["GeneratedRealOpenerScanResult.swift"],
    cmd = "bash $(location Tests/BossTests/scan_for_real_openers.sh) $(SRCS) > $@",
    tools = ["Tests/BossTests/scan_for_real_openers.sh"],
)

# Same build-action pattern, pointed at the production sources: flags any
# report-only modal (a SwiftUI `.alert(isPresented:)` or `NSAlert` with
# fewer than two buttons, or any `.alert` driven by `workErrorMessage`) so
# a non-actionable status/error message can never regain a modal dialog.
# ReportOnlyAlertScanTests.swift asserts on the result; the rule is spelled
# out in tools/boss/app-macos/AGENTS.md.
genrule(
    name = "generate_report_only_alert_scan",
    srcs = glob(
        ["Sources/**/*.swift"],
        exclude = ["Sources/EngineBinaryName.swift"],
    ),
    outs = ["GeneratedReportOnlyAlertScanResult.swift"],
    cmd = "bash $(location Tests/BossTests/scan_for_report_only_alerts.sh) $(SRCS) > $@",
    tools = ["Tests/BossTests/scan_for_report_only_alerts.sh"],
)

