# Live Swift source `include_str!`'d by engine_lib so the combined
# park+churn marker cannot drift from WorkDispatchFailureBanner.
filegroup(
    name = "work_board_banners_swift",
    srcs = ["Sources/WorkBoardBanners.swift"],
    visibility = ["//tools/boss/engine/core:__pkg__"],
)

swift_library(
    name = "boss_mac_app_lib",
    # CrashWatchdog is excluded so it is only ever compiled as its own module
    # (matching Package.swift's `exclude:`); leaving it in the glob would give
    # the app a second, shadowing copy of the type it imports.
    #
    # Sources/EngineBinaryName.swift is excluded too: it's a checked-in copy
    # of the genrule output below, kept in the tree only so SwiftPM/Xcode
    # (which never see bazel genrules) can compile it. Bazel itself keeps
    # compiling the genrule's output as the single source of truth; the
    # checked-in copy is verified byte-identical to it by
    # :engine_binary_name_swift_up_to_date_test.
    srcs = glob(
        ["Sources/**/*.swift"],
        exclude = [
            "Sources/CrashWatchdog/**/*.swift",
            "Sources/EngineBinaryName.swift",
        ],
    ) + [":engine_binary_name_swift"],
    copts = [
        # Mirror the swiftSettings define in Package.swift so @inlinable
        # Textual APIs (e.g. .textual.textSelection) expand correctly here.
        "-DTEXTUAL_ENABLE_TEXT_SELECTION",
        # Match Package.swift's `swift-tools-version: 6.2`. Without this,
        # bazel compiles under the rules_swift default (Swift 5 mode) and
        # silently skips the strict-concurrency diagnostics that
        # `swift run` would fire. CI then passes on changes that break
        # the dev workflow — see #601 (LogViewer.swift global formatter)
        # for a recent example.
        "-swift-version",
        "6",
        "-strict-concurrency=complete",
    ],
    module_name = "Boss",
    deps = [
        "//tools/boss/app-macos/Sources/CrashWatchdog",
        "//tools/boss/app-macos/Sources/DiagnosticIO",
        "//tools/boss/app-macos/Sources/PaneLayout",
        "//tools/boss/app-macos/Sources/UpdateCore",
        "@ghostty_kit//:GhosttyKit",
        "@swiftpkg_textual//:Textual",
    ],
)

genrule(
    name = "engine_binary_name_swift",
    outs = ["EngineBinaryName.swift"],
    cmd = "cat > $@ <<'EOF'\n%sEOF" % _ENGINE_BINARY_SWIFT_SOURCE,
    visibility = ["//visibility:private"],
)

# Guards the checked-in Sources/EngineBinaryName.swift (needed so
# SwiftPM/Xcode builds resolve `BossEngineBinary` — they never see bazel
# genrules) against drifting from the genrule above, which stays the single
# source of truth for bazel builds. Fails the moment the two disagree, e.g.
# because ENGINE_BINARY_NAME or another engine_binary.bzl constant changed
# without the checked-in copy being regenerated.
sh_test(
    name = "engine_binary_name_swift_up_to_date_test",
    # A byte comparison of two small files in bash; about one second on CI.
    size = "small",
    srcs = ["engine_binary_name_swift_up_to_date_test.sh"],
    args = [
        "$(location Sources/EngineBinaryName.swift)",
        "$(location :engine_binary_name_swift)",
    ],
    data = [
        "Sources/EngineBinaryName.swift",
        ":engine_binary_name_swift",
    ],
)

# Independent bundles keep each test action inside the small (60s) timeout.
# The macOS runner does not implement Bazel's shard_count protocol, so each
# partition must be a separate macos_unit_test target.
#
# CommentsTests.swift + TranscriptViewTests.swift are split into their own
# shard because CommentLayerTests alone accounts for ~85% of total XCTest
# runtime (~12.8s of ~14.9s measured locally); bundling it with anything else
# risks that shard alone approaching the timeout. MarkdownDocumentChromeTests
# is its own shard: bundled with the other AppKit render suites it reached
# 26.8 s of XCTest wall (57.0 s bazel wall) in an isolated uncached run, which
# is too close to the 60 s budget. The remaining table-overflow and revision-
# footer suites stay in the Render shard. The remaining files are split into
# the explicit source groups below plus a catch-all that is distributed
# across four further bundles. Every new test file is included automatically.
#
# When a shard creeps towards its budget, measure before moving files:
# `bazel test --nocache_test_results --test_verbose_timeout_warnings
# //tools/boss/app-macos:BossTestsShard3`, then read the per-suite
# "Test Suite '...' passed at" timestamps in bazel-testlogs/.../test.log.
# Keep each shard's isolated local wall time inside the 60 s budget with
# enough slack that a slow sample still finishes. Isolated uncached in this
# workspace after the Chrome split (`bazel test --nocache_test_results
# --test_verbose_timeout_warnings`, PASSED-in test action wall, three
# consecutive runs): Chrome 3.0 / 3.3 / 3.0 s, Render 6.0 / 5.9 / 5.9 s,
# Shard3 4.8 / 4.8 / 4.7 s. Slowest sample 6.0 s (Render), 10× under the
# 60 s budget.
#
# The shared principal is compiled into every bundle: it is the bundle's
# NSPrincipalClass, which XCTest instantiates before the first test runs, and
# it installs the missing-review-section assertion before XCTest starts. See
# BossTestsPrincipal.swift and Tests/BossTests/Info.plist.
_BOSS_TESTS_PRINCIPAL_SRCS = ["Tests/BossTests/BossTestsPrincipal.swift"]

