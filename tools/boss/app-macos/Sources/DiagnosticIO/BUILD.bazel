    name = "DiagnosticIO",
    srcs = ["DiagnosticWrite.swift"],
    module_name = "DiagnosticIO",
    visibility = [
        "//tools/boss/app-macos:__pkg__",
        "//tools/boss/app-macos/Sources/UpdateCore:__pkg__",
    ],
)
