load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "boss_protocol",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//tools/boss:__subpackages__",
    ],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "protocol_test",
    size = "small",
    crate = ":protocol",
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Production sources scanned by `//tools/boss/engine/core:tmux_only_surface_test`,
# the architecture guard for the tmux-only local-pane invariant.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//tools/boss/engine/core:__pkg__"],
)

# Keeps the Rust roster and the crew portrait grid (and the
# bundled sheet's size) in step by parsing the real sources.
sh_test(
    name = "worker_roster_parity_test",
    size = "small",
    srcs = ["tests/worker_roster_parity_test.sh"],
    data = [
        "src/worker_names.rs",
        "tests/worker_roster_parity_test.py",
        "//tools/boss/app-macos:crew_roster_sources",
    ],
)
