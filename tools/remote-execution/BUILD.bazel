load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The remote-execution deployment: NativeLink configs, units and scripts for
# the hub and the macOS workers. Nothing here is built by bazel or used by a
# build; the files are installed on the hosts by hand (README.md). The tests
# are what keeps them honest with each other and with what reads them.

exports_files(
    ["remote-status.sh"],
    visibility = ["//.buildkite/steps/tests:__pkg__"],
)

# The hub's health check against a stub hub: a scheduling hub is healthy, and
# the eviction loop, missing workers, a queue that does not move and a hub that
# does not answer are each reported.
sh_test(
    name = "hub_health_test",
    size = "small",
    srcs = ["tests/hub_health_test.sh"],
    data = ["nativelink/hub-health.sh"],
)

# The developer-side bound on a hub that goes silent mid-build: the same
# status request CI uses, against the endpoint in ~/.bazelrc.
sh_test(
    name = "dev_remote_watchdog_test",
    size = "small",
    srcs = ["tests/dev_remote_watchdog_test.sh"],
    data = [
        "dev-remote-workspace-status.sh",
        "remote-status.sh",
    ],
)

# The hub's Prometheus exporters: worker-slots-exporter.py (connected workers,
# loopback /status probe, hub journal event counters) and hub-textfile-metrics.sh
# (restart state and cgroup memory).
sh_test(
    name = "hub_metrics_exporter_test",
    size = "small",
    srcs = ["tests/hub_metrics_exporter_test.sh"],
    data = [
        "nativelink/hub-textfile-metrics.sh",
        "nativelink/worker-slots-exporter.py",
    ],
)

# Pins what the files promise each other: every scheduler timeout and the
# arithmetic between the hub's and the workers', the variables the configs
# expand against the units that set them, the pinned NativeLink version across
# the build script, the patches and the runbook (with the version each binary,
# worker or hub, reports), the hub restart and CAS exporters, the Grafana
# dashboard and alerting rules, and that no address is written into any of them.
sh_test(
    name = "config_test",
    size = "small",
    srcs = ["tests/config_test.sh"],
    data = [
        "README.md",
        "dev-remote-workspace-status.sh",
        "grafana/alerting/nativelink-hub.yaml",
        "grafana/dashboards/buildkite-pipelines.json",
        "grafana/dashboards/nativelink-overview.json",
        "grafana/dashboards/nativelink-workers.json",
        "grafana/preview-alerts.py",
        "grafana/provisioning/nativelink.yaml",
        "nativelink/build-worker.sh",
        "nativelink/com.brianduff.nativelink.plist",
        "nativelink/headcrash-worker/nativelink-worker.service",
        "nativelink/headcrash-worker/nativelink-worker.service.d/60-v1.8.conf",
        "nativelink/headcrash-worker/nativelink-worker.service.d/memory.conf",
        "nativelink/headcrash-worker/worker.json5",
        "nativelink/hub.json5",
        "nativelink/hub-health.sh",
        "nativelink/hub-textfile-metrics.sh",
        "nativelink/nativelink-hub-textfile.service",
        "nativelink/nativelink-hub-textfile.timer",
        "nativelink/nativelink-macos-hub.service",
        "nativelink/nativelink-macos-hub-health.service",
        "nativelink/nativelink-macos-hub-health.timer",
        "nativelink/nativelink-worker-slots-exporter.service",
        "nativelink/patches/compressed-upload-restart.patch",
        "nativelink/patches/macos-clonefile-executables.patch",
        "nativelink/patches/stale-entry-recovery.patch",
        "nativelink/worker-macos.json5",
        "nativelink/worker-slots-exporter.py",
        "remote-status.sh",
    ],
)
