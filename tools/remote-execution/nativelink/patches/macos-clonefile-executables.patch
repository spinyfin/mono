+/// Clones many files under a single permit and a single `spawn_blocking`
+/// dispatch, returning one result per input in the same order. macOS only.
+///
+/// Unlike a hardlink, a `clonefile(2)` clone gets its own inode whose blocks
+/// are shared copy-on-write with the source. It costs about what a hardlink
+/// costs and adds no disk usage, but the destination is a distinct file with a
+/// single name, so the kernel answers `F_GETPATH` on it with the path it was
+/// cloned to rather than with some other name of a shared inode. Callers that
+/// materialize executables need that: see `materialize_link_batch` in
+/// `nativelink-worker`.
+///
+/// Batched for the same reason [`hard_link_many`] is, and doubly so: a clone
+/// takes the same APFS per-volume metadata lock a `hard_link(2)` does, and it
+/// never leaves a file descriptor open either, so one permit covers the batch
+/// without touching the open-file budget [`OPEN_FILE_SEMAPHORE`] protects.
+///
+/// `clonefile(2)` requires APFS and a destination that does not exist, and it
+/// is atomic on failure. A failed entry is unlinked defensively anyway so the
+/// caller can retry it through [`hard_link_many`], which also works on HFS+
+/// and any other same-volume filesystem.
+#[cfg(target_os = "macos")]
+pub async fn clonefile_many(
+    clones: Vec<(PathBuf, PathBuf)>,
+) -> Result<Vec<Result<(), Error>>, Error> {
+    use std::ffi::CString;
+    use std::os::unix::ffi::OsStrExt;
+
+    // From <sys/clonefile.h>: don't follow symlinks. The `libc` crate exposes
+    // `clonefile` but not this flag constant.
+    const CLONE_NOFOLLOW: u32 = 0x0001;
+
+    call_with_permit(move |_| {
+        Ok(clones
+            .into_iter()
+            .map(|(src, dst)| {
+                let (Ok(src_c), Ok(dst_c)) = (
+                    CString::new(src.as_os_str().as_bytes()),
+                    CString::new(dst.as_os_str().as_bytes()),
+                ) else {
+                    return Err(make_err!(
+                        Code::InvalidArgument,
+                        "Path contains an interior NUL byte: {} -> {}",
+                        src.display(),
+                        dst.display()
+                    ));
+                };
+                // SAFETY: clonefile(2) takes two NUL-terminated C strings and a
+                // flag word. Both `CString`s are owned here for the duration of
+                // the call, so the pointers stay valid.
+                let res =
+                    unsafe { libc::clonefile(src_c.as_ptr(), dst_c.as_ptr(), CLONE_NOFOLLOW) };
+                if res == 0 {
+                    return Ok(());
+                }
+                let err = io::Error::last_os_error();
+                // clonefile(2) is atomic, so `dst` should not exist after a
+                // failure. Unlink defensively regardless: the caller retries
+                // through `hard_link(2)`, which fails on an existing
+                // destination.
+                drop(std::fs::remove_file(&dst));
+                Err(Error::from(err))
+            })
+            .collect())
+    })
+    .await
+}
+
 pub async fn set_permissions(src: impl AsRef<Path>, perm: Permissions) -> Result<(), Error> {
     let src = src.as_ref().to_owned();
     call_with_permit(move |_| std::fs::set_permissions(src, perm).map_err(Into::<Error>::into))
diff --git a/nativelink-util/tests/fs_test.rs b/nativelink-util/tests/fs_test.rs
index adbefd3b..cc430724 100644
--- a/nativelink-util/tests/fs_test.rs
+++ b/nativelink-util/tests/fs_test.rs
@@ -182,6 +182,82 @@ async fn remove_dir_all_leaves_shared_inodes_alone() -> Result<(), Box<dyn core:
     Ok(())
 }
 
+/// `clonefile_many` is what materializes executables on macOS, so its contract
+/// is the one hardlinking cannot meet: each destination gets its own inode
+/// (which is what makes dyld resolve `@loader_path` against the action tree
+/// rather than against the shared store), while the source's modes -- notably
+/// the read-only 0o555 of an executable variant -- survive verbatim. Batching
+/// must not change any of that, and a failing entry must neither abort the
+/// batch nor shift its neighbours' results, because the caller retries exactly
+/// the failed positions through `hard_link_many`.
+#[cfg(target_os = "macos")]
+#[nativelink_test]
+async fn clonefile_many_clones_in_order_and_isolates_failures()
+-> Result<(), Box<dyn core::error::Error>> {
+    use nativelink_util::fs::clonefile_many;
+
+    let dir = env::temp_dir().join("clonefile_many_test");
+    drop(remove_dir_all(&dir).await);
+    fs::create_dir_all(&dir)?;
+
+    let (src_a, src_b) = (dir.join("a.src"), dir.join("b.src"));
+    fs::write(&src_a, "a")?;
+    fs::write(&src_b, "b")?;
+    // The executable-variant convention: read-only and executable.
+    fs::set_permissions(&src_a, Permissions::from_mode(0o555))?;
+
+    // Middle entry's source does not exist, so only it may fail.
+    let (dst_a, dst_b) = (dir.join("a.dst"), dir.join("b.dst"));
+    let missing_dst = dir.join("missing.dst");
+    let clones = vec![
+        (src_a.clone(), dst_a.clone()),
+        (dir.join("missing.src"), missing_dst.clone()),
+        (src_b.clone(), dst_b.clone()),
+    ];
+    let results = clonefile_many(clones).await?;
+
+    assert_eq!(results.len(), 3, "one result per input");
+    assert!(results[0].is_ok(), "first clone should succeed");
+    assert!(results[1].is_err(), "missing source should fail");
+    assert!(
+        results[2].is_ok(),
+        "a failed clone must not abort the rest of the batch"
+    );
+
+    assert_eq!(fs::read_to_string(&dst_a)?, "a", "clone copies content");
+    assert_eq!(fs::read_to_string(&dst_b)?, "b", "clone copies content");
+
+    // A hardlink would share the source's inode. A clone must not: dyld
+    // resolves `@loader_path` from the path the kernel reports for the image,
+    // and a shared inode lets that be the store path instead of this one.
+    assert_ne!(
+        fs::metadata(&dst_a)?.ino(),
+        fs::metadata(&src_a)?.ino(),
+        "clone must have its own inode"
+    );
+    assert_eq!(
+        fs::metadata(&dst_a)?.nlink(),
+        1,
+        "clone must be the only name of its inode"
+    );
+
+    assert_eq!(
+        fs::metadata(&dst_a)?.permissions().mode() & 0o777,
+        0o555,
+        "clonefile copies the source's modes verbatim"
+    );
+
+    // The caller retries a failed position with `hard_link`, which fails on an
+    // existing destination, so a failure must leave nothing behind.
+    assert!(
+        !fs::exists(&missing_dst)?,
+        "a failed clone must not leave a destination behind"
+    );
+
+    remove_dir_all(&dir).await?;
+    Ok(())
+}
