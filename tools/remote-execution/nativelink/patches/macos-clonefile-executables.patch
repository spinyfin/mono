+
+/// Materializes one input tree's deferred links, returning one result per link
+/// in input order.
+///
+/// Everything is a `hard_link(2)` out of the shared store, except executables
+/// on macOS, which are cloned instead.
+///
+/// dyld resolves `@loader_path` and `@executable_path` from the main image's
+/// path as the kernel reports it, and for a hardlinked file that is whichever
+/// name of the inode the kernel happens to answer with -- which for an
+/// executable materialized out of the flat, content-addressed executable store
+/// is the store path, not the action tree path. Anything carrying
+/// `LC_RPATH = @loader_path/../lib` and loading `@rpath/...` (rustc, clang and
+/// most toolchain drivers do) then searches next to the store instead of next
+/// to itself and fails to launch. A `clonefile(2)` clone has its own inode and
+/// exactly one name, so the executable resolves against the tree it was staged
+/// into. It costs about what a hardlink costs, shares its blocks
+/// copy-on-write so it adds no disk usage, and copies the source's modes
+/// verbatim, which keeps the executable variant's read-only 0o555.
+///
+/// Clones are batched exactly as hardlinks are, and for the same reason: they
+/// contend for the same APFS per-volume metadata lock, so a per-file dispatch
+/// would give back what batching bought.
+///
+/// `clonefile(2)` needs APFS specifically. A cross-volume layout, HFS+, or any
+/// filesystem without clone support fails the clone, and those entries fall
+/// back to the hardlink batch -- the behavior before this path existed, with
+/// only the dyld resolution caveat above. A clone whose source is gone is not
+/// one of those: it is reported as `NotFound`, exactly as the hardlink would
+/// report it, so the caller fetches the blob back.
+async fn materialize_link_batch(links: &[PendingLink]) -> Result<Vec<Result<(), Error>>, Error> {
+    #[cfg(target_os = "macos")]
+    {
+        let (executables, mut hardlinks): (Vec<usize>, Vec<usize>) =
+            (0..links.len()).partition(|&idx| links[idx].executable);
+        if !executables.is_empty() {
+            let mut results: Vec<Option<Result<(), Error>>> = links.iter().map(|_| None).collect();
+            let clones =
+                fs::clonefile_many(link_pairs(executables.iter().map(|&idx| &links[idx]))).await?;
+            let mut degraded = Vec::new();
+            for (idx, result) in executables.iter().copied().zip(clones) {
+                match result {
+                    Ok(()) => results[idx] = Some(Ok(())),
+                    // The store deleted the variant after it was resolved. A
+                    // hardlink would fail the same way, and the caller repairs
+                    // exactly this code with a fresh fetch.
+                    Err(e) if e.code == Code::NotFound => results[idx] = Some(Err(e)),
+                    // Not fatal: retried as a hardlink below, which is what
+                    // this code did before clones existed.
+                    Err(e) => {
+                        degraded.push(e);
+                        hardlinks.push(idx);
+                    }
+                }
+            }
+            if let Some(first) = degraded.first() {
+                warn!(
+                    degraded = degraded.len(),
+                    executables = executables.len(),
+                    error = ?first,
+                    "clonefile unavailable for executables, falling back to hardlinks; \
+                     @loader_path-relative libraries may not resolve"
+                );
+            }
+            hardlinks.sort_unstable();
+            let linked =
+                fs::hard_link_many(link_pairs(hardlinks.iter().map(|&idx| &links[idx]))).await?;
+            for (idx, result) in hardlinks.iter().copied().zip(linked) {
+                results[idx] = Some(result);
+            }
+            return Ok(results
+                .into_iter()
+                .map(|result| result.expect("every link is materialized exactly once"))
+                .collect());
+        }
+    }
+    fs::hard_link_many(link_pairs(links)).await
+}
+
+/// Links one executable variant into an action tree outside the batch: a
+/// clone on macOS, for the reason [`materialize_link_batch`] gives, and a
+/// hardlink everywhere else. The fallback and the `NotFound` rule are the
+/// batch's.
+async fn link_executable(src: impl AsRef<Path>, dst: impl AsRef<Path>) -> Result<(), Error> {
+    #[cfg(target_os = "macos")]
+    {
+        let pair = (src.as_ref().to_path_buf(), dst.as_ref().to_path_buf());
+        match fs::clonefile_many(vec![pair]).await?.pop() {
+            Some(Ok(())) => return Ok(()),
+            Some(Err(e)) if e.code == Code::NotFound => return Err(e),
+            Some(Err(error)) => warn!(
+                ?error,
+                "clonefile unavailable for an executable, falling back to a hardlink; \
+                 @loader_path-relative libraries may not resolve"
+            ),
+            // One pair in, one result out; nothing was cloned if not.
+            None => {}
+        }
+    }
+    fs::hard_link(src, dst).await
+}
