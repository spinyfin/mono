+
+    /// Drops the index entry for `digest` when the file it names is no longer
+    /// on disk, and reports whether it did.
+    ///
+    /// For a caller that used the blob's path and found nothing there. The
+    /// index is what `has()` answers from, so `populate_fast_store` takes a
+    /// blob with a stale entry for resident and never fetches it: every action
+    /// that needs the blob then fails until the process restarts. With the
+    /// entry gone the next populate fetches the blob again.
+    pub async fn forget_if_missing(&self, digest: &DigestInfo) -> bool {
+        let Some(entry) = self.evicting_map.get(&digest.into()).await else {
+            return false;
+        };
+        self.forget_entry_if_missing(digest, &entry).await
+    }
+
+    async fn forget_entry_if_missing(&self, digest: &DigestInfo, entry: &Arc<Fe>) -> bool {
+        // Looked at under the entry's path lock, which a rename of the file
+        // takes for writing, and released before the removal, whose `unref()`
+        // takes it too.
+        let missing = entry
+            .get_file_path_locked(|path| async move {
+                Ok(matches!(
+                    fs::metadata(&path).await,
+                    Err(err) if err.code == Code::NotFound
+                ))
+            })
+            .await
+            .unwrap_or(false);
+        if !missing {
+            return false;
+        }
+        warn!(
+            %digest,
+            "Filesystem store map/disk divergence: the blob's file is gone, removing its entry so it is fetched again",
+        );
+        // Only this entry: one inserted since has a file of its own.
+        self.evicting_map
+            .remove_if(&digest.into(), |map_entry| Arc::ptr_eq(map_entry, entry))
+            .await
     }
 
