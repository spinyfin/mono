+/// Deletes the file behind `digest` and leaves its index entry in place, which
+/// is the state a blob is in when something other than the store removed it.
+fn remove_blob_file(content_path: &str, digest: &DigestInfo) -> Result<(), Error> {
+    let prefix = digest.to_string();
+    let mut removed = 0;
+    for entry in std::fs::read_dir(format!("{content_path}/{DIGEST_FOLDER_V2}"))? {
+        let entry = entry?;
+        if entry.file_name().to_string_lossy().starts_with(&prefix) {
+            std::fs::remove_file(entry.path())?;
+            removed += 1;
+        }
+    }
+    assert_eq!(removed, 1, "expected one file for {digest}");
+    Ok(())
+}
+
+/// An index entry can outlive its file. `has()` answers from the index, so a
+/// caller that populates the fast store before it builds a variant fetches
+/// nothing, and the copy then fails for every action that needs the blob.
+/// Building the variant must drop the entry and report a miss, which is what
+/// makes the caller's next populate fetch the blob.
+#[cfg(target_family = "unix")]
+#[nativelink_test]
+async fn stale_blob_entry_is_dropped_when_its_variant_cannot_be_built() -> Result<(), Error> {
+    let content_path = make_temp_path("content_path");
+    let digest = DigestInfo::try_new(HASH1, VALUE1.len())?;
+    let store = Box::pin(
+        FilesystemStore::<FileEntryImpl>::new(&FilesystemSpec {
+            content_path: content_path.clone(),
+            temp_path: make_temp_path("temp_path"),
+            ..Default::default()
+        })
+        .await?,
+    );
+    store.update_oneshot(digest, VALUE1.into()).await?;
+    remove_blob_file(&content_path, &digest)?;
+    assert!(
+        store.has(digest).await?.is_some(),
+        "the index still lists the blob"
+    );
+
+    let err = store
+        .get_executable_hardlink_source(&digest)
+        .await
+        .expect_err("a variant cannot be built from a file that is gone");
+    assert_eq!(err.code, Code::NotFound, "{err:?}");
+    assert!(
+        store.has(digest).await?.is_none(),
+        "the stale entry must be dropped"
+    );
+
+    // What the caller's populate does next.
+    store.update_oneshot(digest, VALUE1.into()).await?;
+    let variant_path = store.get_executable_hardlink_source(&digest).await?;
+    assert_eq!(std::fs::read(&variant_path)?, VALUE1.as_bytes());
+    Ok(())
+}
+
+/// `forget_if_missing` is for a caller that found nothing at a blob's path. It
+/// must leave alone an entry whose file is there.
+#[nativelink_test]
+async fn forget_if_missing_drops_only_an_entry_without_a_file() -> Result<(), Error> {
+    let content_path = make_temp_path("content_path");
+    let digest = DigestInfo::try_new(HASH1, VALUE1.len())?;
+    let store = Box::pin(
+        FilesystemStore::<FileEntryImpl>::new(&FilesystemSpec {
+            content_path: content_path.clone(),
+            temp_path: make_temp_path("temp_path"),
+            ..Default::default()
+        })
+        .await?,
+    );
+    assert!(!store.forget_if_missing(&digest).await, "nothing to forget");
+
+    store.update_oneshot(digest, VALUE1.into()).await?;
+    assert!(!store.forget_if_missing(&digest).await);
+    assert!(store.has(digest).await?.is_some());
+
+    remove_blob_file(&content_path, &digest)?;
+    assert!(store.forget_if_missing(&digest).await);
+    assert!(store.has(digest).await?.is_none());
+    assert!(!store.forget_if_missing(&digest).await);
+    Ok(())
+}
