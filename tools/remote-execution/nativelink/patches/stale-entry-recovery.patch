+    /// Deletes the file behind `digest` in the fast store and leaves its index
+    /// entry in place.
+    fn remove_blob_file(content_path: &str, digest: &DigestInfo) -> Result<(), std::io::Error> {
+        let prefix = digest.to_string();
+        let mut removed = 0;
+        for entry in std::fs::read_dir(format!("{content_path}/d2"))? {
+            let entry = entry?;
+            if entry.file_name().to_string_lossy().starts_with(&prefix) {
+                std::fs::remove_file(entry.path())?;
+                removed += 1;
+            }
+        }
+        assert_eq!(removed, 1, "expected one file for {digest}");
+        Ok(())
+    }
+
+    /// A fast store entry can outlive its file. The store then answers that it
+    /// has the blob, so fetching the blob again does nothing and every action
+    /// that stages it fails. Staging must make the store forget the entry and
+    /// fetch the blob: here for a plain input, and for an executable whose
+    /// variant has to be built from it.
+    #[nativelink_test]
+    async fn download_to_directory_refetches_inputs_whose_store_files_are_gone()
+    -> Result<(), Box<dyn core::error::Error>> {
+        const PLAIN_CONTENT: &str = "plain input behind a stale entry";
+        const EXEC_CONTENT: &str = "#!/bin/sh\necho stale\n";
+
+        let content_path = make_temp_path("content_path");
+        let (fast_store, slow_store, cas_store, _ac_store) =
+            setup_stores_at(content_path.clone(), None).await?;
+        let plain_digest = DigestInfo::new([61u8; 32], PLAIN_CONTENT.len() as u64);
+        let exec_digest = DigestInfo::new([62u8; 32], EXEC_CONTENT.len() as u64);
+        for (digest, content) in [(plain_digest, PLAIN_CONTENT), (exec_digest, EXEC_CONTENT)] {
+            slow_store
+                .as_ref()
+                .update_oneshot(digest, content.into())
+                .await?;
+            // Resident in the fast store; then the file goes and the entry stays.
+            cas_store.populate_fast_store(digest.into()).await?;
+            remove_blob_file(&content_path, &digest)?;
+            assert!(fast_store.has(digest).await?.is_some());
+        }
+
+        let download_dir = stage_tree(
+            &slow_store,
+            &cas_store,
+            &fast_store,
+            vec![
+                FileNode {
+                    name: "plain.txt".to_string(),
+                    digest: Some(plain_digest.into()),
+                    ..Default::default()
+                },
+                FileNode {
+                    name: "tool".to_string(),
+                    digest: Some(exec_digest.into()),
+                    is_executable: true,
+                    ..Default::default()
+                },
+            ],
+        )
+        .await?;
+
+        let plain = fs::read(format!("{download_dir}/plain.txt")).await?;
+        assert_eq!(from_utf8(&plain)?, PLAIN_CONTENT);
+        let tool_path = format!("{download_dir}/tool");
+        assert_eq!(from_utf8(&fs::read(&tool_path).await?)?, EXEC_CONTENT);
+        #[cfg(target_family = "unix")]
+        assert_ne!(fs::metadata(&tool_path).await?.mode() & 0o111, 0);
+        Ok(())
+    }
