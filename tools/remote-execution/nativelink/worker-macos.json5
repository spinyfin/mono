// NativeLink worker for a Mac in the remote-execution pool. For the patched
// 1.8.6 binary build-worker.sh produces; an upstream release cannot run Rust
// actions on macOS (../README.md, "Version and patches").
//
// Started by launchd (com.brianduff.nativelink.plist). The scheduler and the
// shared cache are the hub (hub.json5) on another host. This process only
// runs actions: it fetches inputs from the shared cache, keeps a local copy
// of them, and uploads results back.
//
// The file is the same on every worker. What differs per host comes from the
// plist's EnvironmentVariables, and a variable that is not set fails the
// start:
//
//   NL_WORKER_NAME             This host's short name. It prefixes the worker
//                              id, so the hub's log and its worker listing
//                              say which Mac a line is about.
//   NL_HUB_CLIENT_ADDRESS      <host>:<port> of the hub's client API.
//   NL_HUB_WORKER_ADDRESS      <host>:<port> of the hub's worker API.
//   NL_WORKER_HOME             The directory this file, the binary and
//                              action-env.sh are installed in.
//   NL_WORKER_DATA             Directory for the local store and the action
//                              directories. One APFS volume for both: an
//                              executable is cloned from the store into the
//                              action directory, and a clone cannot cross
//                              volumes.
//   NL_WORKER_SLOTS            How many actions run at once.
//   NL_WORKER_STORE_MAX_BYTES  Size of the local store in bytes.
{
  stores: [
    {
      name: "SHARED_CAS",
      grpc: {
        instance_name: "",
        endpoints: [{ address: "grpc://${NL_HUB_CLIENT_ADDRESS}" }],
        store_type: "cas",
        // zstd on transfers to and from the hub (blobs of 64 KiB and over).
        // The hub must have capabilities.remote_cache_compression on.
        experimental_remote_cache_compression: true,
      },
    },
    {
      name: "SHARED_AC",
      grpc: {
        instance_name: "",
        endpoints: [{ address: "grpc://${NL_HUB_CLIENT_ADDRESS}" }],
        store_type: "ac",
      },
    },
    {
      name: "WORKER_FAST_SLOW_STORE",
      fast_slow: {
        fast: {
          filesystem: {
            content_path: "${NL_WORKER_DATA}/store/content",
            temp_path: "${NL_WORKER_DATA}/store/tmp",
            eviction_policy: { max_bytes: "${NL_WORKER_STORE_MAX_BYTES}" },
          },
        },
        fast_direction: "get",
        slow: { ref_store: { name: "SHARED_CAS" } },
      },
    },
  ],
  workers: [
    {
      local: {
        name: "${NL_WORKER_NAME}-",
        worker_api_endpoint: {
          uri: "grpc://${NL_HUB_WORKER_ADDRESS}",
          // The worker sends the hub a keepalive every half of this, and the
          // hub evicts a worker it has not heard from for worker_timeout_s
          // (30 s in hub.json5). NativeLink's default; do not raise it
          // without raising that.
          timeout: 5,
          // How the worker notices a connection to the hub that has stopped
          // answering without closing: a PING every 10 s, and a reconnect
          // when one goes unanswered for 20 s. The defaults are 30 s and
          // 20 s, which leaves a worker running actions for up to 50 s for a
          // hub that evicted it and gave them to someone else after 30.
          http2_keepalive_interval_s: 10,
          http2_keepalive_timeout_s: 20,
        },
        cas_fast_slow_store: "WORKER_FAST_SLOW_STORE",
        upload_action_result: { ac_store: "SHARED_AC" },
        work_directory: "${NL_WORKER_DATA}/work",
        // Wraps every action: sets DEVELOPER_DIR and SDKROOT from the Xcode
        // and SDK the action asks for.
        entrypoint: "${NL_WORKER_HOME}/action-env.sh",

        // The three limits on one action, written out because the hub's
        // max_action_executing_timeout_s (45 min) is their sum and five
        // minutes: change one and that has to follow. All three are
        // NativeLink's defaults. They are kept because nothing has measured
        // this pool's longest fetch, command or upload, and a limit set too
        // low fails work that would have finished. Past a limit the action
        // fails with DEADLINE_EXCEEDED and the hub may retry it elsewhere.
        //
        // The command limit applies to an action that names no timeout, and
        // caps one that names a longer one. Bazel names one on tests only.
        max_download_timeout_s: 600,
        max_action_timeout_s: 1200,
        max_upload_timeout_s: 600,

        // Slots. cpu_count only limits clients that request cpu_count=1;
        // max_inflight_tasks caps every client. Keep the two equal, which is
        // why both come from one variable.
        max_inflight_tasks: "${NL_WORKER_SLOTS}",
        platform_properties: {
          cpu_count: { values: ["${NL_WORKER_SLOTS}"] },
          // The hub offers this worker the actions whose OSFamily is
          // "macos": the ones a client tagged so, and every action that
          // arrived with no OSFamily (hub.json5, property_modifier).
          OSFamily: { values: ["macos"] },
          "container-image": { values: [""] },
          // Names this worker. Nothing asks for it in normal use. A build
          // that adds --remote_default_exec_properties=worker-host=<name>
          // runs only on that worker, which is how one worker is checked by
          // itself. The hub does not list the key, so it is compared only
          // against workers that declare it: every worker, on either
          // operating system, must declare it.
          "worker-host": { values: ["${NL_WORKER_NAME}"] },
        },
      },
    },
  ],
  servers: [],
  global: { max_open_files: 24576 },
}
