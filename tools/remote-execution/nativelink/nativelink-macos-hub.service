# systemd user unit for the hub: scheduler, CAS and action cache (hub.json5)
# for the macOS and the Linux workers. Install as
# ~/.config/systemd/user/nativelink-macos-hub.service; the runbook
# (../README.md, "Cutover") has the steps.
#
# The name and the directory say "macos" because the Linux workers had a hub
# of their own until 2026-11-22. One scheduler now serves both, and routes on
# the OSFamily property (../README.md, "Routing").
[Unit]
Description=NativeLink hub for remote execution (scheduler, CAS, action cache)
After=network-online.target

[Service]
# Host values hub.json5 expands: listen addresses, data directory, store
# sizes. hub.json5 lists them. A variable that is missing fails the start with
# an error naming it; nothing falls back to a default.
EnvironmentFile=%h/nativelink-macos-hub/hub.env
ExecStart=%h/nativelink-macos-hub/nativelink %h/nativelink-macos-hub/hub.json5
WorkingDirectory=%h/nativelink-macos-hub
# Restart after a crash. This is not a recovery mechanism for a scheduler that
# is running but not scheduling: that state does not exit, so nothing here
# would restart it, and nothing should. nativelink-macos-hub-health.timer
# reports it, and the runbook says what to look at before restarting by hand.
Restart=always
RestartSec=5
LimitNOFILE=65536
# One JSON event per line in the journal. hub-health.sh reads it, and
# refuses any other format instead of reading it as a quiet scheduler.
Environment=NL_LOG=json

[Install]
WantedBy=default.target
