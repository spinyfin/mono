# Fixture for :test_filter_guard_test. Tagged manual: it is executed *by* that
# guard test (which drives its wrapper with the Bazel test-protocol environment
# variables), not run as a test in its own right.
rust_test(
    name = "test_filter_fixture",
    size = "small",
    srcs = ["test_filter_fixture.rs"],
    experimental_enable_sharding = True,
    tags = ["manual"],
)

# Asserts `bazel test --test_filter=...` and `shard_count` actually take effect
# for rust_test. Both are silent no-ops in stock rules_rust 0.70.0; mono patches
# them in via third_party/patches/rules_rust-0.70.0-test-wrapper.patch.
sh_test(
    name = "test_filter_guard_test",
    size = "small",
    srcs = ["test_filter_guard_test.sh"],
    data = [":test_filter_fixture"],
)

# Scale regression for the same wrapper's sharding path. Drives the wrapper
# *template* against a fake libtest binary that enumerates 20,000 tests,
# asserts the exact `index % shards` partition, and bounds the CPU the wrapper
# spends before exec'ing the shard: the bash-loop partition it replaced cost
# ~0.2 ms per enumerated test per shard on macOS bash 3.2 (~1.2 s per shard
# for the engine's 6,400-test suite, paid on every run).
sh_test(
    name = "test_wrapper_scale_test",
    size = "small",
    srcs = ["test_wrapper_scale_test.sh"],
    data = ["@rules_rust//rust/private:test_wrapper.sh"],
    env = {"WRAPPER_TEMPLATE": "$(rlocationpath @rules_rust//rust/private:test_wrapper.sh)"},
)

sh_test(
    name = "linux_policy_source_test",
    size = "small",
    srcs = ["linux_policy_source_test.sh"],
    data = [
        ":defs.bzl",
        ":hermetic_test_wrapper.sh",
        ":linux_remote_action_sandbox.sh",
        "//:.bazelrc",
    ],
)

sh_test(
