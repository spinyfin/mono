sh_test(
    name = "runtime_symlink_guard_test",
    size = "small",
    srcs = ["runtime_symlink_guard_test.sh"],
)

sh_binary(
    name = "cleanup_child",
    srcs = ["cleanup_child.sh"],
)

sh_test(
    name = "cleanup_guard_test",
    size = "small",
    srcs = ["cleanup_guard_test.sh"],
