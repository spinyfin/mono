"""Host runtime inputs audited for repository-owned test actions."""

# Written into every generated runtime repository as `runtime.bzl`, so the
# repository's BUILD file loads it locally instead of reaching back into the
# main repository.
#
# The tools are declared, unresolved symlinks on purpose. A symlink made by
# `repository_ctx.symlink` is a source file to Bazel: it is followed, digested,
# and shipped to a remote executor as a *copy* of the client's binary, and
# macOS kills a copy of a platform binary at launch ("AMFI: Launch Constraint
# Violation"; the copy exits 137). A declared symlink travels as a symlink, so
# `bin/<tool>` names the executing host's own installed binary. See
# README.md, "Remote execution on macOS workers".
_RUNTIME_RULE_BZL = """\
\"\"\"Generated by test_runtime_repository. Do not edit.\"\"\"

def _test_runtime_impl(ctx):
    files = list(ctx.files.srcs)
    for name, target in ctx.attr.tools.items():
        link = ctx.actions.declare_symlink("bin/" + name)
        ctx.actions.symlink(output = link, target_path = target)
        files.append(link)
    return [DefaultInfo(
        files = depset(files),
        runfiles = ctx.runfiles(files = files),
    )]

test_runtime = rule(
    implementation = _test_runtime_impl,
    attrs = {
        "srcs": attr.label_list(allow_files = True),
        "tools": attr.string_dict(),
    },
)
"""

# Written into a single-tool repository as `host_tool.bzl`, for the same reason
# as the runtime rule above: the label a test puts in `data` has to reach a
# remote executor as a symlink to the executing host's own binary, not as a
# copy of the client's. The wrapper grants a test the resolved target of every
# executable symlink in its runfiles, so the tool stays available only to a
# test that declares it.
#
# `fingerprint` is in the runfiles and not in `files`: consumers expand
# `$(rootpath ...)` on the label, which needs it to stay a single file.
_HOST_TOOL_RULE_BZL = """\
\"\"\"Generated by host_tool_symlink. Do not edit.\"\"\"

def _host_tool_impl(ctx):
    link = ctx.actions.declare_symlink(ctx.label.name)
    ctx.actions.symlink(output = link, target_path = ctx.attr.target_path)
    return [DefaultInfo(
        files = depset([link]),
        runfiles = ctx.runfiles(files = [link, ctx.file.fingerprint]),
    )]

host_tool = rule(
    implementation = _host_tool_impl,
    attrs = {
        "fingerprint": attr.label(allow_single_file = True, mandatory = True),
        "target_path": attr.string(mandatory = True),
    },
)
"""

_SHA256_COMMANDS = [
    ["/usr/bin/sha256sum"],
    ["/bin/sha256sum"],
    ["/sbin/sha256sum"],
    ["/usr/bin/shasum", "-a", "256"],
]

# macOS system binaries live on the sealed system volume, so the build number
# identifies all of them at once. Elsewhere the kernel release is the closest
# equivalent.
_OS_BUILD_COMMANDS = [
    ["/usr/bin/sw_vers", "-buildVersion"],
    ["/usr/bin/uname", "-sr"],
    ["/bin/uname", "-sr"],
]

_RUNTIME_TOOLS = [
    "awk",
    "basename",
    "bash",
    "cat",
    "chmod",
    "cp",
    "cut",
    "date",
    "dirname",
    "echo",
    "env",
    "false",
    "find",
    "git",
    "git-receive-pack",
    "git-upload-pack",
    "grep",
    "head",
    "kill",
    "ln",
    "mkdir",
    "mkfifo",
    "mktemp",
    "mv",
    "od",
    "perl",
    "printf",
    "ps",
    "pwd",
    "python3",
    "readlink",
    "rm",
    "sed",
    "sh",
    "shasum",
    "sleep",
    "sort",
    "tail",
    "tee",
    "touch",
    "tr",
    "true",
    "uname",
    "unzip",
    "wc",
]

_REQUIRED_RUNTIME_TOOLS = [
    "bash",
    "env",
    "git",
    "git-receive-pack",
    "git-upload-pack",
    "kill",
    "mkdir",
    "mktemp",
    "perl",
    "rm",
    "sed",
    "sh",
    "sleep",
]

def _configured_developer_dir(repository_ctx):
    developer_dir = repository_ctx.os.environ.get("DEVELOPER_DIR", "")
    if not developer_dir:
        xcode_select = repository_ctx.path("/usr/bin/xcode-select")
        if xcode_select.exists:
            result = repository_ctx.execute(
                [str(xcode_select), "-p"],
                quiet = True,
            )
            if result.return_code == 0:
                developer_dir = result.stdout.strip()

    if not developer_dir:
        return ""

    path = repository_ctx.path(developer_dir)
    if not path.exists:
        fail("configured DEVELOPER_DIR does not exist: {}".format(developer_dir))
    return str(path.realpath)

def _os_build(repository_ctx):
    for command in _OS_BUILD_COMMANDS:
        if not repository_ctx.path(command[0]).exists:
            continue
        result = repository_ctx.execute(command, quiet = True)
        if result.return_code == 0 and result.stdout.strip():
            return result.stdout.strip()
        fail("cannot determine the host OS build for the test runtime fingerprint: " + result.stderr)
    fail("cannot determine the host OS build for the test runtime fingerprint: no sw_vers or uname")

def _host_fingerprint(repository_ctx, tools):
    """Returns the content that ties test-action cache keys to the host tools.

    The declared symlinks in `bin/` carry only a target path into an action's
    cache key. Source-file symlinks used to carry each tool's content digest,
    so an OS or Xcode update invalidated cached test results. This file keeps
    that property: it is an inert input of every action that uses the runtime,
    and nothing executes or parses it.
    """
    paths = sorted({path: None for path in tools.values()}.keys())
    digests = {}
    for command in _SHA256_COMMANDS:
        if not repository_ctx.path(command[0]).exists:
            continue
        result = repository_ctx.execute(command + paths, quiet = True)
        if result.return_code != 0:
            fail("cannot digest the audited test runtime tools: " + result.stderr)
        for line in result.stdout.splitlines():
            digest, _, path = line.partition(" ")
            digests[path.lstrip(" *")] = digest
        break
    missing = [path for path in paths if len(digests.get(path, "")) != 64]
    if missing:
        fail("cannot digest the audited test runtime tools: " + ", ".join(missing))

    for path in paths:
        # Refetch (and so re-digest) when a tool is replaced under a running
        # Bazel server, as a tracked source file would have been.
        repository_ctx.watch(path)

    lines = [
        "os={} {}".format(repository_ctx.os.name, repository_ctx.os.arch),
        "os_build=" + _os_build(repository_ctx),
    ] + [
        "{}={} sha256={}".format(name, tools[name], digests[tools[name]])
        for name in sorted(tools.keys())
    ]
    return "\n".join(lines) + "\n"

def _test_runtime_repository_impl(repository_ctx):
    developer_dir = _configured_developer_dir(repository_ctx)
    resolved = {}
    runtime_tools = repository_ctx.attr.tools or _RUNTIME_TOOLS
    runtime_tools = runtime_tools + repository_ctx.attr.tools_by_os.get(repository_ctx.os.name, [])
    for tool in runtime_tools:
        candidates = ["/usr/bin/" + tool, "/bin/" + tool]
        if tool == "git":
            candidates = ([
                developer_dir + "/usr/bin/git",
            ] if developer_dir else []) + [
                "/Library/Developer/CommandLineTools/usr/bin/git",
            ] + candidates
        if tool in ["git-receive-pack", "git-upload-pack"]:
            candidates = ([
                developer_dir + "/usr/libexec/git-core/" + tool,
            ] if developer_dir else []) + [
                "/Library/Developer/CommandLineTools/usr/libexec/git-core/" + tool,
            ] + candidates
        if tool == "python3":
            candidates = ([
                developer_dir + "/usr/bin/python3",
            ] if developer_dir else []) + ["/opt/homebrew/bin/python3"] + candidates
        for candidate in candidates:
            path = repository_ctx.path(candidate)
            if path.exists:
                path = path.realpath
                resolved[tool] = str(path)
                if tool == "git":
                    git_runtime = path.dirname.dirname.get_child("libexec").get_child("git-core")
                    if git_runtime.exists:
                        resolved["git-tree"] = str(git_runtime.realpath)
                if tool == "python3":
                    if developer_dir and str(path).startswith(developer_dir + "/"):
                        python_runtime = repository_ctx.path(
                            developer_dir + "/Library/Frameworks/Python3.framework",
                        )
                        if python_runtime.exists:
                            resolved["python3-tree"] = str(python_runtime.realpath)
                    elif "/opt/homebrew/" in str(path):
                        resolved["python3-tree"] = str(path.dirname.dirname.realpath)
                break

    required = repository_ctx.attr.required or _REQUIRED_RUNTIME_TOOLS
    missing = [tool for tool in required if tool not in resolved]
    if missing:
        fail("required audited test runtime tools are missing: {}".format(", ".join(missing)))

    # Tree entries name a directory of helpers, not a tool on PATH.
    tools = {
        name: path
        for name, path in resolved.items()
        if not name.endswith("-tree")
    }

    repository_ctx.file(
        "developer_dir",
        content = developer_dir + ("\n" if developer_dir else ""),
    )
    repository_ctx.file(
        "manifest",
        content = "".join([
            "{}={}\n".format(tool, resolved[tool])
            for tool in sorted(resolved.keys())
        ]),
    )
    repository_ctx.file(
        "fingerprint",
        content = _host_fingerprint(repository_ctx, tools),
        executable = False,
    )
    repository_ctx.file("runtime.bzl", content = _RUNTIME_RULE_BZL, executable = False)
    repository_ctx.file(
        "BUILD.bazel",
        content = """\
load(":runtime.bzl", "test_runtime")

test_runtime(
    name = "runtime",
    srcs = [
        "developer_dir",
        "fingerprint",
        "manifest",
    ],
    tools = {tools},
    visibility = {visibility},
)
""".format(
            tools = "{\n" + "".join([
                "        {}: {},\n".format(repr(name), repr(tools[name]))
                for name in sorted(tools.keys())
            ]) + "    }",
            visibility = repr(repository_ctx.attr.runtime_visibility),
        ),
    )

def host_tool_symlink(repository_ctx, name, path, visibility, subdir = "", extra_exports = []):
    """Fills a repository with one target, `name`, that links to a host tool.

    `@<repository>//:<name>` is a declared symlink to `path`. On a remote
    executor it names that host's own binary; `repository_ctx.symlink` would
    ship a copy of the client's, which macOS refuses to launch when it is a
    system binary.

    Args:
      repository_ctx: The calling repository rule's context.
      name: Target name, and the file name of the link in runfiles.
      path: Absolute host path the link points at.
      visibility: Visibility of the target.
      subdir: Optional subdirectory within the repository for generated files.
      extra_exports: Optional additional files in `subdir` to export with `visibility`.
    """
    if repository_ctx.path(path).exists:
        fingerprint = _host_fingerprint(repository_ctx, {name: path})
    else:
        # The link dangles and its consumers are expected to select it away
        # on this host. Refetch if the tool appears.
        repository_ctx.watch(path)
        fingerprint = "{}={} absent\n".format(name, path)
    prefix = subdir.rstrip("/") + "/" if subdir else ""
    repository_ctx.file(prefix + "fingerprint", content = fingerprint, executable = False)
    repository_ctx.file(prefix + "host_tool.bzl", content = _HOST_TOOL_RULE_BZL, executable = False)
    extra_block = ""
    if extra_exports:
        extra_block = "\nexports_files({extra_exports}, visibility = {visibility})\n".format(
            extra_exports = repr(extra_exports),
            visibility = repr(visibility),
        )
    repository_ctx.file(
        prefix + "BUILD.bazel",
        content = """\
load(":host_tool.bzl", "host_tool")

host_tool(
    name = {name},
    fingerprint = "fingerprint",
    target_path = {path},
    visibility = {visibility},
)
{extra_block}""".format(
            name = repr(name),
            path = repr(path),
            visibility = repr(visibility),
            extra_block = extra_block,
        ),
    )

def _codex_probe_runtime(repository_ctx):
    """Separate inputs: only a test declaring these gets the host login shell.

    Codex resolves the shell from passwd, ignoring SHELL. As with host_tmux,
    keep this out of the common runtime manifest and bin/* PATH directory.
    The CA bundle lets the probe verify TLS without accessing the Keychain.
    """

    # No python dependency: macOS resolves the shell via dscl, Linux via getent.
    result = repository_ctx.execute([
        "/bin/sh",
        "-c",
        'u=$(id -un); if command -v dscl >/dev/null 2>&1; then dscl . -read "/Users/$u" UserShell | sed "s/^UserShell: //"; else getent passwd "$u" | cut -d: -f7; fi',
    ])
    shell = result.stdout.strip()
    if result.return_code != 0 or not shell:
        fail("cannot resolve Codex probe login shell: " + result.stderr)
    ca_candidates = [
        "/etc/ssl/cert.pem",
        "/etc/ssl/certs/ca-certificates.crt",
        "/etc/pki/tls/certs/ca-bundle.crt",
    ]
    found_ca = False
    for candidate in ca_candidates:
        if repository_ctx.path(candidate).exists:
            repository_ctx.symlink(repository_ctx.path(candidate).realpath, "codex/ca.pem")
            found_ca = True
            break
    if not found_ca:
        fail("cannot find a CA bundle for the Codex probe; tried: " + ", ".join(ca_candidates))
    host_tool_symlink(
        repository_ctx,
        "login-shell",
        str(repository_ctx.path(shell).realpath),
        ["@@//tools/boss/engine/core:__pkg__"],
        subdir = "codex",
        extra_exports = ["ca.pem"],
    )

codex_probe_runtime_repository = repository_rule(
    implementation = _codex_probe_runtime,
    local = True,
)

test_runtime_repository = repository_rule(
    implementation = _test_runtime_repository_impl,
    attrs = {
        # Defaults to the shared audited runtime. A narrower consumer lists its
        # own host tools (and which are mandatory) and its own visibility.
        "tools": attr.string_list(),
        "tools_by_os": attr.string_list_dict(),
        "required": attr.string_list(),
        "runtime_visibility": attr.string_list(default = ["//visibility:public"]),
    },
    configure = True,
    environ = ["DEVELOPER_DIR"],
    local = True,
)

_HOST_TMUX_RULE_BZL = """\
\"\"\"Generated by host_tmux_repository. Do not edit.\"\"\"

def _host_tmux_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name)
    ctx.actions.symlink(output = out, target_file = ctx.file.bin, is_executable = True)
    return [DefaultInfo(
        files = depset([out]),
        runfiles = ctx.runfiles(files = [out, ctx.file.bin] + ctx.files.libs),
    )]

host_tmux = rule(
    implementation = _host_tmux_impl,
    attrs = {
        "bin": attr.label(allow_single_file = True, mandatory = True),
        "libs": attr.label_list(allow_files = True),
    },
)
"""

def _host_tmux_repository_impl(repository_ctx):
    """Exposes the locally installed tmux binary as one declared test input.

    The hermetic test wrapper grants process-exec only to Bazel runfiles and
    the audited runtime. Keeping tmux in a separate repository prevents it
    from becoming generally available on every test's PATH: a test must add
    this target to its own data before it can execute the production binary.

    On macOS, Homebrew tmux dynamically links libraries from its install
    prefix (e.g. libutf8proc, libevent, ncurses), which are absent on remote
    workers; bundle those non-system dylibs alongside the binary and rewrite
    their load commands to `@loader_path/lib/...` so the runfiles are
    self-contained.
    """
    visibility = [
        "@@//tools/boss/engine/core:__pkg__",
        "@@//tools/boss/engine/spoke:__pkg__",
        "@@//tools/boss/spoke-package:__pkg__",
        "@@//tools/test-sandbox:__pkg__",
    ]
    for candidate in [
        "/opt/homebrew/bin/tmux",
        "/usr/local/bin/tmux",
        "/usr/bin/tmux",
        "/bin/tmux",
    ]:
        path = repository_ctx.path(candidate)
        if path.exists:
            if repository_ctx.os.name == "mac os x":
                python = repository_ctx.which("python3") or repository_ctx.path("/usr/bin/python3")
                bundle_script = repository_ctx.path(Label("//tools/test-sandbox:bundle_macos_tmux.py"))
                result = repository_ctx.execute([
                    str(python),
                    str(bundle_script),
                    str(path.realpath),
                    str(repository_ctx.path("tmux.bin")),
                    str(repository_ctx.path("lib")),
                ])
                if result.return_code != 0:
                    fail("failed to bundle macOS host tmux dylibs: " + result.stderr)
                repository_ctx.watch(path)
                for watched_path in result.stdout.splitlines():
                    if watched_path:
                        repository_ctx.watch(watched_path)
                repository_ctx.file("host_tmux.bzl", content = _HOST_TMUX_RULE_BZL, executable = False)
                repository_ctx.file(
                    "BUILD.bazel",
                    content = """\
load(":host_tmux.bzl", "host_tmux")

host_tmux(
    name = "tmux",
    bin = "tmux.bin",
    libs = glob(["lib/**"], allow_empty = True),
    visibility = {visibility},
)
""".format(visibility = repr(visibility)),
                )
                return
            repository_ctx.symlink(path.realpath, "tmux")
            repository_ctx.file(
                "BUILD.bazel",
                content = "exports_files([\"tmux\"], visibility = {})\n".format(repr(visibility)),
            )
            return

    # Keep analysis deterministic on hosts without tmux. The integration
    # target fails with a direct diagnostic if it is selected there.
    repository_ctx.file(
        "tmux",
        content = "#!/bin/sh\nprintf '%s\\n' 'tmux is not installed on this host' >&2\nexit 127\n",
        executable = True,
    )
    repository_ctx.file(
        "BUILD.bazel",
        content = "exports_files([\"tmux\"], visibility = {})\n".format(repr(visibility)),
    )

host_tmux_repository = repository_rule(
    implementation = _host_tmux_repository_impl,
    local = True,
)

def _host_lsof_repository_impl(repository_ctx):
    # Cube's macOS process-scan test declares its executable explicitly, just
    # like the tmux integration tests; other tests do not receive this tool.
    visibility = ["@@//tools/cube:__pkg__"]
    path = repository_ctx.path("/usr/sbin/lsof")
    if repository_ctx.os.name == "mac os x" and path.exists:
        # A system binary: declared as a symlink so that a remote worker runs
        # its own lsof (see host_tool_symlink).
        host_tool_symlink(repository_ctx, "lsof", str(path.realpath), visibility)
        return
    repository_ctx.file(
        "lsof",
        content = "#!/bin/sh\nprintf '%s\\n' 'macOS lsof is unavailable' >&2\nexit 127\n",
        executable = True,
    )
    repository_ctx.file(
        "BUILD.bazel",
        content = "exports_files([\"lsof\"], visibility = {})\n".format(repr(visibility)),
    )

host_lsof_repository = repository_rule(
    implementation = _host_lsof_repository_impl,
    local = True,
)

def _host_claude_repository_impl(repository_ctx):
    # Only the explicitly selected inbox compatibility test receives this
    # executable; it is never added to the shared test runtime or PATH.
    binary = repository_ctx.which("claude")
    if binary:
        repository_ctx.symlink(binary.realpath, "claude")
    else:
        repository_ctx.file(
            "claude",
            content = "#!/bin/sh\nprintf '%s\\n' 'Claude Code is not installed on this host' >&2\nexit 127\n",
            executable = True,
        )
    repository_ctx.file(
        "BUILD.bazel",
        content = 'exports_files(["claude"], visibility = ["@@//tools/boss/engine/core:__pkg__"])\n',
    )

host_claude_repository = repository_rule(
    implementation = _host_claude_repository_impl,
    local = True,
)
