new file mode 100644
index 0000000..df7bcfe
--- /dev/null
+++ b/rust/private/test_wrapper.bat
@@ -0,0 +1,169 @@
+@REM Copyright 2024 The Bazel Authors. All rights reserved.
+@REM
+@REM Licensed under the Apache License, Version 2.0 (the "License");
+@REM you may not use this file except in compliance with the License.
+@REM You may obtain a copy of the License at
+@REM
+@REM    http://www.apache.org/licenses/LICENSE-2.0
+@REM
+@REM Unless required by applicable law or agreed to in writing, software
+@REM distributed under the License is distributed on an "AS IS" BASIS,
+@REM WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+@REM See the License for the specific language governing permissions and
+@REM limitations under the License.
+
+@REM Wrapper script for rust_test. Translates TESTBRIDGE_TEST_ONLY (from
+@REM `bazel test --test_filter=...`) and the TEST_SHARD_* protocol into libtest
+@REM command-line arguments. See test_wrapper.sh for the full contract; this is
+@REM the Windows mirror of it.
+
+@ECHO OFF
+SETLOCAL EnableDelayedExpansion
+
+SET TEST_BINARY_RAW={{TEST_BINARY}}
+SET LIBTEST_HARNESS={{LIBTEST_HARNESS}}
+SET SHARDING_ENABLED={{SHARDING_ENABLED}}
+SET TEST_BINARY_PATH=!TEST_BINARY_RAW:/=\!
+SET TEST_FILTER=%TESTBRIDGE_TEST_ONLY%
+
+@REM Try to find the binary using RUNFILES_DIR if set
+IF DEFINED RUNFILES_DIR (
+    SET TEST_BINARY_IN_RUNFILES=!RUNFILES_DIR!\!TEST_BINARY_PATH!
+    IF EXIST "!TEST_BINARY_IN_RUNFILES!" (
+        SET TEST_BINARY_PATH=!TEST_BINARY_IN_RUNFILES!
+    )
+)
+
+@REM The short_path is like: test/unit/test_sharding/test-2586318641/sharded_test_enabled.exe
+@REM But on Windows, the binary is at grandparent/test-XXX/name.exe (sibling of runfiles dir)
+@REM Extract just the last two components (test-XXX/name.exe)
+FOR %%F IN ("!TEST_BINARY_PATH!") DO SET BINARY_NAME=%%~nxF
+FOR %%F IN ("!TEST_BINARY_PATH!\..") DO SET BINARY_DIR=%%~nxF
+
+@REM Try various path resolutions
+SET FOUND_BINARY=0
+
+@REM Try 1: Direct path (might work in some configurations)
+IF EXIST "!TEST_BINARY_PATH!" (
+    SET FOUND_BINARY=1
+)
+
+@REM Try 2: Grandparent + last two path components
+IF !FOUND_BINARY! EQU 0 (
+    FOR %%F IN ("!TEST_BINARY_PATH!") DO (
+        SET TEMP_PATH=%%~dpF
+        SET TEMP_PATH=!TEMP_PATH:~0,-1!
+        FOR %%D IN ("!TEMP_PATH!") DO SET PARENT_DIR=%%~nxD
+    )
+    SET TEST_BINARY_GP=..\..\!PARENT_DIR!\!BINARY_NAME!
+    IF EXIST "!TEST_BINARY_GP!" (
+        SET TEST_BINARY_PATH=!TEST_BINARY_GP!
+        SET FOUND_BINARY=1
+    )
+)
+
+@REM Try 3: RUNFILES_DIR based path
+IF !FOUND_BINARY! EQU 0 IF DEFINED RUNFILES_DIR (
+    SET TEST_BINARY_RF=!RUNFILES_DIR!\_main\!TEST_BINARY_PATH!
+    SET TEST_BINARY_RF=!TEST_BINARY_RF:/=\!
+    IF EXIST "!TEST_BINARY_RF!" (
+        SET TEST_BINARY_PATH=!TEST_BINARY_RF!
+        SET FOUND_BINARY=1
+    )
+)
+
+IF !FOUND_BINARY! EQU 0 (
+    ECHO ERROR: Could not find test binary at any expected location 1>&2
+    EXIT /B 1
+)
+
+@REM A binary with its own main^(^) cannot honour a libtest filter. Refuse rather
+@REM than running the whole suite and reporting it as a filtered run.
+IF NOT "!LIBTEST_HARNESS!"=="1" (
+    IF NOT "!TEST_FILTER!"=="" (
+        ECHO rust_test wrapper: --test_filter=!TEST_FILTER! ^(TESTBRIDGE_TEST_ONLY^) cannot be honoured: 1>&2
+        ECHO   !BINARY_NAME! is built with use_libtest_harness = False. 1>&2
+        EXIT /B 1
+    )
+    !TEST_BINARY_PATH! %*
+    EXIT /B !ERRORLEVEL!
+)
+
+SET SHARDING=0
+IF "!SHARDING_ENABLED!"=="1" IF NOT "%TEST_TOTAL_SHARDS%"=="" SET SHARDING=1
+
+@REM Nothing to translate: run the binary with the invocation verbatim.
+IF !SHARDING! EQU 0 IF "!TEST_FILTER!"=="" (
+    !TEST_BINARY_PATH! %*
+    EXIT /B !ERRORLEVEL!
+)
+
+@REM Touch status file to advertise sharding support to Bazel
+IF !SHARDING! EQU 1 IF NOT "%TEST_SHARD_STATUS_FILE%"=="" (
+    TYPE NUL > "%TEST_SHARD_STATUS_FILE%"
+)
+
+@REM Create a temporary file for test list
+SET TEMP_LIST=%TEMP%\rust_test_list_%RANDOM%.txt
+
+@REM Enumerate tests using libtest's --list flag, letting libtest apply the
+@REM filter so the wrapper never reimplements libtest matching semantics.
+IF "!TEST_FILTER!"=="" (
+    !TEST_BINARY_PATH! --list --format terse > "!TEMP_LIST!"
+) ELSE (
+    !TEST_BINARY_PATH! --list --format terse -- "!TEST_FILTER!" > "!TEMP_LIST!"
+)
+IF NOT !ERRORLEVEL! EQU 0 (
+    ECHO rust_test wrapper: test enumeration exited non-zero; cannot enumerate tests. 1>&2
+    DEL "!TEMP_LIST!" 2>NUL
+    EXIT /B 1
+)
+
+@REM Count tests and filter for this shard
+SET INDEX=0
+SET SHARD_TESTS=
+
+FOR /F "tokens=1 delims=:" %%T IN ('TYPE "!TEMP_LIST!" ^| FINDSTR /E ": test"') DO (
+    IF !SHARDING! EQU 1 (
+        SET /A MOD=!INDEX! %% %TEST_TOTAL_SHARDS%
+        IF !MOD! EQU %TEST_SHARD_INDEX% (
+            IF "!SHARD_TESTS!"=="" (
+                SET SHARD_TESTS=%%T
+            ) ELSE (
+                SET SHARD_TESTS=!SHARD_TESTS! %%T
+            )
+        )
+    )
+    SET /A INDEX=!INDEX! + 1
+)
+
+DEL "!TEMP_LIST!" 2>NUL
+
+@REM An empty enumeration is never a reason to report success.
+IF !INDEX! EQU 0 (
+    IF NOT "!TEST_FILTER!"=="" (
+        ECHO rust_test wrapper: --test_filter=!TEST_FILTER! matched no tests; refusing to report success. 1>&2
+    ) ELSE (
+        ECHO rust_test wrapper: enumerated zero tests; refusing to report success. 1>&2
+    )
+    EXIT /B 1
+)
+
+@REM Unsharded, filtered: hand the filter straight to libtest.
+IF !SHARDING! EQU 0 (
+    !TEST_BINARY_PATH! %* -- "!TEST_FILTER!"
+    EXIT /B !ERRORLEVEL!
+)
+
+@REM A shard is legitimately empty only when there are fewer tests than shards.
+IF "!SHARD_TESTS!"=="" (
+    IF !INDEX! GTR %TEST_SHARD_INDEX% (
+        ECHO rust_test wrapper: partitioned 0 of !INDEX! tests into shard %TEST_SHARD_INDEX%; refusing to report success. 1>&2
+        EXIT /B 1
+    )
+    EXIT /B 0
+)
+
+@REM Run the filtered tests with --exact to match exact test names
+!TEST_BINARY_PATH! !SHARD_TESTS! --exact %*
+EXIT /B !ERRORLEVEL!
