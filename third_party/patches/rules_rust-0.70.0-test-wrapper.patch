index 0000000..ed7735d
--- /dev/null
+++ b/rust/private/test_wrapper.sh
@@ -0,0 +1,158 @@
+#!/usr/bin/env bash
+# Copyright 2024 The Bazel Authors. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#    http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Wrapper script for rust_test. It translates the two Bazel test-protocol
+# environment variables that a libtest binary cannot read on its own into
+# libtest command-line arguments:
+#
+#   TESTBRIDGE_TEST_ONLY  (set by `bazel test --test_filter=...`)
+#       -> a libtest positional filter (substring match, same semantics as
+#          `cargo test <filter>`).
+#   TEST_SHARD_INDEX / TEST_TOTAL_SHARDS / TEST_SHARD_STATUS_FILE
+#       (set by Bazel when `shard_count` is used)
+#       -> enumerate with `--list`, partition, run the shard's slice with
+#          `--exact`.
+#
+# The two compose: the filter is applied during enumeration, so sharding
+# partitions the *filtered* set rather than the whole suite.
+#
+# This script never silently degrades to "run something other than what was
+# asked for". Every path either honours the request or exits non-zero with a
+# message saying why it could not.
+
+set -euo pipefail
+
+TEST_BINARY="{{TEST_BINARY}}"
+# "1" when the target is built with libtest (use_libtest_harness = True).
+LIBTEST_HARNESS="{{LIBTEST_HARNESS}}"
+# "1" when the target opted into sharding (experimental_enable_sharding = True).
+SHARDING_ENABLED="{{SHARDING_ENABLED}}"
+
+test_filter="${TESTBRIDGE_TEST_ONLY:-}"
+
+# A test binary with its own main() does not accept libtest's filter
+# arguments, so --test_filter cannot be honoured. Running the whole suite and
+# reporting PASSED would be exactly the silent no-op this wrapper exists to
+# prevent, so refuse instead.
+if [[ "${LIBTEST_HARNESS}" != "1" ]]; then
+    if [[ -n "${test_filter}" ]]; then
+        echo "rust_test wrapper: --test_filter=${test_filter} (TESTBRIDGE_TEST_ONLY) cannot be honoured:" >&2
+        echo "  ${TEST_BINARY} is built with use_libtest_harness = False, so it supplies its own" >&2
+        echo "  main() and does not accept libtest filter arguments. Refusing to run the full suite" >&2
+        echo "  and report it as a filtered run." >&2
+        exit 1
+    fi
+    exec "./${TEST_BINARY}" "$@"
+fi
+
+sharding=0
+if [[ "${SHARDING_ENABLED}" == "1" && -n "${TEST_TOTAL_SHARDS:-}" ]]; then
+    sharding=1
+fi
+
+# Nothing to translate: hand the binary the invocation verbatim. `exec` keeps
+# the wrapper out of the process tree, so `bazel run` and --run_under see the
+# test binary itself.
+if [[ "${sharding}" -eq 0 && -z "${test_filter}" ]]; then
+    exec "./${TEST_BINARY}" "$@"
+fi
+
+# Touch the status file to advertise sharding support to Bazel. Bazel fails the
+# test if sharding was requested and this file was never created, which is what
+# keeps a non-opted-in target from silently ignoring shard_count.
+if [[ "${sharding}" -eq 1 && -n "${TEST_SHARD_STATUS_FILE:-}" ]]; then
+    touch "${TEST_SHARD_STATUS_FILE}"
+fi
+
+# Enumerate the tests, letting libtest itself apply the filter so the wrapper
+# never reimplements libtest's matching semantics.
+# Output format is "test_name: test" -- strip the ": test" suffix.
+list_args=(--list --format terse)
+if [[ -n "${test_filter}" ]]; then
+    # `--` so a filter that begins with `-` is still treated as a filter.
+    list_args+=(-- "${test_filter}")
+fi
+
+if ! list_output=$("./${TEST_BINARY}" "${list_args[@]}" 2>&1); then
+    echo "rust_test wrapper: '${TEST_BINARY} ${list_args[*]}' exited non-zero; cannot enumerate tests." >&2
+    printf '%s\n' "${list_output}" >&2
+    exit 1
+fi
+
+test_list=$(printf '%s\n' "${list_output}" | grep ': test$' | sed 's/: test$//' || true)
+
+# An empty enumeration is never a reason to report success.
+#  - With a filter: the filter matched nothing, so the run the user asked for
+#    would execute zero tests and still exit 0. That is the silent pass this
+#    whole change exists to remove.
+#  - Without a filter: the binary crashed, hung, or --list is broken -- not
+#    that there are zero tests. (A genuinely test-less *shard* is a separate,
+#    legitimate case, handled after partitioning below.)
+if [[ -z "${test_list}" ]]; then
+    if [[ -n "${test_filter}" ]]; then
+        echo "rust_test wrapper: --test_filter=${test_filter} matched none of the tests in ${TEST_BINARY};" >&2
+        echo "  refusing to report success for a run that would execute nothing." >&2
+    else
+        echo "rust_test wrapper: '${TEST_BINARY} --list --format terse' enumerated zero tests;" >&2
+        echo "  refusing to report success for a broken/empty test binary under sharding." >&2
+    fi
+    exit 1
+fi
+
+# Unsharded, filtered: hand the filter straight to libtest so its own
+# "N filtered out" accounting appears in the test log.
+if [[ "${sharding}" -eq 0 ]]; then
+    exec "./${TEST_BINARY}" "$@" -- "${test_filter}"
+fi
+
+# Filter tests for this shard.
+# test_index % TEST_TOTAL_SHARDS == TEST_SHARD_INDEX
+# Split on newlines via IFS word-splitting, NOT a `<<<` here-string. bash
+# implements a here-string by writing a temp file under $TMPDIR, and a Bazel
+# test action on macOS is not always permitted to create one ("cannot create
+# temp file for here document: Operation not permitted"). When that happens the
+# loop body never runs, shard_tests stays empty, and the shard exits 0 -- every
+# shard reports PASSED without executing a single test. Same defect and same
+# remedy as //third_party/patches:rules_apple-4.5.1-no-test-env-heredoc.patch.
+# Globbing is disabled for the split so a test name is never expanded against
+# the working directory.
+shard_tests=()
+index=0
+saved_ifs="$IFS"
+IFS=$'\n'
+set -f
+for test_name in $test_list; do
+    if (( index % TEST_TOTAL_SHARDS == TEST_SHARD_INDEX )); then
+        shard_tests+=("$test_name")
+    fi
+    ((index++)) || true
+done
+set +f
+IFS="$saved_ifs"
+
+# Partitioning is `index % TEST_TOTAL_SHARDS == TEST_SHARD_INDEX`, so a shard is
+# legitimately empty only when there are fewer tests than shards. Empty with
+# tests available means the partition step itself broke -- fail loudly instead
+# of reporting the green that used to mask exactly that.
+if [[ ${#shard_tests[@]} -eq 0 ]]; then
+    if (( index > TEST_SHARD_INDEX )); then
+        echo "rust_test wrapper: partitioned 0 of ${index} enumerated tests into shard ${TEST_SHARD_INDEX} of ${TEST_TOTAL_SHARDS}; refusing to report success" >&2
+        exit 1
+    fi
+    exit 0
+fi
+
+# Run the filtered tests with --exact to match exact test names
+exec "./${TEST_BINARY}" "${shard_tests[@]}" --exact "$@"
