+def load_rustc_codegen_backend(ctx, backend, target_triple, version, iso_date = None):
+    """Loads an alternative rustc codegen backend into the compiler's sysroot
+
+    Backends are distributed as `rustc-codegen-<backend>-preview` rustup components
+    (e.g. `rustc-codegen-cranelift-preview`). Each one installs a dynamic library under
+    `lib/rustlib/<host>/codegen-backends`, which the `rustc_lib` filegroup already globs,
+    so the backend becomes an input of every compile action and rustc can load it with
+    `-Zcodegen-backend=<backend>`.
+
+    Args:
+        ctx (repository_ctx): A repository_ctx.
+        backend (str): The name of the backend, e.g. `cranelift`.
+        target_triple (struct): The Rust-style triple of the host the compiler runs on.
+        version (str): The version of the tool among \"nightly\", \"beta\", or an exact version.
+        iso_date (str): The iso_date to use with \"nightly\" or \"beta\" versions.
 
+    Returns:
+        Dict[str, str]: The sha256 value of the codegen backend artifact.
+    """
+    return load_arbitrary_tool(
+        ctx,
+        iso_date = iso_date,
+        target_triple = target_triple,
+        tool_name = "rustc-codegen-{}".format(backend),
+        tool_subdirectories = ["rustc-codegen-{}-preview".format(backend)],
+        version = version,
+    )
+
