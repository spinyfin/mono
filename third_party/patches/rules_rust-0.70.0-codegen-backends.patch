+def _check_codegen_backends(codegen_backends, versions):
+    """Fail if codegen backends are requested without a toolchain that can provide them."""
+    if not codegen_backends:
+        return
+    for ver in versions:
+        if ver.startswith("nightly"):
+            return
+    fail("Codegen backends {} were requested but no \"nightly\" is being registered. Please update `versions` to include a nightly version.".format(codegen_backends))
