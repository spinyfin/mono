+
+/// One completed SQLite call. No SQL text or bound values are exposed.
+#[derive(Clone, Copy, Debug)]
+pub struct CallObservation {
+    /// Opaque connection identity, never dereferenced by observers.
+    pub connection: usize,
+    /// SQLITE_TXN_NONE, SQLITE_TXN_READ, or SQLITE_TXN_WRITE for main.
+    pub transaction_state: i32,
+    /// Time inside the SQLite call, excluding row processing.
+    pub elapsed: Duration,
+    /// SQLite result code; reset/finalize report OK to avoid recounting errors.
+    pub result: i32,
+}
+
+static CALL_OBSERVER: std::sync::OnceLock<fn(CallObservation)> = std::sync::OnceLock::new();
+
+/// Install a process-wide observer once. The callback must not call SQLite.
+/// This does not replace trace, busy, progress, commit, or rollback handlers.
+pub fn set_call_observer(observer: fn(CallObservation)) {
+    let _ = CALL_OBSERVER.set(observer);
+}
+
+pub(crate) fn observe_call(
+    db: *mut ffi::sqlite3,
+    start: std::time::Instant,
+    result: i32,
+) {
+    let elapsed = start.elapsed();
+    if db.is_null() { return; }
+    if let Some(observer) = CALL_OBSERVER.get() {
+        // SAFETY: called synchronously by the owner of the live connection.
+        let transaction_state = unsafe { ffi::sqlite3_txn_state(db, c"main".as_ptr()) };
+        observer(CallObservation { connection: db as usize, transaction_state, elapsed, result });
+    }
+}
