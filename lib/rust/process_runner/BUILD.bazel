load("@mono_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "process_runner",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//tools/boss/command-runner:__pkg__",
        "//tools/boss/spoke-package:__pkg__",
        "//tools/cube:__pkg__",
